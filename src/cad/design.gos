//! The `Design` intent model and its compile-to-STEP pipeline.

use std::env
use std::fs
use std::time

use crate::cad::compiler_bezier::compile_extruded_bezier_profile
use crate::cad::compiler_chamfer::compile_calibration_chamfer_block
use crate::cad::compiler_cuboid::compile_cuboid
use crate::cad::compiler_extrusion::compile_extruded_profile
use crate::cad::compiler_sweep::compile_swept_profile
use crate::cad::context::StepContext
use crate::cad::geometry::rotate_point
use crate::cad::types::{
    BooleanDifference, BooleanUnion, SceneNode, Shape
}
use crate::entities::presentation
use crate::entities::product
use crate::entities::topology
use crate::error::StepError
use crate::header::{
    FileDescription, FileName, FileSchema, HeaderEntity, HeaderSection, StringListOrDollar
    StringOrDollar
}
use crate::ids::Ref
use crate::repository::{Repository, any_entity_advanced_brep_shape_representation, any_entity_closed_shell, any_entity_color_rgb, any_entity_csg_shape_representation, any_entity_fill_area_style, any_entity_fill_area_style_color, any_entity_manifold_solid_brep, any_entity_mechanical_design_geometric_presentation_representation, any_entity_presentation_layer_assignment, any_entity_presentation_style_assignment, any_entity_product_definition_shape, any_entity_shape_definition_representation, any_entity_shape_representation, any_entity_shape_representation_relationship, any_entity_styled_item, any_entity_surface_side_style, any_entity_surface_style_fill_area, any_entity_surface_style_usage}

/// Repository URL included in generated STEP headers.
pub const STEP_REPO_URL: &str = "https://github.com/gmlewis/gos-step"

/// A model under construction.
pub struct Design {
    pub nodes: Vec<SceneNode>
    /// Kept for compatibility; incremented but never read by the reference.
    pub next_solid_id: i64
    pub name: String
    pub description: String
    /// Self-documentation emitted as a STEP header comment.
    pub documentation: String
    pub snapping: Option<f64>
}

impl Design {
    pub fn new(
        name: String = "model"
        description: String = "generated by gmlewis/step/cad"
        documentation: String = ""
        snapping: Option<f64> = None
    ) -> Design {
        Design {
            nodes: #[]
            next_solid_id: 1
            name: name
            description: description
            documentation: documentation
            snapping: snapping
        }
    }

    /// Set the STEP header documentation comment.
    pub fn documented(self, documentation: String) -> Design {
        Design { documentation: documentation, ..self }
    }

    /// Compatibility alias for `documented`.
    pub fn with_documentation(self, documentation: String) -> Design {
        self.documented(documentation)
    }

    /// Append one node.
    pub fn add(self, node: SceneNode) -> Design {
        let mut nodes = self.nodes
        nodes.push(node)
        Design {
            nodes: nodes
            next_solid_id: self.next_solid_id + 1
            ..self
        }
    }

    /// Append several nodes.
    pub fn add_all(self, nodes: Vec<SceneNode>) -> Design {
        let mut design = self
        for node in nodes {
            design = design.add(node)
        }
        design
    }

    /// Compatibility alias for `add_all`.
    pub fn add_iter(self, nodes: Vec<SceneNode>) -> Design {
        self.add_all(nodes)
    }

    pub fn rotate_x(self, angle: f64) -> Design {
        let mut nodes = #[]
        for node in self.nodes {
            let tx, ty, tz = rotate_point((node.tx, node.ty, node.tz), angle, 0.0, 0.0)
            let new_node = node.turned_x(angle)
            nodes.push(SceneNode { tx: tx, ty: ty, tz: tz, ..new_node })
        }
        Design { nodes: nodes, ..self }
    }

    pub fn rotate_y(self, angle: f64) -> Design {
        let mut nodes = #[]
        for node in self.nodes {
            let tx, ty, tz = rotate_point((node.tx, node.ty, node.tz), 0.0, angle, 0.0)
            let new_node = node.turned_y(angle)
            nodes.push(SceneNode { tx: tx, ty: ty, tz: tz, ..new_node })
        }
        Design { nodes: nodes, ..self }
    }

    pub fn rotate_z(self, angle: f64) -> Design {
        let mut nodes = #[]
        for node in self.nodes {
            let tx, ty, tz = rotate_point((node.tx, node.ty, node.tz), 0.0, 0.0, angle)
            let new_node = node.turned_z(angle)
            nodes.push(SceneNode { tx: tx, ty: ty, tz: tz, ..new_node })
        }
        Design { nodes: nodes, ..self }
    }

    /// Compatibility aliases.
    pub fn turned_x(self, angle: f64) -> Design {
        self.rotate_x(angle)
    }

    pub fn turned_y(self, angle: f64) -> Design {
        self.rotate_y(angle)
    }

    pub fn turned_z(self, angle: f64) -> Design {
        self.rotate_z(angle)
    }

    pub fn translate(self, x: f64 = 0.0, y: f64 = 0.0, z: f64 = 0.0) -> Design {
        let mut nodes = #[]
        for node in self.nodes {
            nodes.push(node.moved(x, y, z))
        }
        Design { nodes: nodes, ..self }
    }

    /// Compatibility alias for `translate`.
    pub fn moved(self, x: f64 = 0.0, y: f64 = 0.0, z: f64 = 0.0) -> Design {
        self.translate(x, y, z)
    }

    /// Compile every node into a repository.
    pub fn compile(self) -> Repository {
        let mut ctx = StepContext::new(self.snapping)
        ctx.init_standard_context(self.name)
        let mut product_defs: Vec<Ref> = #[]
        let mut shape_reps: Vec<Ref> = #[]
        for node in self.nodes {
            match node.shape {
                Shape::Union(u) => {
                    if u.nodes.len() == 0 {
                        continue
                    }
                    if u.nodes.len() == 1 {
                        add_node_to_ctx(
                            &mut ctx
                            SceneNode { name: node.name, ..u.nodes[0] }
                            &mut product_defs
                            &mut shape_reps
                        )
                        continue
                    }
                    let mut all_faces: Vec<Ref> = #[]
                    for child in u.nodes {
                        for face in compile_node_shape(&mut ctx, child, false) {
                            all_faces.push(face)
                        }
                    }
                    if all_faces.len() == 0 {
                        panic(f"shape '{node.name}' produced no faces")
                    }
                    let shell = topology::ClosedShell::new("", all_faces)
                    let shell_ref = ctx.add(any_entity_closed_shell(shell))
                    let brep = topology::ManifoldSolidBrep::new("", shell_ref)
                    let solid_ref = ctx.add(any_entity_manifold_solid_brep(brep))
                    add_solid_node_to_ctx(
                        &mut ctx
                        node
                        solid_ref
                        &mut product_defs
                        &mut shape_reps
                        false
                    )
                }
                Shape::Difference(d) => {
                    if d.cutters.len() == 0 {
                        add_node_to_ctx(
                            &mut ctx
                            SceneNode { name: node.name, ..d.base }
                            &mut product_defs
                            &mut shape_reps
                        )
                        continue
                    }
                    let mut all_faces: Vec<Ref> = #[]
                    for face in compile_node_shape(&mut ctx, d.base, false) {
                        all_faces.push(face)
                    }
                    for cutter in d.cutters {
                        for face in compile_node_shape(&mut ctx, cutter, true) {
                            all_faces.push(face)
                        }
                    }
                    if all_faces.len() == 0 {
                        panic(f"shape '{node.name}' produced no faces")
                    }
                    let shell = topology::ClosedShell::new("", all_faces)
                    let shell_ref = ctx.add(any_entity_closed_shell(shell))
                    let brep = topology::ManifoldSolidBrep::new("", shell_ref)
                    let solid_ref = ctx.add(any_entity_manifold_solid_brep(brep))
                    add_solid_node_to_ctx(
                        &mut ctx
                        node
                        solid_ref
                        &mut product_defs
                        &mut shape_reps
                        false
                    )
                }
                _ => add_node_to_ctx(&mut ctx, node, &mut product_defs, &mut shape_reps)
            }
        }

        // Set the header.
        let file_name = self.name + ".step"
        ctx.repo = ctx.repo.set_header(default_header(
            file_name
            self.description
            self.documentation
        ))
        ctx.repo
    }

    /// Compile and serialize to STEP text.
    pub fn to_step_file(self) -> String {
        let debug = env::var("STEP_DEBUG_TIMING").is_some()
        let t0 = time::now()
        let repo = self.compile()
        let t1 = time::now()
        let out = repo.to_step_file()
        let t2 = time::now()
        if debug {
            eprintln(f"timing: compile={(t1 - t0)}ms serialize={(t2 - t1)}ms entities={repo.len()}")
        }
        out
    }

    /// Alias for `to_step_file`.
    pub fn to_step_text(self) -> String {
        self.to_step_file()
    }

    /// Compile and write/print the STEP file.
    pub fn write_step_file(self, out_path: Option<String>) -> Result<(), StepError> {
        write_text_file(self.to_step_file(), out_path)
    }

    /// Alias for `write_step_file`.
    pub fn write_step(self, out_path: Option<String>) -> Result<(), StepError> {
        self.write_step_file(out_path)
    }
}

impl Display for Design {
    fn fmt(&self) -> String {
        self.clone_display()
    }
}

impl Design {
    fn clone_display(self) -> String {
        self.to_step_file()
    }
}

fn compile_node_geometry_and_styling(ctx: &mut StepContext, node: SceneNode, solid_ref: Ref) {
    // Presentation styling (10 entities, no dedup).
    let rgb = presentation::ColorRgb::new(node.name, node.color.r, node.color.g, node.color.b)
    let rgb_ref = ctx.add(any_entity_color_rgb(rgb))
    let fas_col = presentation::FillAreaStyleColor::new("", rgb_ref)
    let fas_col_ref = ctx.add(any_entity_fill_area_style_color(fas_col))
    let fas = presentation::FillAreaStyle::new("", #[fas_col_ref])
    let fas_ref = ctx.add(any_entity_fill_area_style(fas))
    let ssfa = presentation::SurfaceStyleFillArea::new(fas_ref)
    let ssfa_ref = ctx.add(any_entity_surface_style_fill_area(ssfa))
    let sss = presentation::SurfaceSideStyle::new("", #[ssfa_ref])
    let sss_ref = ctx.add(any_entity_surface_side_style(sss))
    let ssu = presentation::SurfaceStyleUsage::new(".BOTH.", sss_ref)
    let ssu_ref = ctx.add(any_entity_surface_style_usage(ssu))
    let psa = presentation::PresentationStyleAssignment::new(#[ssu_ref])
    let psa_ref = ctx.add(any_entity_presentation_style_assignment(psa))
    let styled = presentation::StyledItem::new("", #[psa_ref], solid_ref)
    let styled_ref = ctx.add(any_entity_styled_item(styled))
    let layer = presentation::PresentationLayerAssignment::new("1", "Layer 1", #[solid_ref])
    let _ = ctx.add(any_entity_presentation_layer_assignment(layer))
    let md = presentation::MechanicalDesignGeometricPresentationRepresentation::new(
        ""
        #[styled_ref]
        crate::ids::Ref { id: ctx.repo_ctx_id }
    )
    let _ = ctx.add(any_entity_mechanical_design_geometric_presentation_representation(md))
}

fn add_node_to_ctx(
    ctx: &mut StepContext
    node: SceneNode
    product_defs: &mut Vec<Ref>
    shape_reps: &mut Vec<Ref>
) {
    let brep_ref = compile_node_to_brep(ctx, node, false)
    add_solid_node_to_ctx(ctx, node, brep_ref, product_defs, shape_reps, false)
}

fn add_solid_node_to_ctx(
    ctx: &mut StepContext
    node: SceneNode
    solid_ref: Ref
    product_defs: &mut Vec<Ref>
    shape_reps: &mut Vec<Ref>
    is_csg: bool
) {
    compile_node_geometry_and_styling(ctx, node, solid_ref)

    // Product structure for this part.
    let prod_def_ref = ctx.add_product_definition(node.name)
    product_defs.push(prod_def_ref)

    // Axis placement for the part (computed twice, as in the reference).
    let origin = ctx.cartesian_point(node.tx, node.ty, node.tz)
    let dzx, dzy, dzz = rotate_point((0.0, 0.0, 1.0), node.rx, node.ry, node.rz)
    let dxx, dxy, dxz = rotate_point((1.0, 0.0, 0.0), node.rx, node.ry, node.rz)
    let dz = ctx.direction(dzx, dzy, dzz)
    let dx = ctx.direction(dxx, dxy, dxz)
    let _a2p_ref = ctx.axis2_placement_3d(origin, dz, dx)
    let origin2 = ctx.cartesian_point(node.tx, node.ty, node.tz)
    let dzx2, dzy2, dzz2 = rotate_point((0.0, 0.0, 1.0), node.rx, node.ry, node.rz)
    let dxx2, dxy2, dxz2 = rotate_point((1.0, 0.0, 0.0), node.rx, node.ry, node.rz)
    let dz2 = ctx.direction(dzx2, dzy2, dzz2)
    let dx2 = ctx.direction(dxx2, dxy2, dxz2)
    let a2p_ref = ctx.axis2_placement_3d(origin2, dz2, dx2)
    let shape_rep = product::ShapeRepresentation::new(
        node.name + "-None"
        #[a2p_ref]
        crate::ids::Ref { id: ctx.repo_ctx_id }
    )
    let shape_rep_ref = ctx.add(any_entity_shape_representation(shape_rep))
    shape_reps.push(shape_rep_ref)
    let specific_rep_ref = if is_csg {
        let csg_rep = product::CsgShapeRepresentation::new(
            node.name + "-None"
            #[solid_ref]
            crate::ids::Ref { id: ctx.repo_ctx_id }
        )
        ctx.add(any_entity_csg_shape_representation(csg_rep))
    } else {
        let brep_rep = product::AdvancedBrepShapeRepresentation::new(
            node.name + "-None"
            #[solid_ref]
            crate::ids::Ref { id: ctx.repo_ctx_id }
        )
        ctx.add(any_entity_advanced_brep_shape_representation(brep_rep))
    }
    let rel = product::ShapeRepresentationRelationship::new(
        "None"
        "relationship"
        shape_rep_ref
        specific_rep_ref
    )
    let _ = ctx.add(any_entity_shape_representation_relationship(rel))
    let pds = product::ProductDefinitionShape::new("", "", prod_def_ref)
    let pds_ref = ctx.add(any_entity_product_definition_shape(pds))
    let sdr = product::ShapeDefinitionRepresentation::new(pds_ref, shape_rep_ref)
    let _ = ctx.add(any_entity_shape_definition_representation(sdr))
}

fn compile_node_to_brep(ctx: &mut StepContext, node: SceneNode, reverse: bool) -> Ref {
    let faces = compile_node_shape(ctx, node, reverse)
    if faces.len() == 0 {
        panic(f"shape '{node.name}' produced no faces")
    }
    let shell = topology::ClosedShell::new("", faces)
    let shell_ref = ctx.add(any_entity_closed_shell(shell))
    let brep = topology::ManifoldSolidBrep::new("", shell_ref)
    ctx.add(any_entity_manifold_solid_brep(brep))
}

fn compile_node_shape(ctx: &mut StepContext, node: SceneNode, reverse: bool) -> Vec<Ref> {
    match node.shape {
        Shape::Cuboid(c) => compile_cuboid(ctx, node, c, reverse)
        Shape::CalibrationChamferBlock(b) => compile_calibration_chamfer_block(ctx, node, b, reverse)
        Shape::ExtrudedProfile(e) => compile_extruded_profile(ctx, node, e, reverse)
        Shape::ExtrudedBezierProfile(e) => compile_extruded_bezier_profile(ctx, node, e, reverse)
        Shape::SweptProfile(s) => compile_swept_profile(ctx, node, s, reverse)
        Shape::Difference(_) => #[]
        // Union shapes are expanded in `Design::compile`.
        Shape::Union(_) => #[]
    }
}

/// Write to stdout when `out_path` is `None`; otherwise create a new file.
pub fn write_text_file(text: String, out_path: Option<String>) -> Result<(), StepError> {
    match out_path {
        None => {
            println(text)
            Ok(())
        }
        Some(path) => {
            // CreateNew semantics: fail when the file already exists.
            if fs::exists(path) {
                println("failed to write output: file exists")
                return Ok(())
            }
            match fs::write(path, text.bytes()) {
                Ok(_) => Ok(())
                Err(err) => {
                    println(f"failed to write output: {err}")
                    Ok(())
                }
            }
        }
    }
}

/// The standard STEP header for a generated design.
pub fn default_header(
    file_name: String
    description: String
    documentation: String
) -> HeaderSection {
    let timestamp = now_iso_timestamp()
    let mut entities = #[]
    if documentation != "" {
        entities.push(HeaderEntity::Comment(documentation))
    }
    entities.push(HeaderEntity::FileDescription(FileDescription::new(
        #[description]
        "2;1"
    )))
    entities.push(HeaderEntity::FileName(FileName::new(
        StringOrDollar::Str(file_name)
        StringOrDollar::Str(timestamp)
        StringListOrDollar::List(#["gmlewis"])
        StringListOrDollar::List(#["gmlewis/step", STEP_REPO_URL])
        StringOrDollar::Str("gmlewis/step")
        StringOrDollar::Str("gossamer")
        StringOrDollar::Str("none")
    )))
    entities.push(HeaderEntity::FileSchema(FileSchema::new(#[
        "AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }"
    ])))
    HeaderSection::new(entities)
}

/// UTC timestamp in `YYYY-MM-DDTHH:MM:SS` (no `Z`, no fractional seconds).
pub fn now_iso_timestamp() -> String {
    let ms = time::now()
    match time::Time::from_unix_ms(ms).civil() {
        Ok(c) => f"{c.year:04}-{c.month:02}-{c.day:02}T{c.hour:02}:{c.minute:02}:{c.second:02}"
        Err(_) => "2025-01-01T00:00:00"
    }
}

// Kept reachable for API completeness.
pub fn _boolean_markers(_u: BooleanUnion, _d: BooleanDifference) {}
