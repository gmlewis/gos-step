//! The calibration chamfer/fillet block compiler.

use std::math

use crate::cad::context::StepContext
use crate::cad::geometry::{Vec3, rotate_point, v_cross, v_norm, v_sub}
use crate::cad::helpers::{EdgeInfo, EdgeTable, add_plane_face_oriented}
use crate::cad::types::{CalibrationChamferBlock, SceneNode}
use crate::ids::Ref

/// Compile a chamfered or filleted block into its faces.
pub fn compile_calibration_chamfer_block(
    ctx: &mut StepContext
    node: SceneNode
    block: CalibrationChamferBlock
    reverse: bool = false
) -> Vec<Ref> {
    let l = block.length_mm
    let w = block.width_mm
    let h = block.height_mm
    let fillet_radius_mm = block.fillet_radius_mm
    let fillet_segments = block.fillet_segments
    let chamfer_size_mm = block.chamfer_size_mm

    // A stack of inset rectangles (offset) along Z.
    let mut rings: Vec<(f64, f64)> = #[]
    rings.push((0.0, 0.0))
    if fillet_radius_mm > 0.0 {
        let r = fillet_radius_mm
        let start_z = h - r
        rings.push((start_z, 0.0))
        let segs = if fillet_segments <= 0 { 8 } else { fillet_segments }
        let mut i = 1
        while i <= segs {
            let phi = i as f64 * (math::PI / 2.0) / segs as f64
            let offset = r - r * math::cos(phi)
            let z = h - r + r * math::sin(phi)
            rings.push((z, offset))
            i += 1
        }
    } else if chamfer_size_mm > 0.0 {
        let c = chamfer_size_mm
        rings.push((h - c, 0.0))
        rings.push((h, c))
    } else {
        rings.push((h, 0.0))
    }

    // Points (mm).
    let mut pts_raw: Vec<Vec3> = #[]
    for ring in rings {
        let rz, ro = ring
        let px0 = ro
        let px1 = l - ro
        let py0 = ro
        let py1 = w - ro
        pts_raw.push((px0, py0, rz))
        pts_raw.push((px1, py0, rz))
        pts_raw.push((px1, py1, rz))
        pts_raw.push((px0, py1, rz))
    }

    // Transform all points: rotate, then translate.
    let mut pts = #[]
    for pt in pts_raw {
        let rx, ry, rz = rotate_point(pt, node.rx, node.ry, node.rz)
        pts.push((rx + node.tx, ry + node.ty, rz + node.tz))
    }

    let mut cp_refs = #[]
    for pt in pts {
        cp_refs.push(ctx.cartesian_point(pt.0, pt.1, pt.2))
    }

    let mut vp_refs = #[]
    for cp_ref in cp_refs {
        vp_refs.push(ctx.vertex_point(cp_ref))
    }

    let mut edges: Vec<EdgeInfo> = #[]
    let mut seen: Map<String, bool> = Map::new()

    // Per-ring perimeter edges, then between-ring edges.
    let ring_count = rings.len()
    let mut ri = 0
    while ri < ring_count {
        let base = ri * 4
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, base, base + 1)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, base + 1, base + 2)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, base + 2, base + 3)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, base + 3, base)
        ri += 1
    }

    let between_count = ring_count - 1
    ri = 0
    while ri < between_count {
        let a = ri * 4
        let b = (ri + 1) * 4
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, a, b)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, a + 1, b + 1)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, a + 2, b + 2)
        add_edge(ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen, a + 3, b + 3)
        ri += 1
    }

    let mut table = EdgeTable::new(edges)

    // Faces.
    let mut face_refs = #[]
    let down_raw = rotate_point((0.0, 0.0, -1.0), node.rx, node.ry, node.rz)
    let up_raw = rotate_point((0.0, 0.0, 1.0), node.rx, node.ry, node.rz)
    face_refs.push(add_plane_face_oriented(
        ctx, &mut table, pts, cp_refs, #[0, 3, 2, 1], down_raw, reverse
    ))
    let top_base = (ring_count - 1) * 4
    face_refs.push(add_plane_face_oriented(
        ctx
        &mut table
        pts
        cp_refs
        #[top_base, top_base + 1, top_base + 2, top_base + 3]
        up_raw
        reverse
    ))

    // Side faces.
    ri = 0
    while ri < between_count {
        let a = ri * 4
        let b = (ri + 1) * 4
        let side_normals = #[
            v_norm(v_cross(v_sub(pts[a + 1], pts[a]), v_sub(pts[b], pts[a])))
            v_norm(v_cross(v_sub(pts[a + 2], pts[a + 1]), v_sub(pts[b + 1], pts[a + 1])))
            v_norm(v_cross(v_sub(pts[a + 3], pts[a + 2]), v_sub(pts[b + 2], pts[a + 2])))
            v_norm(v_cross(v_sub(pts[a], pts[a + 3]), v_sub(pts[b + 3], pts[a + 3])))
        ]
        face_refs.push(add_plane_face_oriented(
            ctx, &mut table, pts, cp_refs, #[a, a + 1, b + 1, b], side_normals[0], reverse
        ))
        face_refs.push(add_plane_face_oriented(
            ctx, &mut table, pts, cp_refs, #[a + 1, a + 2, b + 2, b + 1], side_normals[1], reverse
        ))
        face_refs.push(add_plane_face_oriented(
            ctx, &mut table, pts, cp_refs, #[a + 2, a + 3, b + 3, b + 2], side_normals[2], reverse
        ))
        face_refs.push(add_plane_face_oriented(
            ctx, &mut table, pts, cp_refs, #[a + 3, a, b, b + 3], side_normals[3], reverse
        ))
        ri += 1
    }
    face_refs
}

fn add_edge(
    ctx: &mut StepContext
    pts: Vec<Vec3>
    cp_refs: Vec<Ref>
    vp_refs: Vec<Ref>
    edges: &mut Vec<EdgeInfo>
    seen: &mut Map<String, bool>
    a: i64
    b: i64
) {
    let key = if a < b { f"{a}:{b}" } else { f"{b}:{a}" }
    if seen.get(key).unwrap_or(false) {
        return
    }
    seen.insert(key, true)
    let start = if a < b { a } else { b }
    let end = if a < b { b } else { a }
    let dir_raw = v_norm(v_sub(pts[end], pts[start]))
    let dir_ref = ctx.direction(dir_raw.0, dir_raw.1, dir_raw.2)
    let vec_ref = ctx.vector(dir_ref, 1.0)
    let line_ref = ctx.line(cp_refs[start], vec_ref)
    let ec_ref = ctx.edge_curve(vp_refs[start], vp_refs[end], line_ref, true)
    edges.push(EdgeInfo { start: start, end: end, edge: ec_ref })
}
