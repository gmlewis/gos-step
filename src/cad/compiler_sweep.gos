//! The swept-profile compiler.

use std::math

use crate::cad::context::StepContext
use crate::cad::geometry::{
    Vec3, apply_matrix, Matrix3x3, rotate_point, v_cross, v_dot, v_norm, v_sub
}
use crate::cad::helpers::{
    EdgeInfo, EdgeTable, add_plane_face_oriented, add_plane_face_with_holes_oriented
}
use crate::cad::types::{SceneNode, SweptProfile}
use crate::ids::Ref


fn loop_cycle(
    base: i64
    li: i64
    loop_offsets: Vec<i64>
    local_loops: Vec<Vec<Vec3>>
) -> Vec<i64> {
    let lo = loop_offsets[li]
    let n = local_loops[li].len()
    let mut cycle = Vec::with_capacity(n)
    let mut j = 0
    while j < n {
        cycle.push(base + lo + j)
        j += 1
    }
    cycle
}

/// Compile a swept profile into its faces.
pub fn compile_swept_profile(
    ctx: &mut StepContext
    node: SceneNode
    s: SweptProfile
    reverse: bool = false
) -> Vec<Ref> {
    let path = s.path
    let profile = s.profile
    if path.points.len() < 2 || profile.vertices.len() < 3 {
        return #[]
    }
    let num_path_pts = path.points.len()

    // Profile loops: outer boundary first, then any holes.
    let mut loops = #[profile.vertices]
    for h in profile.holes {
        if h.len() >= 3 {
            loops.push(h)
        }
    }
    let num_loops = loops.len()

    // 1. Profile-local to global (centered at origin).
    let prof_z = v_norm(profile.normal_dir)
    let prof_x = v_norm(profile.right_dir)
    let prof_y = v_norm(v_cross(prof_z, prof_x))

    let m_global_to_prof = Matrix3x3 {
        m00: prof_x.0
        m01: prof_x.1
        m02: prof_x.2
        m10: prof_y.0
        m11: prof_y.1
        m12: prof_y.2
        m20: prof_z.0
        m21: prof_z.1
        m22: prof_z.2
    }

    // Vertices in profile-local coordinates (relative to profile.center).
    let mut local_loops: Vec<Vec<Vec3>> = #[]
    for lp in loops {
        let mut out = #[]
        for v in lp {
            out.push(apply_matrix(m_global_to_prof, v_sub(v, profile.center)))
        }
        local_loops.push(out)
    }
    let mut loop_offsets: Vec<i64> = #[]
    let mut local_verts: Vec<Vec3> = #[]
    let mut is_hole: Vec<bool> = #[]
    let mut loop_index = 0
    for lp in local_loops {
        loop_offsets.push(local_verts.len() as i64)
        for v in lp {
            local_verts.push(v)
            is_hole.push(loop_index > 0)
        }
        loop_index += 1
    }
    let num_prof_verts = local_verts.len()

    // Frames that stay parallel to the sweep axis when requested.
    let t0 = v_norm(path.tangents[0])
    let n0 = v_norm(path.normals[0])
    let r0 = v_norm(v_cross(t0, n0))

    // 2. Transform local vertices to each path point.
    let mut pts_raw: Vec<Vec3> = #[]
    let mut i = 0
    while i < num_path_pts {
        let p_origin = path.points[i]
        let p_tangent = v_norm(path.tangents[i])
        let p_normal = v_norm(path.normals[i])
        let p_right = v_norm(v_cross(p_tangent, p_normal))

        // Path-point-local to global: Z = tangent, Y = normal, X = right.
        let m_path_to_global = Matrix3x3 {
            m00: p_right.0
            m01: p_normal.0
            m02: p_tangent.0
            m10: p_right.1
            m11: p_normal.1
            m12: p_tangent.1
            m20: p_right.2
            m21: p_normal.2
            m22: p_tangent.2
        }
        let m_start_to_global = Matrix3x3 {
            m00: r0.0
            m01: n0.0
            m02: t0.0
            m10: r0.1
            m11: n0.1
            m12: t0.1
            m20: r0.2
            m21: n0.2
            m22: t0.2
        }
        let mut j = 0
        while j < local_verts.len() {
            let v = local_verts[j]
            let keep_straight = if is_hole[j] {
                s.straight_holes
            } else {
                s.straight_outline
            }
            let gv = if keep_straight {
                apply_matrix(m_start_to_global, v)
            } else {
                apply_matrix(m_path_to_global, v)
            }
            pts_raw.push((gv.0 + p_origin.0, gv.1 + p_origin.1, gv.2 + p_origin.2))
            j += 1
        }
        i += 1
    }

    // 3. Apply the node transform (rotate then translate).
    let mut pts = #[]
    for pt in pts_raw {
        let rx, ry, rz = rotate_point(pt, node.rx, node.ry, node.rz)
        pts.push((rx + node.tx, ry + node.ty, rz + node.tz))
    }

    // 4. Create STEP entities.
    let mut cp_refs = #[]
    for pt in pts {
        cp_refs.push(ctx.cartesian_point(pt.0, pt.1, pt.2))
    }
    let mut vp_refs = #[]
    for cp_ref in cp_refs {
        vp_refs.push(ctx.vertex_point(cp_ref))
    }

    let mut edges: Vec<EdgeInfo> = #[]
    let mut seen: Map<String, bool> = Map::new()

    // Profile edges at each path point.
    let mut pi = 0
    while pi < num_path_pts {
        let offset = pi * num_prof_verts
        let mut li = 0
        while li < num_loops {
            let lo = loop_offsets[li]
            let n = local_loops[li].len()
            let mut j = 0
            while j < n {
                let k = (j + 1) % n
                add_edge(
                    ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen
                    offset + lo + j, offset + lo + k
                )
                j += 1
            }
            li += 1
        }
        pi += 1
    }

    // Longitudinal edges between consecutive path points.
    pi = 0
    while pi < num_path_pts - 1 {
        let offset1 = pi * num_prof_verts
        let offset2 = (pi + 1) * num_prof_verts
        let mut li = 0
        while li < num_loops {
            let lo = loop_offsets[li]
            let n = local_loops[li].len()
            let mut j = 0
            while j < n {
                add_edge(
                    ctx, pts, cp_refs, vp_refs, &mut edges, &mut seen
                    offset1 + lo + j, offset2 + lo + j
                )
                j += 1
            }
            li += 1
        }
        pi += 1
    }

    let mut table = EdgeTable::new(edges)

    // 5. Side faces: split non-planar quads along the b1–t2 diagonal.
    let mut face_refs = #[]
    pi = 0
    while pi < num_path_pts - 1 {
        let offset1 = pi * num_prof_verts
        let offset2 = (pi + 1) * num_prof_verts
        let mut li = 0
        while li < num_loops {
            let lo = loop_offsets[li]
            let n = local_loops[li].len()
            let mut j = 0
            while j < n {
                let k = (j + 1) % n
                let b1 = offset1 + lo + j
                let b2 = offset1 + lo + k
                let t1 = offset2 + lo + j
                let t2 = offset2 + lo + k
                let p0 = pts[b1]
                let p1 = pts[b2]
                let p2 = pts[t1]
                let p3 = pts[t2]
                let expected = v_norm(v_cross(v_sub(p1, p0), v_sub(p2, p0)))
                let off_plane = math::abs(v_dot(v_sub(p3, p0), expected))
                if off_plane <= 1.0e-6 {
                    face_refs.push(add_plane_face_oriented(
                        ctx, &mut table, pts, cp_refs, #[b1, b2, t2, t1], expected, reverse
                    ))
                } else {
                    add_edge_indexed(ctx, pts, cp_refs, vp_refs, &mut seen, &mut table, b1, t2)
                    let n1 = v_norm(v_cross(v_sub(p1, p0), v_sub(p3, p0)))
                    let n2 = v_norm(v_cross(v_sub(p3, p0), v_sub(p2, p0)))
                    face_refs.push(add_plane_face_oriented(
                        ctx, &mut table, pts, cp_refs, #[b1, b2, t2], n1, reverse
                    ))
                    face_refs.push(add_plane_face_oriented(
                        ctx, &mut table, pts, cp_refs, #[b1, t2, t1], n2, reverse
                    ))
                }
                j += 1
            }
            li += 1
        }
        pi += 1
    }

    // Start cap.
    if s.make_start_cap {
        let tangent = path.tangents[0]
        let tx, ty, tz = rotate_point(tangent, node.rx, node.ry, node.rz)
        let expected_out = (-tx, -ty, -tz)
        let mut hole_cycles = #[]
        let mut li = 1
        while li < num_loops {
            hole_cycles.push(loop_cycle(0, li, loop_offsets, local_loops))
            li += 1
        }
        face_refs.push(add_plane_face_with_holes_oriented(
            ctx
            &mut table
            pts
            cp_refs
            loop_cycle(0, 0, loop_offsets, local_loops)
            hole_cycles
            expected_out
            reverse
        ))
    }

    // End cap.
    if s.make_end_cap {
        let tangent = path.tangents[num_path_pts - 1]
        let tx, ty, tz = rotate_point(tangent, node.rx, node.ry, node.rz)
        let expected_out = (tx, ty, tz)
        let offset = (num_path_pts - 1) * num_prof_verts
        let mut hole_cycles = #[]
        let mut li = 1
        while li < num_loops {
            hole_cycles.push(loop_cycle(offset, li, loop_offsets, local_loops))
            li += 1
        }
        face_refs.push(add_plane_face_with_holes_oriented(
            ctx
            &mut table
            pts
            cp_refs
            loop_cycle(offset, 0, loop_offsets, local_loops)
            hole_cycles
            expected_out
            reverse
        ))
    }
    face_refs
}

fn add_edge(
    ctx: &mut StepContext
    pts: Vec<Vec3>
    cp_refs: Vec<Ref>
    vp_refs: Vec<Ref>
    edges: &mut Vec<EdgeInfo>
    seen: &mut Map<String, bool>
    a: i64
    b: i64
) {
    let key = if a < b { f"{a}:{b}" } else { f"{b}:{a}" }
    if seen.get(key).unwrap_or(false) {
        return
    }
    seen.insert(key, true)
    let start = if a < b { a } else { b }
    let end = if a < b { b } else { a }
    let dir_raw = v_norm(v_sub(pts[end], pts[start]))
    let dir_ref = ctx.direction(dir_raw.0, dir_raw.1, dir_raw.2)
    let vec_ref = ctx.vector(dir_ref, 1.0)
    let line_ref = ctx.line(cp_refs[start], vec_ref)
    let ec_ref = ctx.edge_curve(vp_refs[start], vp_refs[end], line_ref, true)
    edges.push(EdgeInfo { start: start, end: end, edge: ec_ref })
}

fn add_edge_indexed(
    ctx: &mut StepContext
    pts: Vec<Vec3>
    cp_refs: Vec<Ref>
    vp_refs: Vec<Ref>
    seen: &mut Map<String, bool>
    table: &mut EdgeTable
    a: i64
    b: i64
) {
    let key = if a < b { f"{a}:{b}" } else { f"{b}:{a}" }
    if seen.get(key).unwrap_or(false) {
        return
    }
    seen.insert(key, true)
    let start = if a < b { a } else { b }
    let end = if a < b { b } else { a }
    let dir_raw = v_norm(v_sub(pts[end], pts[start]))
    let dir_ref = ctx.direction(dir_raw.0, dir_raw.1, dir_raw.2)
    let vec_ref = ctx.vector(dir_ref, 1.0)
    let line_ref = ctx.line(cp_refs[start], vec_ref)
    let ec_ref = ctx.edge_curve(vp_refs[start], vp_refs[end], line_ref, true)
    table.insert(start, end, ec_ref)
}
