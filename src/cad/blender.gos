//! Blender 5.0 Python export.
//!
//! The generated script recreates the model at correct physical scale (mm → m)
//! using Blender's Python API, with real boolean modifiers.

use std::env
use std::process

use crate::cad::blender_text::{boolean_apply, boolean_keep, preamble}
use crate::cad::design::{Design, write_text_file}
use crate::cad::geometry::{Vec2, Vec3, rotate_point}
use crate::cad::types::{BezierAnchor, BezierPath, Rgb, SceneNode, Shape}
use crate::error::StepError
use crate::fmt::ref_to_string

fn py_string(s: String) -> String {
    let escaped = s.replace("\\", "\\\\").replace("'", "\\'")
    "'" + escaped + "'"
}

fn mm_to_m(x: f64) -> f64 {
    x * 0.001
}

fn py_bool(b: bool) -> String {
    if b { "True" } else { "False" }
}

fn py_num(x: f64) -> String {
    ref_to_string(x)
}

fn py_vec3(v: Vec3) -> String {
    f"({py_num(v.0)}, {py_num(v.1)}, {py_num(v.2)})"
}

fn py_mm(x: f64) -> String {
    py_num(mm_to_m(x))
}

fn py_mm_vec2(v: Vec2) -> String {
    f"({py_num(mm_to_m(v.0))}, {py_num(mm_to_m(v.1))})"
}

fn py_mm_vec3(v: Vec3) -> String {
    f"({py_num(mm_to_m(v.0))}, {py_num(mm_to_m(v.1))}, {py_num(mm_to_m(v.2))})"
}

fn py_vec3_list(pts: Vec<Vec3>) -> String {
    let mut parts = #[]
    for p in pts {
        parts.push(py_vec3(p))
    }
    "[" + parts.join(", ") + "]"
}

fn py_mm_vec2_list(pts: Vec<Vec2>) -> String {
    let mut parts = #[]
    for p in pts {
        parts.push(py_mm_vec2(p))
    }
    "[" + parts.join(", ") + "]"
}

fn py_mm_vec3_list(pts: Vec<Vec3>) -> String {
    let mut parts = #[]
    for p in pts {
        parts.push(py_mm_vec3(p))
    }
    "[" + parts.join(", ") + "]"
}

fn py_mm_vec2_list_list(loops: Vec<Vec<Vec2>>) -> String {
    let mut parts = #[]
    for lp in loops {
        parts.push(py_mm_vec2_list(lp))
    }
    "[" + parts.join(", ") + "]"
}

fn py_bezier_anchor(a: BezierAnchor) -> String {
    let pos = py_mm_vec2(a.position)
    let hi = py_mm_vec2(a.handle_in)
    let ho = py_mm_vec2(a.handle_out)
    f"{{'pos': {pos}, 'hi': {hi}, 'ho': {ho}}}"
}

fn py_bezier_path(path: BezierPath) -> String {
    let mut anchors = #[]
    for a in path.anchors {
        anchors.push(py_bezier_anchor(a))
    }
    let anchors_s = "[" + anchors.join(", ") + "]"
    f"{{'anchors': {anchors_s}, 'closed': {py_bool(path.closed)}, 'clear': {py_bool(path.clear)}}}"
}

fn py_bezier_paths(paths: Vec<BezierPath>) -> String {
    let mut parts = #[]
    for p in paths {
        parts.push(py_bezier_path(p))
    }
    "[" + parts.join(", ") + "]"
}

fn py_color(color: Rgb) -> String {
    f"({py_num(color.r)}, {py_num(color.g)}, {py_num(color.b)}, 1.0)"
}

fn next_var(prefix: String, idx: i64) -> (String, i64) {
    (prefix + f"{idx}", idx + 1)
}

fn emit_node_python(node: SceneNode, idx: i64, segments: i64) -> (String, i64, String) {
    match node.shape {
        Shape::Cuboid(c) => {
            let obj_var, next_idx = next_var("obj", idx)
            let code = f"    {obj_var} = finalize_object(create_cuboid_object({py_string(node.name)}, {py_mm(c.sx)}, {py_mm(c.sy)}, {py_mm(c.sz)}, collection), get_material({py_color(node.color)}), ({py_mm(node.tx)}, {py_mm(node.ty)}, {py_mm(node.tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, next_idx, code)
        }
        Shape::CalibrationChamferBlock(b) => {
            let obj_var, next_idx = next_var("obj", idx)
            let code = f"    {obj_var} = finalize_object(create_chamfer_block_object({py_string(node.name)}, {py_mm(b.length_mm)}, {py_mm(b.width_mm)}, {py_mm(b.height_mm)}, {py_mm(b.chamfer_size_mm)}, {py_mm(b.fillet_radius_mm)}, {b.fillet_segments}, collection), get_material({py_color(node.color)}), ({py_mm(node.tx)}, {py_mm(node.ty)}, {py_mm(node.tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, next_idx, code)
        }
        Shape::ExtrudedProfile(e) => {
            let obj_var, next_idx = next_var("obj", idx)
            let mut loops = #[e.profile.outer]
            for h in e.profile.holes {
                loops.push(h)
            }
            let h2 = e.height_mm / 2.0
            let ox, oy, oz = rotate_point((0.0, 0.0, h2), node.rx, node.ry, node.rz)
            let tx = node.tx + ox
            let ty = node.ty + oy
            let tz = node.tz + oz
            let code = f"    {obj_var} = finalize_object(create_extruded_profile_object({py_string(node.name)}, {py_mm_vec2_list_list(loops)}, {py_mm(e.height_mm)}, collection), get_material({py_color(node.color)}), ({py_mm(tx)}, {py_mm(ty)}, {py_mm(tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, next_idx, code)
        }
        Shape::ExtrudedBezierProfile(e) => {
            let obj_var, next_idx = next_var("obj", idx)
            let paths_data = py_bezier_paths(e.paths)
            let h2 = e.height_mm / 2.0
            let ox, oy, oz = rotate_point((0.0, 0.0, h2), node.rx, node.ry, node.rz)
            let tx = node.tx + ox
            let ty = node.ty + oy
            let tz = node.tz + oz
            let code = f"    {obj_var} = finalize_object(create_extruded_bezier_object({py_string(node.name)}, {paths_data}, {py_mm(e.height_mm)}, collection), get_material({py_color(node.color)}), ({py_mm(tx)}, {py_mm(ty)}, {py_mm(tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, next_idx, code)
        }
        Shape::SweptProfile(s) => {
            let obj_var, next_idx = next_var("obj", idx)
            let code = f"    {obj_var} = finalize_object(create_swept_profile_object({py_string(node.name)}, {py_mm_vec3_list(s.path.points)}, {py_vec3_list(s.path.normals)}, {py_vec3_list(s.path.tangents)}, {py_mm_vec3(s.profile.center)}, {py_mm_vec3_list(s.profile.vertices)}, {py_vec3(s.profile.normal_dir)}, {py_vec3(s.profile.right_dir)}, {py_bool(s.make_start_cap)}, {py_bool(s.make_end_cap)}, collection), get_material({py_color(node.color)}), ({py_mm(node.tx)}, {py_mm(node.ty)}, {py_mm(node.tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, next_idx, code)
        }
        Shape::Union(u) => {
            let mut child_vars = #[]
            let mut code = ""
            let mut cur_idx = idx
            for child in u.nodes {
                let child_var, next_idx, child_code = emit_node_python(child, cur_idx, segments)
                child_vars.push(child_var)
                code += child_code
                cur_idx = next_idx
            }
            let list_var, next_idx = next_var("union_objs", cur_idx)
            let joined = child_vars.join(", ")
            code += f"    {list_var} = [{joined}]\n"
            let obj_var, final_idx = next_var("obj", next_idx)
            code += f"    {obj_var} = finalize_object(join_objects({list_var}, {py_string(node.name)}), get_material({py_color(node.color)}), ({py_mm(node.tx)}, {py_mm(node.ty)}, {py_mm(node.tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, final_idx, code)
        }
        Shape::Difference(d) => {
            let base_var, next_idx, base_code = emit_node_python(d.base, idx, segments)
            let mut code = base_code
            let mut cutter_vars = #[]
            let mut cur_idx = next_idx
            for cutter in d.cutters {
                let cutter_var, cutter_idx, cutter_code = emit_node_python(cutter, cur_idx, segments)
                cutter_vars.push(cutter_var)
                code += cutter_code
                cur_idx = cutter_idx
            }
            let list_var, next_idx = next_var("diff_cutters", cur_idx)
            let joined = cutter_vars.join(", ")
            code += f"    {list_var} = [{joined}]\n"
            let obj_var, final_idx = next_var("obj", next_idx)
            code += f"    {obj_var} = finalize_object(boolean_difference({base_var}, {list_var}, {py_string(node.name)}), get_material({py_color(node.color)}), ({py_mm(node.tx)}, {py_mm(node.ty)}, {py_mm(node.tz)}), ({py_num(node.rx)}, {py_num(node.ry)}, {py_num(node.rz)}))\n"
            (obj_var, final_idx, code)
        }
    }
}

impl Design {
    /// Emit a Blender Python script. `segments` is retained for compatibility
    /// (the reference preserves native Bezier curves).
    pub fn to_blender_python(self, segments: i64 = 0, keep_modifiers: bool = false) -> String {
        let mut out = preamble()
        if keep_modifiers {
            out += boolean_keep()
        } else {
            out += boolean_apply()
        }
        out += "\ndef create_model_objects(collection):\n"
        let mut obj_index = 0
        for node in self.nodes {
            let _obj_var, next_idx, code = emit_node_python(node, obj_index, segments)
            out += code
            obj_index = next_idx
        }
        out += postscript(self.name)
        out
    }

    /// Write the Blender Python script to a path or stdout.
    pub fn write_blender_python(
        self
        out_path: Option<String>
        segments: i64 = 0
        keep_modifiers: bool = false
    ) -> Result<(), StepError> {
        let bpy_code = self.to_blender_python(segments, keep_modifiers)
        write_text_file(bpy_code, out_path)
    }

    /// Compatibility alias.
    pub fn to_blender(self, keep_modifiers: bool = false) -> String {
        self.to_blender_python(0, keep_modifiers)
    }

    /// Write a `.blend` file by running the validation script.
    pub fn create_blender_file(
        self
        out_path: String
        keep_modifiers: bool = false
        segments: i64 = 0
    ) -> Result<(), StepError> {
        let bpy_code = self.to_blender_python(segments, keep_modifiers)
        let temp_py_path = "/tmp/temp_blender_script.py"
        write_text_file(bpy_code, Some(temp_py_path))?

        let mut script_path = "./scripts/validate-bpy.py"
        if let Some(root) = env::var("STEP_ROOT") {
            script_path = if root.ends_with("/") {
                root + "scripts/validate-bpy.py"
            } else {
                root + "/scripts/validate-bpy.py"
            }
        }
        let output = process::run(script_path, #[temp_py_path, "--blend", out_path])
        match output {
            Ok(o) => {
                if o.code != 0 {
                    println(f"failed to write '{out_path}'")
                }
                Ok(())
            }
            Err(_) => {
                println(f"failed to write '{out_path}'")
                Ok(())
            }
        }
    }

    /// Alias for `create_blender_file`.
    pub fn write_blender(self, out_path: String, keep_modifiers: bool = false) -> Result<(), StepError> {
        self.create_blender_file(out_path, keep_modifiers, 0)
    }
}

fn postscript(name: String) -> String {
    let escaped_name = name.replace("\\", "\\\\").replace("'", "\\'")
    let head = "
    obj_count = len(collection.objects)
    if obj_count == 0:
        raise RuntimeError(\"No objects were created in the collection.\")
    bpy.ops.object.select_all(action=\"DESELECT\")
    for obj in collection.objects:
        obj.select_set(True)
    if collection.objects:
        bpy.context.view_layer.objects.active = collection.objects[0]


def main():
    try:
        delete_default_cube()
        # Create or reuse a named collection (based upon the name of this model).
        # Delete all children of the collection in the case that it already exists.
        collection_name = config.get('collectionName', '"
    let middle = escaped_name + " Collection')
        print(f\"\\nSetting up collection '{collection_name}'...\")
        collection = set_up_collection(collection_name)

        create_model_objects(collection)

        print(\"Done.\")
    except Exception as exc:
        print(f\"ERROR: {exc}\", file=sys.stderr)
        sys.exit(1)


if __name__ == \"__main__\":
    main()"
    head + middle
}
