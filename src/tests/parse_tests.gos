//! STEP parser tests: exact serializations, positions, and errors.

use crate::parse::entry::parse_repository_from_string
use crate::parse::entry::parse_repository_from_string_result


#[test]
fn parse_parse_repository_from_string_minimal() {
    let content = "ISO-10303-21;\nDATA;\n#10=CARTESIAN_POINT('CP1',(1.0,2.0,3.0));\n#11=DIRECTION('DIR1',(0.0,0.0,1.0));\n#12=AXIS2_PLACEMENT_3D('A2P3D',#10,#11,#11);\nENDSEC;\nEND-ISO-10303-21;\n"
    let repo = parse_repository_from_string(content).unwrap()
    assert_eq(format("{}", repo.len()), "3")

    // Roundtrip the parsed entities back to STEP-style lines.
    assert_eq(format("{}", repo.to_step_data_section()), "#10=CARTESIAN_POINT('CP1',(1.0,2.0,3.0));\n#11=DIRECTION('DIR1',(0.0,0.0,1.0));\n#12=AXIS2_PLACEMENT_3D('A2P3D',#10, #11, #11);")
}

#[test]
fn parse_parse_error_reports_file_line_col_for_data() {
    // The invalid statement is on line 3, col 1 of the full file.
    let content = "ISO-10303-21;\nDATA;\n#2FOO('B');\nENDSEC;\nEND-ISO-10303-21;\n"
    match parse_repository_from_string_result(content) {
        Ok(_) => panic("expected parse failure")
        Err(info) => {
            match (info.line, info.col) {
                (Some(3), Some(1)) => ()
                _ => panic("expected file position @3:1")
            }
            let msg = crate::error::format_step_parse_error(info)
            assert(msg.contains("@3:1"))
            assert(msg.contains("missing '='"))
            // Caret points at the likely missing '=' location in the statement.
            assert(msg.contains("\n    ^"))
            assert(msg.contains("Hint:"))
        }
    }
}

#[test]
fn parse_parse_repository_from_string_preserves_unknown_data_entities() {
    let content = "ISO-10303-21;\nDATA;\n#5=FOO_BAR(1,$,'X');\nENDSEC;\nEND-ISO-10303-21;\n"
    let repo = parse_repository_from_string(content).unwrap()
    assert_eq(format("{}", repo.len()), "1")
    let out = repo.to_step_data_section()
    assert(out.contains("#5=FOO_BAR(1,$,'X');"))
}

#[test]
fn parse_parse_repository_from_string_complex_rel_parts() {
    let content = "ISO-10303-21;\nDATA;\n#187=(\nREPRESENTATION_RELATIONSHIP('','',#40,#10)\nREPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#435)\nSHAPE_REPRESENTATION_RELATIONSHIP()\n);\nENDSEC;\nEND-ISO-10303-21;\n"
    let repo = parse_repository_from_string(content).unwrap()
    assert_eq(format("{}", repo.len()), "1")
    let e = repo.get(crate::ids::EntityId { value: 187, })
    match e {
        Some(crate::repository::AnyEntity::ComplexInstance(ci)) => {
            assert_eq(format("{}", ci.parts.len()), "3")
            match ci.parts[0] {
                crate::entities::context::ComplexPart::RepRel(_) => ()
                _ => panic("fail_parse")
            }
            match ci.parts[1] {
                crate::entities::context::ComplexPart::RepRelWT(_) => ()
                _ => panic("fail_parse")
            }
            match ci.parts[2] {
                crate::entities::context::ComplexPart::ShapeRepRel => ()
                _ => panic("fail_parse")
            }
        }
        _ => panic("fail_parse")
    }
}

#[test]
fn parse_parse_repository_from_string_complex_instance_wrapper() {
    let content = "ISO-10303-21;\nDATA;\n#187=(\nGEOMETRIC_REPRESENTATION_CONTEXT(3)\nGLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#188))\nGLOBAL_UNIT_ASSIGNED_CONTEXT((#194,#190,#189))\nREPRESENTATION_CONTEXT('cube','TOP_LEVEL_ASSEMBLY_PART')\n);\nENDSEC;\nEND-ISO-10303-21;\n"
    let repo = parse_repository_from_string(content).unwrap()
    assert_eq(format("{}", repo.len()), "1")
    let out = repo.to_step_data_section()
    assert(out.contains("#187=("))
    assert(out.contains("GEOMETRIC_REPRESENTATION_CONTEXT(3)"))
    assert(out.contains("GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#188))"))
    assert(out.contains("GLOBAL_UNIT_ASSIGNED_CONTEXT((#194,#190,#189))"))
    assert(
        out.contains("REPRESENTATION_CONTEXT('cube','TOP_LEVEL_ASSEMBLY_PART')")
    )
    assert(out.contains("\n)"))
}
