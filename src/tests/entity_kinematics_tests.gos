//! Entity serialization tests: kinematics family.

use crate::ids::{EntityId, Ref}
use crate::entities::kinematics

#[test]
fn kinematics_kinematiclink_to_step() {
    let link = kinematics::KinematicLink::new("test link")
    assert_eq(link.to_step(), "KINEMATIC_LINK('test link')")
}

#[test]
fn kinematics_kinematicjoint_to_step() {
    let l1 = Ref { id: EntityId { value: 10 } }
    let l2 = Ref { id: EntityId { value: 20 } }
    let joint = kinematics::KinematicJoint::new("test joint", l1, l2)
    assert_eq(joint.to_step(), "KINEMATIC_JOINT('test joint',#10,#20)")
}

#[test]
fn kinematics_kinematicpair_to_step() {
    let joint = Ref { id: EntityId { value: 10 } }
    let pair = kinematics::KinematicPair::new("test pair", "desc", joint)
    assert_eq(pair.to_step(), "KINEMATIC_PAIR('test pair','desc',#10)")
}
