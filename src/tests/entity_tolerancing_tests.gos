//! Entity serialization tests: tolerancing family.

use crate::ids::{EntityId, Ref}
use crate::entities::tolerancing

#[test]
fn tolerancing_datum_to_step() {
    let shape = Ref { id: EntityId { value: 10 } }
    let d = tolerancing::Datum::new("name", "desc", shape, ".T.", "A")
    assert_eq(d.to_step(), "DATUM('name','desc',#10,.T.,'A')")
}

#[test]
fn tolerancing_datumfeature_to_step() {
    let shape = Ref { id: EntityId { value: 10 } }
    let df = tolerancing::DatumFeature::new("name", "desc", shape, ".T.")
    assert_eq(df.to_step(), "DATUM_FEATURE('name','desc',#10,.T.)")
}

#[test]
fn tolerancing_dimensionalsize_to_step() {
    let sa = Ref { id: EntityId { value: 10 } }
    let ds = tolerancing::DimensionalSize::new(sa, "test")
    let s = ds.to_step()
    assert_eq(s, "DIMENSIONAL_SIZE(#10,'test')")
}

#[test]
fn tolerancing_geometrictolerance_to_step() {
    let mag = Ref { id: EntityId { value: 10 } }
    let shape = Ref { id: EntityId { value: 20 } }
    let gt = tolerancing::GeometricTolerance::new("name", "desc", mag, shape)
    assert_eq(gt.to_step(), "GEOMETRIC_TOLERANCE('name','desc',#10,#20)")
}
