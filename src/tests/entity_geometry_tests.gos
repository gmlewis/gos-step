//! Entity serialization tests: geometry family.


use crate::ids::{EntityId, Ref}
use crate::entities::geometry

#[test]
fn geometry_axis1placement_to_step() {
    let loc = Ref { id: EntityId { value: 10 } }
    let ax = geometry::Axis1Placement::new("test", loc)
    assert_eq(ax.to_step(), "AXIS1_PLACEMENT('test',#10,$)")
    let dir = Ref { id: EntityId { value: 20 } }
    let ax2 = geometry::Axis1Placement::new("test2", loc, axis: Some(dir))
    assert_eq(ax2.to_step(), "AXIS1_PLACEMENT('test2',#10,#20)")
}

#[test]
fn geometry_axis2placement2d_to_step() {
    let loc = Ref { id: EntityId { value: 10 } }
    let ax = geometry::Axis2Placement2D::new("test", loc)
    assert_eq(ax.to_step(), "AXIS2_PLACEMENT_2D('test',#10,$)")
    let dir = Ref { id: EntityId { value: 20 } }
    let ax2 = geometry::Axis2Placement2D::new(
        "test2"
        loc
        ref_direction: Some(dir)
    )
    assert_eq(ax2.to_step(), "AXIS2_PLACEMENT_2D('test2',#10,#20)")
}

#[test]
fn geometry_axis2_placement_3d_to_step() {
    let p_ref: Ref = Ref { id: EntityId { value: 10 } }
    let d1_ref: Ref = Ref { id: EntityId { value: 11 } }
    let d2_ref: Ref = Ref { id: EntityId { value: 12 } }
    let a2p3d = geometry::Axis2Placement3D::new("A2P3D", p_ref, d1_ref, d2_ref)
    assert_eq(a2p3d.to_step(), "AXIS2_PLACEMENT_3D('A2P3D',#10, #11, #12)")
}

#[test]
fn geometry_booleanresult_to_step() {
    let op1 = Ref { id: EntityId { value: 10 } }
    let op2 = Ref { id: EntityId { value: 20 } }
    let br = geometry::BooleanResult::new("test", geometry::BooleanOperator::Union, op1, op2)
    let s = br.to_step()
    assert_eq(s, "BOOLEAN_RESULT('test',.UNION.,#10,#20)")
}

#[test]
fn geometry_booleanoperator_to_step() {
    assert_eq(geometry::boolean_operator_to_step(geometry::BooleanOperator::Union), ".UNION.")
    assert_eq(geometry::boolean_operator_to_step(geometry::BooleanOperator::Intersection), ".INTERSECTION.")
    assert_eq(geometry::boolean_operator_to_step(geometry::BooleanOperator::Difference), ".DIFFERENCE.")
}

#[test]
fn geometry_bsplinecurve_to_step() {
    let cps = #[
        Ref { id: EntityId { value: 10 } }
        Ref { id: EntityId { value: 11 } }
    ]
    let curve = geometry::BSplineCurve::new(
        "test", 1, cps, ".UNSPECIFIED.", false, false
    )
    let s = curve.to_step()
    assert_eq(s, "B_SPLINE_CURVE('test',1,(#10,#11),.UNSPECIFIED.,.F.,.F.)")
}

#[test]
fn geometry_b_spline_curve_with_knots_to_step() {
    let cp1 = Ref { id: EntityId { value: 10 } }
    let cp2 = Ref { id: EntityId { value: 11 } }
    let cp3 = Ref { id: EntityId { value: 12 } }
    let cp4 = Ref { id: EntityId { value: 13 } }
    let entity = geometry::BSplineCurveWithKnots::new(
        ""
        3
        #[cp1, cp2, cp3, cp4]
        ".UNSPECIFIED."
        false
        false
        #[4, 4]
        #["0.", "1."]
        ".UNSPECIFIED."
    )
    assert_eq(entity.to_step(), "B_SPLINE_CURVE_WITH_KNOTS('',3,(#10,#11,#12,#13),.UNSPECIFIED.,.F.,.F.,(4,4),(0.,1.),.UNSPECIFIED.)")
}

#[test]
fn geometry_b_spline_surface_with_knots_to_step() {
    let s = geometry::BSplineSurfaceWithKnots::new(
        #[3, 3]
        #[3, 2, 3]
        #["-0.1", "0.2"]
        #["-3.14159", "0.0", "3.14159"]
        ".UNSPECIFIED."
    )
    assert_eq(s.to_step(), "B_SPLINE_SURFACE_WITH_KNOTS((3,3),(3,2,3),(-0.1,0.2),(-3.14159,0.0,3.14159),.UNSPECIFIED.)")
}

#[test]
fn geometry_b_spline_surface_to_step() {
    let s = geometry::BSplineSurface::new(
        2
        2
        #[
            #[
                Ref { id: EntityId { value: 1 } }
                Ref { id: EntityId { value: 2 } }
            ]
            #[
                Ref { id: EntityId { value: 3 } }
                Ref { id: EntityId { value: 4 } }
            ]
        ]
        ".UNSPECIFIED."
        false
        false
        false
    )
    assert_eq(s.to_step(), "B_SPLINE_SURFACE(2,2,((#1,#2),(#3,#4)),.UNSPECIFIED.,.F.,.F.,.F.)")
}

#[test]
fn geometry_cartesian_point_to_step() {
    let p = geometry::CartesianPoint::new("CP1", #[1.0, 2.0, 3.0])
    assert_eq(p.to_step(), "CARTESIAN_POINT('CP1',(1.0,2.0,3.0))")
}

#[test]
fn geometry_circle_to_step() {
    let pos = Ref { id: EntityId { value: 600 } }
    let entity = geometry::Circle::new("", pos, "0.435")
    assert_eq(entity.to_step(), "CIRCLE('',#600,0.435)")
}

#[test]
fn geometry_compositecurvesegment_to_step() {
    let curve = Ref { id: EntityId { value: 10 } }
    let seg = geometry::CompositeCurveSegment::new(Continuous, true, curve)
    assert_eq(seg.to_step(), "COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#10)")
}

#[test]
fn geometry_compositecurve_to_step() {
    let segs = #[
        Ref { id: EntityId { value: 10 } }
        Ref { id: EntityId { value: 20 } }
    ]
    let curve = geometry::CompositeCurve::new("test", segs, false)
    assert_eq(curve.to_step(), "COMPOSITE_CURVE('test',(#10,#20),.F.)")
}

#[test]
fn geometry_transitioncode_to_step() {
    assert_eq(geometry::TransitionCode::Discontinuous.to_step(), ".DISCONTINUOUS.")
    assert_eq(geometry::TransitionCode::Continuous.to_step(), ".CONTINUOUS.")
    assert_eq(geometry::TransitionCode::ContSameGradient.to_step(), ".CONTSAMEGRADIENT.")
    assert_eq(geometry::TransitionCode::ContSameGradientSameCurvature.to_step(), ".CONTSAMEGRADIENTSAMECURVATURE.")
}

#[test]
fn geometry_conical_surface_to_step() {
    let pos = Ref { id: EntityId { value: 611 } }
    let entity = geometry::ConicalSurface::new(
        "", pos, "0.3500599520011", "0.140686945962564"
    )
    assert_eq(entity.to_step(), "CONICAL_SURFACE('',#611,0.3500599520011,0.140686945962564)")
}

#[test]
fn geometry_csgsolid_to_step() {
    let root = Ref { id: EntityId { value: 10 } }
    let solid = geometry::CsgSolid::new("test-solid", root)
    let s = solid.to_step()
    assert_eq(s, "CSG_SOLID('test-solid',#10)")
}

#[test]
fn geometry_csg_primitives_to_step() {
    let pos = Ref { id: EntityId { value: 10 } }
    let block = geometry::Block::new("b", pos, 1.0, 2.0, 3.0)
    assert_eq(block.to_step(), "BLOCK('b',#10,1.0,2.0,3.0)")
    let sphere = geometry::Sphere::new("s", pos, 5.0)
    assert_eq(sphere.to_step(), "SPHERE('s',#10,5.0)")
    let cylinder = geometry::RightCircularCylinder::new("cyl", pos, 50.0, 10.0)
    assert_eq(cylinder.to_step(), "RIGHT_CIRCULAR_CYLINDER('cyl',#10,50.0,10.0)")
    let cone = geometry::RightCircularCone::new("cone", pos, 50.0, 10.0, 0.5)
    assert_eq(cone.to_step(), "RIGHT_CIRCULAR_CONE('cone',#10,50.0,10.0,0.5)")
    let torus = geometry::Torus::new("t", pos, 20.0, 5.0)
    assert_eq(torus.to_step(), "TORUS('t',#10,20.0,5.0)")
    let pyramid = geometry::RectangularPyramid::new("p", pos, 10.0, 20.0, 30.0)
    assert_eq(pyramid.to_step(), "RECTANGULAR_PYRAMID('p',#10,10.0,20.0,30.0)")
    let wedge = geometry::RightAngularWedge::new("w", pos, 10.0, 20.0, 30.0, 5.0)
    assert_eq(wedge.to_step(), "RIGHT_ANGULAR_WEDGE('w',#10,10.0,20.0,30.0,5.0)")
}

