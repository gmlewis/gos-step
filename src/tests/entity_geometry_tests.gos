fn geometry_rational_b_spline_curve_to_step() {
    let c = geometry::RationalBSplineCurve::new(#["1.", "0.5", "2."])
    assert_eq(c.to_step(), "RATIONAL_B_SPLINE_CURVE((1.,0.5,2.))")
}

#[test]
fn geometry_rectangular_trimmed_surface_to_step() {
    let s = geometry::RectangularTrimmedSurface::new(
        ""
        Ref { id: EntityId { value: 12 } }
        "0.0"
        "1.0"
        "-0.5"
        "0.5"
        true
        true
    )
    assert_eq(s.to_step(), "RECTANGULAR_TRIMMED_SURFACE('',#12,0.0,1.0,-0.5,0.5,.T.,.T.)")
}

