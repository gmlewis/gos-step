#[test]
fn geometry_rational_b_spline_surface_to_step() {
    let s = geometry::RationalBSplineSurface::new(#[
        #["1.", "0.5", "2."]
        #["0.25", "1.", "0.25"]
    ])
    assert_eq(s.to_step(), "RATIONAL_B_SPLINE_SURFACE(((1.,0.5,2.),(0.25,1.,0.25)))")
}

