#[test]
fn geometry_trim_curve_to_step() {
    let e = geometry::TrimmedCurve::new(
        ""
        Ref { id: EntityId { value: 12 } }
        "(PARAMETER_VALUE(0.0))"
        "(PARAMETER_VALUE(1.0))"
        true
        ".PARAMETER."
    )
    assert_eq(e.to_step(), "TRIMMED_CURVE('',#12,(PARAMETER_VALUE(0.0)),(PARAMETER_VALUE(1.0)),.T.,.PARAMETER.)")
}

#[test]
fn geometry_vector_to_step() {
    let d_ref: Ref = Ref { id: EntityId { value: 135 } }
    let v = geometry::Vector::new("", d_ref, 1.0)
    assert_eq(v.to_step(), "VECTOR('',#135,1.0)")
}
