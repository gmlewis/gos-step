//! Entity serialization tests: topology family.

use crate::ids::{EntityId, Ref}
use crate::entities::topology

#[test]
fn topology_advancedface_to_step() {
    let e = topology::AdvancedFace::new(
        ""
        #[Ref { id: EntityId { value: 46 } }]
        Ref { id: EntityId { value: 40 } }
        false
    )
    assert_eq(e.to_step(), "ADVANCED_FACE('',(#46),#40,.F.)")
}
