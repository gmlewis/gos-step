//! Entity serialization tests: topology family.

use crate::ids::{EntityId, Ref}
use crate::entities::topology

#[test]
fn topology_advancedface_to_step() {
    let e = topology::AdvancedFace::new(
        ""
        #[Ref { id: EntityId { value: 46 } }]
        Ref { id: EntityId { value: 40 } }
        false
    )
    assert_eq(e.to_step(), "ADVANCED_FACE('',(#46),#40,.F.)")
}

#[test]
fn topology_closedshell_to_step() {
    let e = topology::ClosedShell::new("", #[
        Ref { id: EntityId { value: 34 } }
        Ref { id: EntityId { value: 35 } }
        Ref { id: EntityId { value: 36 } }
        Ref { id: EntityId { value: 37 } }
        Ref { id: EntityId { value: 38 } }
        Ref { id: EntityId { value: 39 } }
    ])
    assert_eq(e.to_step(), "CLOSED_SHELL('',(#34,#35,#36,#37,#38,#39))")
}

#[test]
fn topology_connectedfaceset_to_step() {
    let faces = #[
        Ref { id: EntityId { value: 10 } }
        Ref { id: EntityId { value: 20 } }
    ]
    let cfs = topology::ConnectedFaceSet::new("test", faces)
    let s = cfs.to_step()
    assert_eq(s, "CONNECTED_FACE_SET('test',(#10,#20))")
}

#[test]
fn topology_edge_curve_to_step() {
    let start = Ref { id: EntityId { value: 82 } }
    let end = Ref { id: EntityId { value: 83 } }
    let geom = Ref { id: EntityId { value: 102 } }
    let entity = topology::EdgeCurve::new("", start, end, geom, true)
    assert_eq(entity.to_step(), "EDGE_CURVE('',#82,#83,#102,.T.)")
}

#[test]
fn topology_edge_loop_to_step() {
    let e58 = Ref { id: EntityId { value: 58 } }
    let e59 = Ref { id: EntityId { value: 59 } }
    let e60 = Ref { id: EntityId { value: 60 } }
    let e61 = Ref { id: EntityId { value: 61 } }
    let entity = topology::EdgeLoop::new("", #[e58, e59, e60, e61])
    assert_eq(entity.to_step(), "EDGE_LOOP('',(#58,#59,#60,#61))")
}

#[test]
fn topology_face_bound_to_step() {
    let b = Ref { id: EntityId { value: 158 } }
    let entity = topology::FaceBound::new("", b, true)
    assert_eq(entity.to_step(), "FACE_BOUND('',#158,.T.)")
}

#[test]
fn topology_face_outer_bound_to_step() {
    let b = Ref { id: EntityId { value: 52 } }
    let entity = topology::FaceOuterBound::new("", b, true)
    assert_eq(entity.to_step(), "FACE_OUTER_BOUND('',#52,.T.)")
}

#[test]
fn topology_facesurface_to_step() {
    let bounds = #[Ref { id: EntityId { value: 10 } }]
    let geom = Ref { id: EntityId { value: 20 } }
    let face = topology::FaceSurface::new("test", bounds, geom, true)
    let s = face.to_step()
    assert_eq(s, "FACE_SURFACE('test',(#10),#20,.T.)")
}

#[test]
fn topology_manifoldsolidbrep_to_step() {
    let e = topology::ManifoldSolidBrep::new("", Ref { id: EntityId { value: 33 } })
    assert_eq(e.to_step(), "MANIFOLD_SOLID_BREP('',#33)")
}

#[test]
fn topology_openshell_to_step() {
    let faces = #[
        Ref { id: EntityId { value: 10 } }
        Ref { id: EntityId { value: 20 } }
    ]
    let shell = topology::OpenShell::new("test", faces)
    let s = shell.to_step()
    assert_eq(s, "OPEN_SHELL('test',(#10,#20))")
}

#[test]
fn topology_oriented_edge_to_step() {
    let edge_element = Ref { id: EntityId { value: 90 } }
    let entity = topology::OrientedEdge::new("", "*", "*", edge_element, true)
    assert_eq(entity.to_step(), "ORIENTED_EDGE('',*,*,#90,.T.)")
}

#[test]
fn topology_shellbasedsurfacemodel_to_step() {
    let bounds = #[
        Ref { id: EntityId { value: 10 } }
        Ref { id: EntityId { value: 20 } }
    ]
    let model = topology::ShellBasedSurfaceModel::new("test", bounds)
    let s = model.to_step()
    assert_eq(s, "SHELL_BASED_SURFACE_MODEL('test',(#10,#20))")
}

#[test]
fn topology_subface_to_step() {
    let bounds = #[Ref { id: EntityId { value: 10 } }]
    let parent = Ref { id: EntityId { value: 20 } }
    let face = topology::Subface::new("test", bounds, parent)
    let s = face.to_step()
    assert_eq(s, "SUBFACE('test',(#10),#20)")
}

#[test]
fn topology_vertex_point_to_step() {
    let geom = Ref { id: EntityId { value: 161 } }
    let entity = topology::VertexPoint::new("", geom)
    assert_eq(entity.to_step(), "VERTEX_POINT('',#161)")
}
