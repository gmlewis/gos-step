//! Differential parity against captured reference STEP output.
//!
//! Each reference file is an example's original output with the FILE_NAME timestamp
//! normalized. Only the DATA section is compared: entity order and numbers are
//! part of the contract.

use std::fs

use crate::cad::design::Design
use crate::cad::types::{Rgb, Shape}

fn reference_data(path: String) -> String {
    let text = fs::read_to_string(path).unwrap()
    let lines = text.split("\n")
    let mut out = ""
    let mut in_data = false
    for line in lines {
        if line == "DATA;" {
            in_data = true
            continue
        }
        if in_data {
            if line == "ENDSEC;" {
                break
            }
            out += line
            out += "\n"
        }
    }
    out.trim()
}

fn reverse(pts: Vec<(f64, f64)>) -> Vec<(f64, f64)> {
    let mut out = #[]
    let mut i = pts.len() as i64 - 1
    while i >= 0 {
        out.push(pts[i])
        i -= 1
    }
    out
}

#[test]
fn example_01_data_matches_reference() {
    let design = Design::new("hello-cube", "generated by gmlewis/step/cad", "", None).add(
        crate::cad::types::Cuboid::new(10.0, 10.0, 10.0)
            .named("cube")
            .colored(Rgb::green())
            .moved(0.0, 0.0, 0.0)
    )
    assert_eq(
        design.compile().to_step_data_section()
        reference_data("testdata/ref-01-edge-10.step")
    )
}

#[test]
fn example_02_data_matches_reference() {
    let design =
        Design::new("calibration-chamfer-block", "generated by gmlewis/step/cad", "", None).add(
            crate::cad::types::CalibrationChamferBlock::new(20.0, 20.0, 5.0, 1.0, 0.0, 10)
                .named("calibration-block")
                .moved(0.0, 0.0, 0.0)
        )
    assert_eq(
        design.compile().to_step_data_section()
        reference_data("testdata/ref-02-length20-width20-height5.step")
    )
}

#[test]
fn example_04_data_matches_reference() {
    let outer = crate::cad::types::Profile2D::circle(15.0, 64)
    let hole = reverse(crate::cad::types::Profile2D::circle(5.0, 64))
    let washer = crate::cad::types::ExtrudedProfile::new(outer, 2.0, #[hole])
        .named("washer")
        .colored(Rgb::blue())
        .moved(0.0, 0.0, 0.0)
    let design =
        Design::new("parametric-washer", "generated by gmlewis/step/cad", "", None).add(washer)
    assert_eq(
        design.compile().to_step_data_section()
        reference_data("testdata/ref-04-id5-od15-thickness2.step")
    )
}

/// Keep `Shape` referenced for callers that match on it.
pub fn _shape_marker(_s: Shape) {}
