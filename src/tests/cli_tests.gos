//! CLI argument-parser tests.
//!
//! Ported from the reference `tests/cli_argparse_forms_test.mbt` and
//! `tests/cli_validation_test.mbt`, plus coverage for the error contract
//! (messages, exit codes, help layout), the short-option forms, the builder
//! API, and `command_line()` / `documentation()`.

use std::collections::Map

use crate::cli::parse::{CliError, parse, parse_cli}
use crate::cli::spec::{
    Arg, Cli, NO_SHORT, flag, opt_double, opt_int, opt_string, with_translate
}

/// Relative float comparison (the lint suite rejects `assert_eq(f, 1.0)`).
fn approx(a: f64, b: f64, eps: f64 = 1.0e-9) -> bool {
    let d = a - b
    let ad = if d < 0.0 { -d } else { d }
    ad <= eps
}

/// Expect a failure; panic with `what` on success.
fn err_of<T>(r: Result<T, CliError>, what: String) -> CliError {
    match r {
        Ok(_) => panic(what)
        Err(e) => e
    }
}

fn expect_ok<T>(r: Result<T, CliError>, what: String) -> T {
    match r {
        Ok(v) => v
        Err(e) => panic(what + ": " + e.message)
    }
}

// ---------------------------------------------------------------------------
// Reference translate-bundle forms
// ---------------------------------------------------------------------------

#[test]
fn cli_translate_forms() {
    let spec = with_translate(Map::new())

    // Multi-token form: -t 1 2 3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "1", "2", "3"])
            "multi-token translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "multi-token translate_xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Comma bundle with negatives: -t -1,2,3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "-1,2,3"])
            "comma translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "comma translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Multi-token negatives: -t -1 -2 -3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "-1", "-2", "-3"])
            "negative multi-token translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "negative translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, -2.0))
        assert(approx(z, -3.0))
    }

    // Quoted whitespace form: -t "1 2 3".
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "1 2 3"])
            "whitespace translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "whitespace translate_xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Bare -t falls back to --tx/--ty/--tz.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "--tx", "5"])
            "bare translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "bare translate_xyz")
        assert(approx(x, 5.0))
        assert(approx(y, 0.0))
        assert(approx(z, 0.0))
    }

    // A bare value option followed by another option gets dropped rather than
    // swallowing it: --tx --ty 2 leaves tx at its default.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--tx", "--ty", "2"])
            "bare single-value option"
        )
        assert(approx(expect_ok(args.double("tx"), "tx").value, 0.0))
        assert(approx(expect_ok(args.double("ty"), "ty").value, 2.0))
    }
}

// ---------------------------------------------------------------------------
// Reference flags, defaults, unknown arguments, and range validation
// ---------------------------------------------------------------------------

#[test]
fn cli_flags_and_unknown_args() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("debug", flag(short: 'd', help: "Debug"))
    spec.insert("out", opt_string(short: 'o', help: "Output file"))
    spec.insert("count", opt_int(1, help: "Count", min: Some(1)))

    // Short flag + short option + defaults.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-d", "-o", "out.step"])
            "flags and options"
        )
        assert(args.flag("debug"))
        assert(args.bool_opt("debug"))
        assert_eq(args.string_opt("out"), Some("out.step"))
        assert_eq(expect_ok(args.int("count"), "count"), 1)
    }

    // Untouched flag defaults to false.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--count", "2"])
            "count only"
        )
        assert(!args.flag("debug"))
        assert(args.string_opt("out").is_none())
    }

    // Unknown option fails to parse.
    assert(parse(spec, prog: "t", cli_args: #["--nope"]).is_err())

    // int min validation.
    assert(parse(spec, prog: "t", cli_args: #["--count", "0"]).is_err())
    assert(parse(spec, prog: "t", cli_args: #["--count", "3"]).is_ok())
}

#[test]
fn cli_opt_double_exclusive_min() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert(
        "edge"
        opt_double(
            20.0
            help: "Edge length in millimeters"
            min: Some(0.0)
            min_exclusive: true
        )
    )

    // Strictly positive: edge must be > 0.
    assert(parse(spec, prog: "t", cli_args: #["--edge", "0"]).is_err())
    assert(parse(spec, prog: "t", cli_args: #["--edge", "-1"]).is_err())

    // Also works through the --name=value normalization.
    assert(parse(spec, prog: "t", cli_args: #["--edge=-1"]).is_err())

    // Valid value should parse.
    assert(parse(spec, prog: "t", cli_args: #["--edge", "0.1"]).is_ok())
}

#[test]
fn cli_negative_numbers_work() {
    let spec = with_translate(Map::new())

    // Negative numeric values should be accepted for named args.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--tx", "-1"])
            "negative tx"
        )
        assert(approx(expect_ok(args.double("tx"), "tx").value, -1.0))
    }

    // Also via --name=value.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--ty=-2.5"])
            "negative ty inline"
        )
        assert(approx(expect_ok(args.double("ty"), "ty").value, -2.5))
    }

    // And via translate bundle with comma-separated form.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "-1,2,3"])
            "negative comma translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "negative comma translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // And via --translate=value.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--translate=-1,2,3"])
            "negative inline translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "negative inline translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }
}

// ---------------------------------------------------------------------------
// Error contract
// ---------------------------------------------------------------------------

#[test]
fn cli_duplicate_short_option_message() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("first", opt_string(short: 'x'))
    spec.insert("second", opt_string(short: 'x'))
    let err = err_of(
        parse(spec, prog: "t", cli_args: #[])
        "duplicate short should fail"
    )
    assert_eq(
        err.message
        "error: duplicate short option '-x' used by --first and --second"
    )
    assert_eq(err.exit_code, 2)
    assert(!err.to_stdout)
}

#[test]
fn cli_range_messages_and_help() {
    // Inclusive lower bound.
    {
        let mut spec: Map<String, Arg> = Map::new()
        spec.insert("count", opt_int(1, help: "Count", min: Some(1)))
        let err = err_of(
            parse(spec, prog: "t", cli_args: #["--count", "0"])
            "min violation should fail"
        )
        assert_eq(err.exit_code, 2)
        assert(err.message.starts_with(
            "error: --count must be >= 1\n\nUsage: t [options]\n\nOptions:"
        ))
    }

    // Exclusive lower bound uses a double bound.
    {
        let mut spec: Map<String, Arg> = Map::new()
        spec.insert(
            "edge"
            opt_double(20.0, help: "Edge", min: Some(0.0), min_exclusive: true)
        )
        let err = err_of(
            parse(spec, prog: "t", cli_args: #["--edge", "0"])
            "exclusive min violation should fail"
        )
        assert(err.message.starts_with("error: --edge must be > 0\n\n"))
    }

    // Inclusive upper bound.
    {
        let mut spec: Map<String, Arg> = Map::new()
        spec.insert("count", opt_int(1, help: "Count", max: Some(10)))
        let err = err_of(
            parse(spec, prog: "t", cli_args: #["--count", "11"])
            "max violation should fail"
        )
        assert(err.message.starts_with("error: --count must be <= 10\n\n"))
    }

    // Exclusive upper bound.
    {
        let mut spec: Map<String, Arg> = Map::new()
        spec.insert(
            "edge"
            opt_double(1.0, help: "Edge", max: Some(10.0), max_exclusive: true)
        )
        let err = err_of(
            parse(spec, prog: "t", cli_args: #["--edge", "10"])
            "exclusive max violation should fail"
        )
        assert(err.message.starts_with("error: --edge must be < 10\n\n"))
    }
}

#[test]
fn cli_value_not_found_message() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("out", opt_string(short: 'o'))
    let args = expect_ok(parse(spec, prog: "t", cli_args: #[]), "empty argv")
    {
        let err = err_of(args.double("edge"), "missing double should fail")
        assert_eq(err.message, "error: value not found for: edge")
        assert_eq(err.exit_code, 1)
    }

    {
        let err = err_of(args.int("edge"), "missing int should fail")
        assert_eq(err.message, "error: value not found for: edge")
    }
}

#[test]
fn cli_unknown_argument_message_includes_help() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("out", opt_string(short: 'o'))
    let err = err_of(
        parse(spec, prog: "t", cli_args: #["--nope"])
        "unknown option should fail"
    )
    assert(err.message.starts_with("error: unexpected argument '--nope' found\n\nUsage: t [options]"))
    assert_eq(err.exit_code, 2)
}

// ---------------------------------------------------------------------------
// Help layout and help exit status
// ---------------------------------------------------------------------------

#[test]
fn cli_help_layout_matches_argparse() {
    let cli = Cli::new("t", "demo")
        .flag("debug", short: 'd', help: "Debug")
        .string("out", short: 'o', help: "Output file")
        .int("count", 1, help: "Count", min: Some(1))

    let err = err_of(parse_cli(cli, cli_args: #["--help"]), "--help should be a CliError")
    assert(err.is_help())
    assert_eq(err.exit_code, 0)
    assert(err.to_stdout)
    assert_eq(
        err.message
        "Usage: t [options]\n\ndemo\n\nOptions:\n  -h, --help       Show help information.\n  -d, --debug      Debug\n  -o, --out <out>  Output file\n  --count <count>  Count [default: 1]\n"
    )

    // The short spelling produces the same text and status.
    {
        let cli = Cli::new("t", "demo").flag("debug", short: 'd', help: "Debug")
        let err = err_of(parse_cli(cli, cli_args: #["-h"]), "-h should be a CliError")
        assert(err.is_help())
        assert_eq(err.exit_code, 0)
    }
}

#[test]
fn cli_help_omits_description_when_empty() {
    let cli = Cli::new("t")
    let err = err_of(parse_cli(cli, cli_args: #["--help"]), "--help should be a CliError")
    assert_eq(
        err.message
        "Usage: t\n\nOptions:\n  -h, --help  Show help information.\n"
    )
}

// ---------------------------------------------------------------------------
// Option forms and preprocessing
// ---------------------------------------------------------------------------

#[test]
fn cli_short_and_long_option_forms() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("out", opt_string(short: 'o', help: "Output file"))

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-oout.step"])
            "-xvalue"
        )
        assert_eq(args.string_opt("out"), Some("out.step"))
    }

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-o=out.step"])
            "-x=value"
        )
        assert_eq(args.string_opt("out"), Some("out.step"))
    }

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--out=out.step"])
            "--name=value"
        )
        assert_eq(args.string_opt("out"), Some("out.step"))
    }

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--out", "out.step"])
            "--name value"
        )
        assert_eq(args.string_opt("out"), Some("out.step"))
    }
}

#[test]
fn cli_value_like_tokens_are_values() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("out", opt_string(short: 'o'))
    spec.insert("x", opt_double(0.0, short: 'x'))

    // A bare "-" is a value, not an option.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-o", "-"])
            "bare dash value"
        )
        assert_eq(args.string_opt("out"), Some("-"))
    }

    // "-.5" has no leading zero but is still value-like and numeric.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-x", "-.5"])
            "negative fraction"
        )
        assert(approx(expect_ok(args.double("x"), "x").value, -0.5))
    }

    // "-1e-3" is value-like and parses in exponent form.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--x=-1e-3"])
            "negative exponent"
        )
        assert(approx(expect_ok(args.double("x"), "x").value, -0.001))
    }
}

#[test]
fn cli_combined_short_flags() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("debug", flag(short: 'd'))
    spec.insert("verbose", flag(short: 'v'))
    let args = expect_ok(parse(spec, prog: "t", cli_args: #["-dv"]), "-dv")
    assert(args.flag("debug"))
    assert(args.flag("verbose"))

    assert(parse(spec, prog: "t", cli_args: #["-dz"]).is_err())
}

#[test]
fn cli_double_dash_terminates_options() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("debug", flag(short: 'd'))

    let args = expect_ok(parse(spec, prog: "t", cli_args: #["--"]), "bare --")
    assert(!args.flag("debug"))

    // No positionals are declared, so anything after -- is unexpected.
    assert(parse(spec, prog: "t", cli_args: #["--", "--debug"]).is_err())
}

#[test]
fn cli_string_opt_requires_exactly_one_value() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("out", opt_string(short: 'o'))

    let args = expect_ok(
        parse(spec, prog: "t", cli_args: #["-o", "a", "-o", "b"])
        "repeated string option"
    )
    assert(args.string_opt("out").is_none())
    assert_eq(args.raw_values("out").join(","), "a,b")
}

#[test]
fn cli_default_is_replaced_by_first_occurrence() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("count", opt_int(1, help: "Count", min: Some(1)))

    {
        let args = expect_ok(parse(spec, prog: "t", cli_args: #[]), "default")
        assert_eq(expect_ok(args.int("count"), "default count"), 1)
    }

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--count", "3"])
            "provided count"
        )
        assert_eq(expect_ok(args.int("count"), "provided count"), 3)
        // The default must not remain as a second value.
        assert_eq(args.raw_values("count").join(","), "3")
    }
}

// ---------------------------------------------------------------------------
// translate_xyz error messages and precedence
// ---------------------------------------------------------------------------

#[test]
fn cli_translate_wrong_count_messages() {
    let spec = with_translate(Map::new())

    // Parsing succeeds; the wrong count is diagnosed when the caller asks for
    // the triple, exactly as in the reference.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "1", "2"])
            "two-value translate parses"
        )
        let err = err_of(args.translate_xyz(), "two-value translate should fail")
        assert_eq(
            err.message
            "error: --translate/-t expects exactly 3 numbers: <x> <y> <z>"
        )
        assert_eq(err.exit_code, 1)
    }

    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--translate=1,x,3"])
            "non-numeric translate parses"
        )
        let err = err_of(args.translate_xyz(), "non-numeric translate should fail")
        assert_eq(err.message, "error: --translate/-t expects numeric values")
        assert_eq(err.exit_code, 1)
    }
}

#[test]
fn cli_translate_precedence_and_legacy_form() {
    let spec = with_translate(Map::new())

    // --translate with three values overrides --tx/--ty/--tz.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--translate", "1,2,3", "--tx", "9"])
            "translate precedence"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "translate precedence xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Three separate occurrences of the Vec3 option form the legacy triple.
    {
        let args = expect_ok(
            parse(
                spec
                prog: "t"
                cli_args: #["--translate", "1", "--translate", "2", "--translate", "3"]
            )
            "legacy translate occurrences"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "legacy translate xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }
}

// ---------------------------------------------------------------------------
// command_line() and documentation()
// ---------------------------------------------------------------------------

#[test]
fn cli_command_line_and_documentation() {
    let mut spec = with_translate(Map::new())
    spec.insert("debug", flag(short: 'd', help: "Debug"))
    spec.insert("out", opt_string(short: 'o', help: "Output file"))

    let args = expect_ok(
        parse(
            spec
            prog: "38-planetary-gearbox"
            cli_args: #["-o", "gear box.step", "--debug"]
        )
        "documented run"
    )
    assert_eq(
        args.command_line()
        "./run-example.sh 38 -o 'gear box.step' --debug"
    )
    assert_eq(
        args.documentation()
        "Generated by the gmlewis/step CAD library.\nRepository: https://github.com/gmlewis/gos-step\nExample:    38-planetary-gearbox\nCommand:    ./run-example.sh 38 -o 'gear box.step' --debug\nParameters:\n  --debug = true\n  --out = gear box.step\n  --translate = (unset)\n  --tx = 0\n  --ty = 0\n  --tz = 0"
    )
}

#[test]
fn cli_shell_quote_handles_embedded_single_quote() {
    let mut spec = with_translate(Map::new())
    spec.insert("out", opt_string(short: 'o'))
    let args = expect_ok(
        parse(spec, prog: "01-test", cli_args: #["-o", "it's a file"])
        "quoted token"
    )
    assert_eq(
        args.command_line()
        "./run-example.sh 01 -o 'it'\\''s a file'"
    )
}

#[test]
fn cli_example_number_without_dash_is_unchanged() {
    let spec = with_translate(Map::new())
    let args = expect_ok(parse(spec, prog: "plain", cli_args: #[]), "plain prog")
    assert_eq(args.command_line(), "./run-example.sh plain")
}

// ---------------------------------------------------------------------------
// Builder API equivalence
// ---------------------------------------------------------------------------

#[test]
fn cli_builder_and_map_apis_agree() {
    let cli = Cli::new("t", "demo")
        .string("out", short: 'o', help: "Output file")
        .int("count", 1, help: "Count", min: Some(1))

    let mut map: Map<String, Arg> = Map::new()
    map.insert("out", opt_string(short: 'o', help: "Output file"))
    map.insert("count", opt_int(1, help: "Count", min: Some(1)))

    let from_builder = expect_ok(
        parse_cli(cli, cli_args: #["-o", "a.step", "--count", "2"])
        "builder parse"
    )
    let from_map = expect_ok(
        parse(map, prog: "t", cli_args: #["-o", "a.step", "--count", "2"])
        "map parse"
    )

    assert_eq(from_builder.string_opt("out"), from_map.string_opt("out"))
    assert_eq(
        expect_ok(from_builder.int("count"), "builder count")
        expect_ok(from_map.int("count"), "map count")
    )
    assert_eq(from_builder.command_line(), from_map.command_line())
}

#[test]
fn cli_builder_declaration_order_drives_help() {
    // Declared in the opposite order from alphabetical: help must follow the
    // builder, while the map API uses the map's deterministic order.
    let cli = Cli::new("t")
        .string("zebra", short: 'z', help: "Zebra")
        .flag("alpha", short: 'a', help: "Alpha")
    let err = err_of(parse_cli(cli, cli_args: #["--help"]), "--help")
    assert(err.message.contains("  -z, --zebra <zebra>"))
    let alpha_pos = err.message.find("--alpha").unwrap()
    let zebra_pos = err.message.find("--zebra").unwrap()
    assert(alpha_pos < zebra_pos)
}

#[test]
fn cli_no_short_option_renders_long_only() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("count", opt_int(1, help: "Count"))
    let err = err_of(parse(spec, prog: "t", cli_args: #["--help"]), "--help")
    assert(err.message.contains("  --count <count>  Count [default: 1]\n"))
    assert_eq(NO_SHORT as u32, 0)
}
