//! CLI argument-parser tests.
//!
//! Ported from the reference `tests/cli_argparse_forms_test.mbt` and
//! `tests/cli_validation_test.mbt`, plus coverage for the error contract
//! (messages, exit codes, help layout) and `command_line()` / `documentation()`.

use std::collections::Map

use crate::cli::parse::{CliError, parse, parse_cli}
use crate::cli::spec::{Arg, Cli, flag, opt_int, opt_string, with_translate}

/// Relative float comparison (the lint suite rejects `assert_eq(f, 1.0)`).
fn approx(a: f64, b: f64, eps: f64 = 1.0e-9) -> bool {
    let d = a - b
    let ad = if d < 0.0 { -d } else { d }
    ad <= eps
}

/// Expect a failure; panic with `what` on success.
fn err_of<T>(r: Result<T, CliError>, what: String) -> CliError {
    match r {
        Ok(_) => panic(what)
        Err(e) => e
    }
}

fn expect_ok<T>(r: Result<T, CliError>, what: String) -> T {
    match r {
        Ok(v) => v
        Err(e) => panic(what + ": " + e.message)
    }
}

#[test]
fn cli_translate_forms() {
    let spec = with_translate(Map::new())

    // Multi-token form: -t 1 2 3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "1", "2", "3"])
            "multi-token translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "multi-token translate_xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Comma bundle with negatives: -t -1,2,3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "-1,2,3"])
            "comma translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "comma translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Multi-token negatives: -t -1 -2 -3.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "-1", "-2", "-3"])
            "negative multi-token translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "negative translate_xyz")
        assert(approx(x, -1.0))
        assert(approx(y, -2.0))
        assert(approx(z, -3.0))
    }

    // Quoted whitespace form: -t "1 2 3".
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "1 2 3"])
            "whitespace translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "whitespace translate_xyz")
        assert(approx(x, 1.0))
        assert(approx(y, 2.0))
        assert(approx(z, 3.0))
    }

    // Bare -t falls back to --tx/--ty/--tz.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-t", "--tx", "5"])
            "bare translate"
        )
        let x, y, z = expect_ok(args.translate_xyz(), "bare translate_xyz")
        assert(approx(x, 5.0))
        assert(approx(y, 0.0))
        assert(approx(z, 0.0))
    }

    // A bare value option followed by another option gets dropped rather than
    // swallowing it: --tx --ty 2 leaves tx at its default.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--tx", "--ty", "2"])
            "bare single-value option"
        )
        assert(approx(expect_ok(args.double("tx"), "tx").value, 0.0))
        assert(approx(expect_ok(args.double("ty"), "ty").value, 2.0))
    }
}

#[test]
fn cli_flags_and_unknown_args() {
    let mut spec: Map<String, Arg> = Map::new()
    spec.insert("debug", flag(short: 'd', help: "Debug"))
    spec.insert("out", opt_string(short: 'o', help: "Output file"))
    spec.insert("count", opt_int(1, help: "Count", min: Some(1)))

    // Short flag + short option + defaults.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["-d", "-o", "out.step"])
            "flags and options"
        )
        assert(args.flag("debug"))
        assert(args.bool_opt("debug"))
        assert_eq(args.string_opt("out"), Some("out.step"))
        assert_eq(expect_ok(args.int("count"), "count"), 1)
    }

    // Untouched flag defaults to false.
    {
        let args = expect_ok(
            parse(spec, prog: "t", cli_args: #["--count", "2"])
            "count only"
        )
        assert(!args.flag("debug"))
        assert(args.string_opt("out").is_none())
    }

    // Unknown option fails to parse.
    assert(parse(spec, prog: "t", cli_args: #["--nope"]).is_err())

    // int min validation.
    assert(parse(spec, prog: "t", cli_args: #["--count", "0"]).is_err())
    assert(parse(spec, prog: "t", cli_args: #["--count", "3"]).is_ok())
}

#[test]
fn cli_help_layout_matches_argparse() {
    let cli = Cli::new("t", "demo")
        .flag("debug", short: 'd', help: "Debug")
        .string("out", short: 'o', help: "Output file")
        .int("count", 1, help: "Count", min: Some(1))

    let err = err_of(parse_cli(cli, cli_args: #["--help"]), "--help should be a CliError")
    assert(err.is_help())
    assert_eq(err.exit_code, 0)
    assert(err.to_stdout)
    assert_eq(
        err.message
        "Usage: t [options]\n\ndemo\n\nOptions:\n  -h, --help       Show help information.\n  -d, --debug      Debug\n  -o, --out <out>  Output file\n  --count <count>  Count [default: 1]\n"
    )

    // The short spelling produces the same text and status.
    {
        let cli = Cli::new("t", "demo").flag("debug", short: 'd', help: "Debug")
        let err = err_of(parse_cli(cli, cli_args: #["-h"]), "-h should be a CliError")
        assert(err.is_help())
        assert_eq(err.exit_code, 0)
    }
}

#[test]
fn cli_command_line_and_documentation() {
    let mut spec = with_translate(Map::new())
    spec.insert("debug", flag(short: 'd', help: "Debug"))
    spec.insert("out", opt_string(short: 'o', help: "Output file"))

    let args = expect_ok(
        parse(
            spec
            prog: "38-planetary-gearbox"
            cli_args: #["-o", "gear box.step", "--debug"]
        )
        "documented run"
    )
    assert_eq(
        args.command_line()
        "./run-example.sh 38 -o 'gear box.step' --debug"
    )
    assert_eq(
        args.documentation()
        "Generated by the gmlewis/step CAD library.\nRepository: https://github.com/gmlewis/gos-step\nExample:    38-planetary-gearbox\nCommand:    ./run-example.sh 38 -o 'gear box.step' --debug\nParameters:\n  --debug = true\n  --out = gear box.step\n  --translate = (unset)\n  --tx = 0\n  --ty = 0\n  --tz = 0"
    )
}
