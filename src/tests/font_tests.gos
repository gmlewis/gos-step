//! Tests for the font port: parsing, translation, layout, drawing, flattening,
//! and loading the real Baloo font.
//!
//! Expected strings for `translate_path` are taken verbatim from the
//! reference `gmlewis/fonts` test suite.

use std::env

use crate::font::draw::{Anchor, Graphic, Path, to_graphic}
use crate::font::flatten::{bbox, cubic_bezier_at}
use crate::font::layout::Alignment
use crate::font::load::load_font
use crate::font::model::{Font, Glyph, Vec2, decode_font}
use crate::font::svg

/// Panic with a labelled message when `condition` is false.
fn expect(condition: bool, what: String) {
    assert(condition, what)
}

/// Panic unless two `f64`s agree to 1e-9.
fn expect_close(got: f64, want: f64, what: String) {
    let delta = got - want
    assert(delta <= 1e-9 && delta >= -1e-9, f"{what}: got {got}, want {want}")
}

/// A tiny three-glyph font used by the drawing tests. Its paths are the
/// `nullpointer` fixture from the reference CAD tests.
fn stub_font() -> Font {
    let glyphs: Map<String, Glyph> = {
        "A": Glyph {
            char: "A"
            horiz_adv_x: 0.0
            gerber_lp: "dc"
            d: "M507 24L48 24L48 530L395 530L395 625L48 625L48 723L507 723L507 24ZM395 269L395 433L138 433L138 269L395 269Z"
            xmin: 48.0
            ymin: 24.0
            xmax: 507.0
            ymax: 723.0
        }
        "B": Glyph {
            char: "B"
            horiz_adv_x: 0.0
            gerber_lp: "dc"
            d: "M507 21L48 21L48 723L160 723L160 530L507 530L507 21ZM417 269L417 433L160 433L160 269L417 269Z"
            xmin: 48.0
            ymin: 21.0
            xmax: 507.0
            ymax: 723.0
        }
        "C": Glyph {
            char: "C"
            horiz_adv_x: 0.0
            gerber_lp: "d"
            d: "M507 21L48 21L48 723L507 723L507 625L160 625L160 269L507 269L507 21Z"
            xmin: 48.0
            ymin: 21.0
            xmax: 507.0
            ymax: 723.0
        }
    }
    Font {
        id: "nullpointer"
        horiz_adv_x: 540.0
        units_per_em: 1000.0
        ascent: 800.0
        descent: -200.0
        glyphs: glyphs
    }
}

/// A one-glyph font whose glyph is keyed `"X"` with the given path.
fn one_glyph_font(key: String, d: String) -> Font {
    let glyphs: Map<String, Glyph> = {
        key: Glyph {
            char: key
            horiz_adv_x: 0.0
            gerber_lp: "d"
            d: d
            xmin: 0.0
            ymin: 0.0
            xmax: 100.0
            ymax: 100.0
        }
    }
    Font {
        id: "tiny"
        horiz_adv_x: 100.0
        units_per_em: 1000.0
        ascent: 800.0
        descent: -200.0
        glyphs: glyphs
    }
}

/// Extract the first compound path from a graphic, panicking otherwise.
fn as_compound(graphic: Graphic) -> Vec<Path> {
    match graphic {
        Graphic::CompoundPath(cp) => cp.paths
        _ => panic("expected a CompoundPath graphic")
    }
}

#[test]
fn parse_params_spaces_and_decimals() {
    let got = match svg::parse_params(" 343 75 327.5 112 ") {
        Ok(v) => v
        Err(e) => panic(f"{e}")
    }
    expect(got.len() == 4, f"count {got.len()}")
    expect_close(got[0], 343.0, "p0")
    expect_close(got[1], 75.0, "p1")
    expect_close(got[2], 327.5, "p2")
    expect_close(got[3], 112.0, "p3")
}

#[test]
fn parse_params_handles_newlines_and_adjacent_signs() {
    let got = match svg::parse_params("343\n75\n-3.5,112") {
        Ok(v) => v
        Err(e) => panic(f"{e}")
    }
    expect(got.len() == 4, f"count {got.len()}")
    expect_close(got[2], -3.5, "negative")
    expect_close(got[3], 112.0, "last")
}

#[test]
fn split_path_reference_path() {
    let d = "M507 24L48 24L48 530L395 530L395 625L48 625L48 723L507 723L507 24ZM395 269L395 433L138 433L138 269L395 269Z"
    let cmds = match svg::split_path(d) {
        Ok(v) => v
        Err(e) => panic(f"{e}")
    }
    expect(cmds.len() == 16, f"cmd count {cmds.len()}")
    expect(cmds[0].c == 'M', "first is M")
    expect(cmds[0].p.len() == 2, "first has 2 params")
    expect_close(cmds[0].p[0], 507.0, "first x")
    expect_close(cmds[0].p[1], 24.0, "first y")
    expect(cmds[9].c == 'Z', "tenth is Z")
    expect(cmds[9].p.len() == 0, "Z has no params")
}

#[test]
fn split_path_rejects_relative_commands() {
    let rejected = match svg::split_path("m10 10l20 20") {
        Ok(_) => false
        Err(_) => true
    }
    expect(rejected, "relative commands must be rejected")
}

#[test]
fn translate_path_reference() {
    let d = "M507 24L48 24L48 530L395 530L395 625L48 625L48 723L507 723L507 24ZM395 269L395 433L138 433L138 269L395 269Z"
    let got = match svg::translate_path(d, 1000.0, 2000.0) {
        Ok(s) => s
        Err(e) => panic(f"{e}")
    }
    let want = "M1507 2024L1048 2024L1048 2530L1395 2530L1395 2625L1048 2625L1048 2723L1507 2723L1507 2024ZM1395 2269L1395 2433L1138 2433L1138 2269L1395 2269Z"
    expect(got == want, f"translate got {got}")
}

#[test]
fn translate_path_reference_inverted() {
    let d = "M507 24L48 24L48 530L395 530L395 625L48 625L48 723L507 723L507 24ZM395 269L395 433L138 433L138 269L395 269Z"
    let got = match svg::translate_path(d, 1000.0, 2000.0, invert_y: true) {
        Ok(s) => s
        Err(e) => panic(f"{e}")
    }
    let want = "M1507 1976L1048 1976L1048 1470L1395 1470L1395 1375L1048 1375L1048 1277L1507 1277L1507 1976ZM1395 1731L1395 1567L1138 1567L1138 1731L1395 1731Z"
    expect(got == want, f"inverted got {got}")
}

#[test]
fn svg_num_trims_integral_suffix() {
    expect(svg::svg_num(500.0) == "500", f"got {svg::svg_num(500.0)}")
    expect(svg::svg_num(327.5) == "327.5", f"got {svg::svg_num(327.5)}")
    expect(svg::svg_num(-0.0) == "-0", f"got {svg::svg_num(-0.0)}")
}

#[test]
fn gen_path_single_glyph_y_up() {
    let font = stub_font()
    let glyph = match font.gen_path("A", y_up: true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    expect(glyph.char == "A", f"char {glyph.char}")
    expect(glyph.gerber_lp == "dc", f"gerber {glyph.gerber_lp}")
    expect_close(glyph.horiz_adv_x, 0.0, "super-glyph advance")
    expect_close(glyph.xmin, 48.0, "xmin")
    expect_close(glyph.ymin, 24.0, "ymin")
    expect_close(glyph.xmax, 507.0, "xmax")
    expect_close(glyph.ymax, 723.0, "ymax")
    let want = "M507 24L48 24L48 530L395 530L395 625L48 625L48 723L507 723L507 24ZM395 269L395 433L138 433L138 269L395 269Z"
    expect(glyph.d == want, "single glyph path unchanged")
}

#[test]
fn gen_path_center_alignment() {
    let font = stub_font()
    let glyph = match font.gen_path("A", alignment: Alignment::Center, y_up: true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    // Center of x [48,507] is 277.5; center of y [24,723] is 373.5.
    expect_close(glyph.xmin, -229.5, "xmin")
    expect_close(glyph.ymin, -349.5, "ymin")
    expect_close(glyph.xmax, 229.5, "xmax")
    expect_close(glyph.ymax, 349.5, "ymax")
    expect(glyph.d.starts_with("M229.5 -349.5"), f"path starts {glyph.d}")
}

#[test]
fn gen_path_inverts_y_for_svg_canvas() {
    let font = stub_font()
    let glyph = match font.gen_path("A", y_up: false) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    // With y_up = false the stored Y range [24,723] becomes [-723,-24].
    expect_close(glyph.xmin, 48.0, "xmin")
    expect_close(glyph.ymin, -723.0, "ymin")
    expect_close(glyph.xmax, 507.0, "xmax")
    expect_close(glyph.ymax, -24.0, "ymax")
    expect(glyph.d.starts_with("M507 -24"), f"path starts {glyph.d}")
}

#[test]
fn gen_path_advances_second_glyph() {
    let font = stub_font()
    let glyph = match font.gen_path("AB", y_up: true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    // "A" has a zero advance, so the pen moves by the font default (540).
    expect(glyph.char == "AB", f"char {glyph.char}")
    expect_close(glyph.xmax, 540.0 + 507.0, "xmax")
}

#[test]
fn gen_path_missing_characters_and_newline() {
    let font = stub_font()
    let glyph = match font.gen_path("\n", y_up: true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    expect(glyph.char == "\n", "newline recorded")
    // With y_up, a newline advances y by units_per_em - descent = 1200.
    expect(glyph.d.len() == 0, "empty path")
}

#[test]
fn to_graphic_a_has_two_subpaths() {
    let font = stub_font()
    let graphic = match to_graphic(font, "A", 1.0, Alignment::Center, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    expect(paths.len() == 2, f"subpath count {paths.len()}")
    expect(!paths[0].clear, "outer is dark")
    expect(paths[0].closed, "outer is closed")
    expect(paths[0].anchors.len() == 9, f"outer anchors {paths[0].anchors.len()}")
    expect(paths[1].clear, "counter is clear")
    expect(paths[1].closed, "counter is closed")
    expect(paths[1].anchors.len() == 5, f"counter anchors {paths[1].anchors.len()}")
    // First point is (507,24), centred then scaled by 0.001.
    let first = paths[0].anchors[0].position
    expect_close(first.x, 0.2295, "scaled x")
    expect_close(first.y, -0.3495, "scaled y")
}

#[test]
fn to_graphic_promotes_quadratic_to_cubic() {
    let font = one_glyph_font("X", "M0 0Q100 0 100 100Z")
    let graphic = match to_graphic(font, "X", 1000.0, Alignment::Unchanged, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    expect(paths.len() == 1, "one subpath")
    let anchors = paths[0].anchors
    expect(anchors.len() == 2, f"anchors {anchors.len()}")
    // c1 = start + 2/3 * (ctrl - start); c2 = end + 2/3 * (ctrl - end).
    expect_close(anchors[0].handle_out.x, 200.0 / 3.0, "c1 x")
    expect_close(anchors[0].handle_out.y, 0.0, "c1 y")
    expect_close(anchors[1].handle_in.x, 0.0, "c2 x")
    expect_close(anchors[1].handle_in.y, -200.0 / 3.0, "c2 y")
}

#[test]
fn to_graphic_reads_cubic_handles() {
    let font = one_glyph_font("X", "M0 0C10 0 20 10 20 20Z")
    let graphic = match to_graphic(font, "X", 1000.0, Alignment::Unchanged, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    expect(paths.len() == 1, "one subpath")
    expect(paths[0].closed, "closed by Z")
    let anchors = paths[0].anchors
    expect(anchors.len() == 2, f"anchors {anchors.len()}")
    // handle_out = c1 - start; handle_in = c2 - end.
    expect_close(anchors[0].handle_out.x, 10.0, "out x")
    expect_close(anchors[0].handle_out.y, 0.0, "out y")
    expect_close(anchors[1].position.x, 20.0, "end x")
    expect_close(anchors[1].position.y, 20.0, "end y")
    expect_close(anchors[1].handle_in.x, 0.0, "in x")
    expect_close(anchors[1].handle_in.y, -10.0, "in y")
}

#[test]
fn to_polygon_lines_endpoint_exclusive() {
    let font = stub_font()
    let graphic = match to_graphic(font, "A", 1.0, Alignment::Center, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    let poly = paths[0].to_polygon(8)
    // The outer contour closes on its first point, which is dropped.
    expect(poly.len() == 8, f"polygon points {poly.len()}")
    expect_close(poly[0].x, 0.2295, "p0 x")
    expect_close(poly[0].y, -0.3495, "p0 y")
    expect_close(poly[7].x, 0.2295, "last x")
    expect_close(poly[7].y, 0.3495, "last y")
}

#[test]
fn to_polygon_samples_curves_inclusively() {
    // A two-anchor closed path with real handles: each segment contributes
    // `curve_segments` samples (both endpoints), the shared endpoint of the
    // two segments is deduped, and the closing duplicate is dropped.
    let mut anchors: Vec<Anchor> = #[]
    anchors.push(Anchor::new(Vec2::new(0.0, 0.0), Vec2::new(0.0, -10.0), Vec2::new(0.0, 10.0)))
    anchors.push(Anchor::new(Vec2::new(10.0, 10.0), Vec2::new(0.0, 10.0), Vec2::new(10.0, 0.0)))
    let path = Path::new(anchors, true, false)
    let poly = path.to_polygon(3)
    expect(poly.len() == 4, f"polygon points {poly.len()}")
    expect_close(poly[0].x, 0.0, "start x")
    expect_close(poly[0].y, 0.0, "start y")
    expect_close(poly[1].x, 5.0, "mid x")
}

#[test]
fn path_bbox_uses_true_cubic_extrema() {
    // A symmetric bump from (0,0) to (100,0) peaking at y=75, while both
    // control points sit at y=100.
    let mut anchors: Vec<Anchor> = #[]
    anchors.push(Anchor::new(Vec2::new(0.0, 0.0), Vec2::new(0.0, 0.0), Vec2::new(0.0, 100.0)))
    anchors.push(Anchor::new(Vec2::new(100.0, 0.0), Vec2::new(100.0, 100.0), Vec2::new(0.0, 0.0)))
    let path = Path::new(anchors, false, false)
    let box = match path.bounding_box() {
        Some(b) => b
        None => panic("expected a bounding box")
    }
    expect_close(box.min.x, 0.0, "min x")
    expect_close(box.max.x, 100.0, "max x")
    expect_close(box.min.y, 0.0, "min y")
    expect_close(box.max.y, 75.0, "max y")
}

#[test]
fn fit_to_is_uniform_and_centered() {
    let points: Vec<Vec2> = #[Vec2::new(0.0, 0.0), Vec2::new(10.0, 0.0), Vec2::new(10.0, 20.0), Vec2::new(0.0, 20.0)]
    let path = Path::from_points(points, true)
    let fitted = Graphic::Path(path).fit_to(bbox(0.0, 0.0, 100.0, 100.0), Alignment::Center)
    let box = match fitted.bounding_box() {
        Some(b) => b
        None => panic("expected a bounding box")
    }
    // 10x20 scaled by 5 becomes 50x100; centered horizontally at x=25.
    expect_close(box.min.x, 25.0, "min x")
    expect_close(box.max.x, 75.0, "max x")
    expect_close(box.min.y, 0.0, "min y")
    expect_close(box.max.y, 100.0, "max y")
}

#[test]
fn scale_to_fit_matches_fit_to() {
    let points: Vec<Vec2> = #[Vec2::new(0.0, 0.0), Vec2::new(4.0, 0.0), Vec2::new(4.0, 4.0)]
    let a = Graphic::Path(Path::from_points(points, true)).fit_to(bbox(0.0, 0.0, 8.0, 8.0), Alignment::Center)
    let b = Graphic::Path(Path::from_points(points, true)).scale_to_fit(bbox(0.0, 0.0, 8.0, 8.0), Alignment::Center)
    let ab = match a.bounding_box() {
        Some(v) => v
        None => panic("a bbox")
    }
    let bb = match b.bounding_box() {
        Some(v) => v
        None => panic("b bbox")
    }
    expect_close(ab.min.x, bb.min.x, "same min x")
    expect_close(ab.max.y, bb.max.y, "same max y")
}

#[test]
fn to_profiles_tuples_tags_clear_flags() {
    let font = stub_font()
    let graphic = match to_graphic(font, "A", 1.0, Alignment::Center, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    let outer = Graphic::Path(paths[0]).to_profiles_tuples(8)
    expect(outer.len() == 1, f"outer profiles {outer.len()}")
    let outer_pts, outer_clear = outer[0]
    expect(!outer_clear, "outer not clear")
    expect(outer_pts.len() == 8, f"outer points {outer_pts.len()}")
    let hole = Graphic::Path(paths[1]).to_profiles_tuples(8)
    expect(hole.len() == 1, f"hole profiles {hole.len()}")
    let hole_pts, hole_clear = hole[0]
    expect(hole_clear, "hole clear")
    expect(hole_pts.len() == 4, f"hole points {hole_pts.len()}")
}

#[test]
fn cubic_bezier_endpoints() {
    let p0 = Vec2::new(0.0, 0.0)
    let p1 = Vec2::new(0.0, 100.0)
    let p2 = Vec2::new(100.0, 100.0)
    let p3 = Vec2::new(100.0, 0.0)
    let start = cubic_bezier_at(p0, p1, p2, p3, 0.0)
    let end = cubic_bezier_at(p0, p1, p2, p3, 1.0)
    let mid = cubic_bezier_at(p0, p1, p2, p3, 0.5)
    expect_close(start.x, 0.0, "start x")
    expect_close(end.x, 100.0, "end x")
    expect_close(mid.x, 50.0, "mid x")
    expect_close(mid.y, 75.0, "mid y")
}

#[test]
fn decode_font_inline_json() {
    let json = "{\"id\":\"t\",\"horiz_adv_x\":100,\"units_per_em\":1000,\"ascent\":800,\"descent\":-200,\"glyphs\":{\"A\":{\"char\":\"A\",\"horiz_adv_x\":50,\"gerber_lp\":\"d\",\"d\":\"M0 0L10 0Z\",\"xmin\":0,\"ymin\":0,\"xmax\":10,\"ymax\":10}}}"
    let font = match decode_font(json) {
        Ok(f) => f
        Err(e) => panic(f"{e}")
    }
    expect(font.id == "t", f"id {font.id}")
    expect(font.glyph_count() == 1, f"glyph count {font.glyph_count()}")
    let glyph = match font.glyphs.get("A") {
        Some(g) => g
        None => panic("missing glyph A")
    }
    expect(glyph.d == "M0 0L10 0Z", f"d {glyph.d}")
    expect_close(glyph.horiz_adv_x, 50.0, "advance")
}

#[test]
fn load_missing_font_reports_reference_message() {
    let message = match load_font("definitely-not-a-font") {
        Ok(_) => panic("missing font must not load")
        Err(e) => e.message
    }
    expect(
        message == "Font 'definitely-not-a-font' not found. See above for instructions."
        f"message {message}"
    )
}

#[test]
fn load_real_baloo_font() {
    let root = match env::current_dir() {
        Ok(dir) => dir
        Err(_) => "/Users/glenn/src/github.com/gmlewis/gos-step"
    }
    env::set_var("STEP_ROOT", root)
    let font = match load_font("baloo") {
        Ok(f) => f
        Err(e) => panic(f"{e}")
    }
    expect(font.id == "baloo", f"font id {font.id}")
    expect(font.glyph_count() == 743, f"glyph count {font.glyph_count()}")
    let glyph = match font.glyphs.get("A") {
        Some(g) => g
        None => panic("baloo is missing glyph A")
    }
    expect(glyph.d.len() > 0, "glyph A has a path")
    // Layout the letter and draw it; this exercises the real parser.
    let super_glyph = match font.gen_path("A", alignment: Alignment::Center, y_up: true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    expect(super_glyph.d.len() > 0, "laid-out path is non-empty")
    let graphic = match to_graphic(font, "A", 5.0, Alignment::Center, true) {
        Ok(g) => g
        Err(e) => panic(f"{e}")
    }
    let paths = as_compound(graphic)
    expect(paths.len() >= 1, f"subpaths {paths.len()}")
    let box = match graphic.bounding_box() {
        Some(b) => b
        None => panic("drawn glyph has a bounding box")
    }
    expect(box.width() > 0.0 && box.height() > 0.0, "non-degenerate bbox")
}
