//! Bit-exactness tests for the fdlibm trigonometric and inverse trigonometric
//! port.
//!
//! The decimal expectations are the documented reference examples; the
//! hexadecimal ones were captured from the reference implementation's own
//! output for the same inputs.

use std::math

use crate::cad::refmath

const F64_SIGN: u64 = 0x8000000000000000
const F64_ONE: u64 = 0x3ff0000000000000
const NAN_BITS: u64 = 0x7ff8000000000001
const NEG_INF_BITS: u64 = 0xfff0000000000000

#[test]
fn refmath_documented_examples() {
    assert_eq(refmath::sin(0.0), 0.0)
    assert_eq(refmath::sin(2.0), 0.9092974268256817)
    assert_eq(refmath::sin(-5.0), 0.9589242746631385)
    assert_eq(refmath::cos(2.5), -0.8011436155469337)
    assert_eq(refmath::cos(-5.0), 0.28366218546322625)
    assert_eq(refmath::tan(4.0), 1.1578212823495777)
    assert_eq(refmath::tan(5.0), -3.380515006246586)

    // Huge arguments: the reduction must stay exact.
    let huge = 31415926535897.9323846
    assert_eq(refmath::sin(huge), 0.0012091232715481885)
    assert_eq(refmath::cos(huge), 0.9999992690101899)
    assert_eq(refmath::tan(huge), 0.0012091241554056254)
}

#[test]
fn refmath_special_values() {
    let inf = f64::from_bits(0x7ff0000000000000)
    let neg_inf = f64::from_bits(NEG_INF_BITS)
    let nan = f64::from_bits(0x7ff8000000000000)
    assert_eq(refmath::sin(inf).to_bits(), NAN_BITS)
    assert_eq(refmath::sin(neg_inf).to_bits(), NAN_BITS)
    assert_eq(refmath::sin(nan).to_bits(), NAN_BITS)
    assert_eq(refmath::cos(inf).to_bits(), NAN_BITS)
    assert_eq(refmath::cos(neg_inf).to_bits(), NAN_BITS)
    assert_eq(refmath::cos(nan).to_bits(), NAN_BITS)
    assert_eq(refmath::tan(inf).to_bits(), NAN_BITS)
    assert_eq(refmath::tan(neg_inf).to_bits(), NAN_BITS)
    assert_eq(refmath::tan(nan).to_bits(), NAN_BITS)

    // Signed zeros survive.
    assert_eq(refmath::sin(0.0).to_bits(), 0x0000000000000000)
    assert_eq(refmath::sin(-0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::tan(0.0).to_bits(), 0x0000000000000000)
    assert_eq(refmath::tan(-0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::cos(-0.0).to_bits(), F64_ONE)
}

#[test]
fn refmath_bit_exact_spot_values() {
    // Captured from the reference implementation.
    assert_eq(refmath::sin(2.0).to_bits(), 0x3fed18f6ead1b446)
    assert_eq(refmath::cos(2.5).to_bits(), 0xbfe9a2f7ef858b7d)
    assert_eq(refmath::tan(4.0).to_bits(), 0x3ff2866f9be4de14)
    assert_eq(refmath::tan(5.0).to_bits(), 0xc00b0b4b739bbb07)

    let huge = 31415926535897.9323846
    assert_eq(refmath::sin(huge).to_bits(), 0x3f53cf6e3a1ed5ab)
    assert_eq(refmath::cos(huge).to_bits(), 0x3feffffe778d8687)
    assert_eq(refmath::tan(huge).to_bits(), 0x3f53cf6f2d12c5c3)

    // A few points from the 4096-step grid centred on zero.
    let step_size = 2.0 * math::PI / 4096.0
    assert_eq(refmath::sin(0.0).to_bits(), 0x0000000000000000)
    assert_eq(refmath::cos(0.0).to_bits(), F64_ONE)
    assert_eq(refmath::tan(0.0).to_bits(), 0x0000000000000000)

    let quarter = 1024.0 * step_size
    assert_eq(refmath::sin(quarter).to_bits(), 0x3ff0000000000000)
    assert_eq(refmath::cos(quarter).to_bits(), 0x3c91a62633145c07)
    assert_eq(refmath::tan(quarter).to_bits(), 0x434d02967c31cdb5)

    let half = 2048.0 * step_size
    assert_eq(refmath::sin(half).to_bits(), 0x3ca1a62633145c07)
    assert_eq(refmath::cos(half).to_bits(), 0xbff0000000000000)
    assert_eq(refmath::tan(half).to_bits(), 0xbca1a62633145c07)

    // pi/4 has a tangent just below one.
    assert_eq(refmath::sin(math::PI / 4.0).to_bits(), 0x3fe6a09e667f3bcc)
    assert_eq(refmath::cos(math::PI / 4.0).to_bits(), 0x3fe6a09e667f3bcd)
    assert_eq(refmath::tan(math::PI / 4.0).to_bits(), 0x3fefffffffffffff)

    // 3*pi/2, 1e-8 and 1e8.
    assert_eq(refmath::sin(3.0 * math::PI / 2.0).to_bits(), 0xbff0000000000000)
    assert_eq(refmath::cos(3.0 * math::PI / 2.0).to_bits(), 0xbcaa79394c9e8a0a)
    assert_eq(refmath::tan(3.0 * math::PI / 2.0).to_bits(), 0x4333570efd768923)
    assert_eq(refmath::sin(1.0e-8).to_bits(), 0x3e45798ee2308c3a)
    assert_eq(refmath::cos(1.0e-8).to_bits(), F64_ONE)
    assert_eq(refmath::tan(1.0e-8).to_bits(), 0x3e45798ee2308c3a)
    assert_eq(refmath::sin(1.0e8).to_bits(), 0x3fedcffca623a20b)
    assert_eq(refmath::cos(1.0e8).to_bits(), 0xbfd741b388a8c029)
    assert_eq(refmath::tan(1.0e8).to_bits(), 0xc004829e83f49589)
}

#[test]
fn refmath_symmetry() {
    let xs = [
        0.3, 1.0, 2.0, 4.0, 5.0, 100.0, 1.0e8, 31415926535897.9323846, -2.5, -7.25
    ]
    for x in xs {
        // sin and tan are odd; cos is even. Compare bit patterns so signed
        // zeros are covered too.
        assert_eq(refmath::sin(-x).to_bits(), (-refmath::sin(x)).to_bits())
        assert_eq(refmath::cos(-x).to_bits(), refmath::cos(x).to_bits())
        assert_eq(refmath::tan(-x).to_bits(), (-refmath::tan(x)).to_bits())
    }
}

#[test]
fn refmath_inverse_documented_examples() {
    assert_eq(refmath::asin(0.0), 0.0)
    assert_eq(refmath::asin(1.0), 1.5707963267948966)
    assert_eq(refmath::asin(-1.0), -1.5707963267948966)
    assert_eq(refmath::asin(2.0).to_bits(), NAN_BITS)
    assert_eq(refmath::asin(-2.0).to_bits(), NAN_BITS)

    assert_eq(refmath::acos(0.0), 1.5707963267948966)
    assert_eq(refmath::acos(1.0), 0.0)
    assert_eq(refmath::acos(-1.0), 3.141592653589793)
    assert_eq(refmath::acos(2.0).to_bits(), NAN_BITS)
    assert_eq(refmath::acos(-2.0).to_bits(), NAN_BITS)

    assert_eq(refmath::atan(0.0), 0.0)
    assert_eq(refmath::atan(1.0), 0.7853981633974483)
    assert_eq(refmath::atan(-1.0), -0.7853981633974483)
    let inf = f64::from_bits(0x7ff0000000000000)
    let neg_inf = f64::from_bits(NEG_INF_BITS)
    assert_eq(refmath::atan(inf), 1.5707963267948966)
    assert_eq(refmath::atan(neg_inf), -1.5707963267948966)

    assert_eq(refmath::atan2(0.0, -1.0), 3.141592653589793)
    assert_eq(refmath::atan2(1.0, 0.0), 1.5707963267948966)
    assert_eq(refmath::atan2(1.0, 1.0), 0.7853981633974483)
    assert_eq(refmath::atan2(inf, 1.0), 1.5707963267948966)
    assert_eq(refmath::atan2(1.0, inf), 0.0)
    assert_eq(refmath::atan2(neg_inf, 1.0), -1.5707963267948966)
    assert_eq(refmath::atan2(1.0, neg_inf), 3.141592653589793)
    assert_eq(refmath::atan2(inf, inf), 0.7853981633974483)
    assert_eq(refmath::atan2(neg_inf, neg_inf), -2.356194490192345)
    assert_eq(refmath::atan2(inf, neg_inf), 2.356194490192345)
    assert_eq(refmath::atan2(neg_inf, inf), -0.7853981633974483)
}

#[test]
fn refmath_inverse_special_values() {
    let inf = f64::from_bits(0x7ff0000000000000)
    let neg_inf = f64::from_bits(NEG_INF_BITS)
    let nan0 = f64::from_bits(0x7ff8000000000000)
    let nan1 = f64::from_bits(0x7ff8000000000001)
    let neg_nan = f64::from_bits(NEG_INF_BITS | 0x0008000000000000)

    // The reference returns its canonical NaN for non-finite asin/acos and
    // any NaN atan2 argument.
    assert_eq(refmath::asin(inf).to_bits(), NAN_BITS)
    assert_eq(refmath::asin(neg_inf).to_bits(), NAN_BITS)
    assert_eq(refmath::acos(inf).to_bits(), NAN_BITS)
    assert_eq(refmath::acos(neg_inf).to_bits(), NAN_BITS)
    assert_eq(refmath::atan2(nan0, 1.0).to_bits(), NAN_BITS)
    assert_eq(refmath::atan2(1.0, nan0).to_bits(), NAN_BITS)
    assert_eq(refmath::atan2(nan1, nan1).to_bits(), NAN_BITS)

    // `atan` returns a NaN argument unchanged, payload included.
    assert_eq(refmath::atan(nan0).to_bits(), 0x7ff8000000000000)
    assert_eq(refmath::atan(nan1).to_bits(), 0x7ff8000000000001)
    assert_eq(refmath::atan(neg_nan).to_bits(), 0xfff8000000000000)

    // Signed zeros.
    assert_eq(refmath::asin(-0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::atan(-0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::atan2(-0.0, 0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::atan2(-0.0, -0.0).to_bits(), 0xc00921fb54442d18)
}

#[test]
fn refmath_inverse_bit_exact_spot_values() {
    assert_eq(refmath::asin(0.5).to_bits(), 0x3fe0c152382d7366)
    assert_eq(refmath::acos(0.5).to_bits(), 0x3ff0c152382d7366)
    assert_eq(refmath::asin(0.9999999999999999).to_bits(), 0x3ff921fb50442d18)
    assert_eq(refmath::acos(0.9999999999999999).to_bits(), 0x3e50000000000000)
    assert_eq(refmath::asin(-1.0).to_bits(), 0xbff921fb54442d18)
    assert_eq(refmath::acos(-1.0).to_bits(), 0x400921fb54442d18)

    assert_eq(refmath::atan(1.0).to_bits(), 0x3fe921fb54442d18)
    assert_eq(refmath::atan(0.6875).to_bits(), 0x3fe345f01cce37bb)
    assert_eq(refmath::atan(1.1875).to_bits(), 0x3febde70ed439fe7)
    assert_eq(refmath::atan(2.1875).to_bits(), 0x3ff245b4faf23110)
    assert_eq(refmath::atan(1.0e8).to_bits(), 0x3ff921fb5194fb3c)
    assert_eq(refmath::atan(31415926535897.9323846).to_bits(), 0x3ff921fb54442c89)

    // Quadrants, axes, and the large/small |y/x| shortcuts.
    assert_eq(refmath::atan2(0.0, -0.0).to_bits(), 0x400921fb54442d18)
    assert_eq(refmath::atan2(-0.0, 0.0).to_bits(), F64_SIGN)
    assert_eq(refmath::atan2(1.0, -1.0).to_bits(), 0x4002d97c7f3321d2)
    assert_eq(refmath::atan2(-1.0, -1.0).to_bits(), 0xc002d97c7f3321d2)
    assert_eq(refmath::atan2(2.0, 1.0).to_bits(), 0x3ff1b6e192ebbe44)
    assert_eq(refmath::atan2(1.0e300, 1.0e-300).to_bits(), 0x3ff921fb54442d18)
    assert_eq(refmath::atan2(-1.0e300, 1.0e-300).to_bits(), 0xbff921fb54442d18)
    assert_eq(refmath::atan2(1.0e-300, 1.0e300).to_bits(), 0x0000000000000000)
    assert_eq(refmath::atan2(1.0e-300, -1.0e300).to_bits(), 0x400921fb54442d18)
    assert_eq(refmath::atan2(-1.0e-300, 1.0e300).to_bits(), F64_SIGN)
    assert_eq(refmath::atan2(-1.0e-300, -1.0e300).to_bits(), 0xc00921fb54442d18)
}
