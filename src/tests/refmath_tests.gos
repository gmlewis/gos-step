//! Bit-exactness tests for the fdlibm trigonometric and inverse trigonometric
//! port.
//!
//! The decimal expectations are the documented reference examples.

use crate::cad::refmath

const NAN_BITS: u64 = 0x7ff8000000000001
const NEG_INF_BITS: u64 = 0xfff0000000000000

#[test]
fn refmath_documented_examples() {
    assert_eq(refmath::sin(0.0), 0.0)
    assert_eq(refmath::sin(2.0), 0.9092974268256817)
    assert_eq(refmath::sin(-5.0), 0.9589242746631385)
    assert_eq(refmath::cos(2.5), -0.8011436155469337)
    assert_eq(refmath::cos(-5.0), 0.28366218546322625)
    assert_eq(refmath::tan(4.0), 1.1578212823495777)
    assert_eq(refmath::tan(5.0), -3.380515006246586)

    // Huge arguments: the reduction must stay exact.
    let huge = 31415926535897.9323846
    assert_eq(refmath::sin(huge), 0.0012091232715481885)
    assert_eq(refmath::cos(huge), 0.9999992690101899)
    assert_eq(refmath::tan(huge), 0.0012091241554056254)
}

#[test]
fn refmath_inverse_documented_examples() {
    assert_eq(refmath::asin(0.0), 0.0)
    assert_eq(refmath::asin(1.0), 1.5707963267948966)
    assert_eq(refmath::asin(-1.0), -1.5707963267948966)
    assert_eq(refmath::asin(2.0).to_bits(), NAN_BITS)
    assert_eq(refmath::asin(-2.0).to_bits(), NAN_BITS)

    assert_eq(refmath::acos(0.0), 1.5707963267948966)
    assert_eq(refmath::acos(1.0), 0.0)
    assert_eq(refmath::acos(-1.0), 3.141592653589793)
    assert_eq(refmath::acos(2.0).to_bits(), NAN_BITS)
    assert_eq(refmath::acos(-2.0).to_bits(), NAN_BITS)

    assert_eq(refmath::atan(0.0), 0.0)
    assert_eq(refmath::atan(1.0), 0.7853981633974483)
    assert_eq(refmath::atan(-1.0), -0.7853981633974483)
    let inf = f64::from_bits(0x7ff0000000000000)
    let neg_inf = f64::from_bits(NEG_INF_BITS)
    assert_eq(refmath::atan(inf), 1.5707963267948966)
    assert_eq(refmath::atan(neg_inf), -1.5707963267948966)

    assert_eq(refmath::atan2(0.0, -1.0), 3.141592653589793)
    assert_eq(refmath::atan2(1.0, 0.0), 1.5707963267948966)
    assert_eq(refmath::atan2(1.0, 1.0), 0.7853981633974483)
    assert_eq(refmath::atan2(inf, 1.0), 1.5707963267948966)
    assert_eq(refmath::atan2(1.0, inf), 0.0)
    assert_eq(refmath::atan2(neg_inf, 1.0), -1.5707963267948966)
    assert_eq(refmath::atan2(1.0, neg_inf), 3.141592653589793)
    assert_eq(refmath::atan2(inf, inf), 0.7853981633974483)
    assert_eq(refmath::atan2(neg_inf, neg_inf), -2.356194490192345)
    assert_eq(refmath::atan2(inf, neg_inf), 2.356194490192345)
    assert_eq(refmath::atan2(neg_inf, inf), -0.7853981633974483)
}
