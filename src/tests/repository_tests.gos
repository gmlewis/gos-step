//! Repository behavior tests.

use crate::entities::geometry::Direction
use crate::header::{FileDescription, HeaderEntity, HeaderSection}
use crate::repository::{Repository, any_entity_direction}

fn direction(x: f64) -> crate::repository::AnyEntity {
    any_entity_direction(Direction::new("", #[x, 0.0, 0.0]))
}

#[test]
fn full_file_wraps_header_and_data() {
    let mut repo = Repository::new()
    repo = repo.set_header(HeaderSection::new(#[
        HeaderEntity::FileDescription(FileDescription::new(#[""], "2;1"))
    ]))
    let repo, _ = repo.add(direction(1.0))
    assert_eq(
        repo.to_step_file()
        "ISO-10303-21;\nHEADER;\nFILE_DESCRIPTION((''),'2;1');\nENDSEC;\nDATA;\n#1=DIRECTION('',(1.0,0.0,0.0));\nENDSEC;\nEND-ISO-10303-21;"
    )
}
