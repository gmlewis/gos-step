//! Tokenizer tests.

use crate::error::ParseErrorInfo
use crate::parse::tokenize::{
    split_statements, split_statements_with_pos, tokenize_step_data_section
}

fn error_of<T>(r: Result<T, ParseErrorInfo>) -> ParseErrorInfo {
    match r {
        Ok(_) => panic("expected an error")
        Err(e) => e
    }
}

#[test]
fn tokenize_complex_instance_row() {
    let data = "#187=(\nGEOMETRIC_REPRESENTATION_CONTEXT(3)\nREPRESENTATION_CONTEXT('cube','TOP_LEVEL_ASSEMBLY_PART')\n);"
    let rows = tokenize_step_data_section(data).unwrap()
    assert_eq(rows.len(), 1)
    assert_eq(rows[0].id.value, 187)
    assert_eq(rows[0].name, "__COMPLEX__")
    // Args keep the leading '(' so downstream can round-trip.
    assert(rows[0].args.starts_with("("))
    assert(rows[0].args.starts_with("(\nGEOMETRIC_REPRESENTATION_CONTEXT(3)"))
}

#[test]
fn split_statements_keeps_semicolons_in_strings() {
    let data = "#1=FOO('X;Y'); #2=BAR('Z');"
    let stmts = split_statements(data)
    assert_eq(stmts.len(), 2)
    assert(stmts[0].contains("'X;Y'"))
    assert(stmts[1].contains("#2=BAR('Z')"))
}

#[test]
fn split_statements_with_pos_reports_unterminated_string_at_quote() {
    let data = "#1=FOO('unterminated\n#2=BAR(1);"
    let result = split_statements_with_pos(data)
    assert(result.is_err())
    let info = error_of(result)
    assert(info.message.contains("unterminated"))
    assert(info.message.contains("string"))
    // The opening quote in "#1=FOO('unterminated" is at column 8.
    assert_eq(info.line, Some(1))
    assert_eq(info.col, Some(8))
    assert(info.stmt.unwrap().contains("#1=FOO('unterminated"))
}
