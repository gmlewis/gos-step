//! Fixture round-trip and corpus stability tests.

use crate::parse::entry::{parse_repository_from_file, parse_repository_from_string}

#[test]
fn fixtures_corpus_roundtrip_is_stable() {
    let fixtures = #[
        "testdata/ap242-min.step"
        "testdata/ap242-stress.step"
        "testdata/ap242-comments.step"
        "testdata/ap242-strings.step"
        "testdata/simple-box.step"
        "testdata/kicadoutput01.step"
    ]
    for path in fixtures {
        let repo1 = parse_repository_from_file(path).unwrap()
        let out1 = repo1.to_step_file()
        let repo2 = parse_repository_from_string(out1).unwrap()
        let out2 = repo2.to_step_file()
        assert_eq(out1, out2)
    }
}

#[test]
fn can_parse_kicadoutput01_from_file() {
    let repo =
        parse_repository_from_file("testdata/kicadoutput01.step").unwrap()
    let data = repo.to_step_data_section()
    assert(repo.len() > 0)
    assert(data.contains("TOROIDAL_SURFACE"))
    assert(data.contains("CONTEXT_DEPENDENT_SHAPE_REPRESENTATION"))
    assert(data.contains("#97=TOROIDAL_SURFACE('',#98,0.4,0.4);"))
    assert(data.contains("#433=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#434,#436);"))
    assert(data.contains("#435=ITEM_DEFINED_TRANSFORMATION('','',#11,#15);"))
    assert(data.contains("#437=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','R2',$,#5,#35,$);"))
}
