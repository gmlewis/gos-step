#[test]
fn product_certification_to_step() {
    let kind = Ref { id: EntityId { value: 10 } }
    let c = product::Certification::new("name", "purpose", kind)
    let s = c.to_step()
    assert_eq(s, "CERTIFICATION('name','purpose',#10)")
