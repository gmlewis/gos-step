#[test]
fn product_item_defined_transformation_to_step() {
    let i1 = Ref { id: EntityId { value: 11 } }
    let i2 = Ref { id: EntityId { value: 15 } }
    let entity = product::ItemDefinedTransformation::new("", "", i1, i2)
    assert_eq(entity.to_step(), "ITEM_DEFINED_TRANSFORMATION('','',#11,#15)")
}

#[test]
fn product_measure_representation_item_to_step() {
    let unit = Ref { id: EntityId { value: 589 } }
    let entity = product::MeasureRepresentationItem::new(
        "density measure"
        product::MeasureValueComponent::PositiveRatioMeasure(
            units::PositiveRatioMeasure::new("7850.")
        )
        unit
    )
    assert_eq(entity.to_step(), "MEASURE_REPRESENTATION_ITEM('density measure',POSITIVE_RATIO_MEASURE(7850.),#589)")
}

#[test]
fn product_next_assembly_usage_occurrence_to_step() {
    let relating = Ref { id: EntityId { value: 5 } }
    let related = Ref { id: EntityId { value: 35 } }
    let entity = product::NextAssemblyUsageOccurrence::new(
        "1", "R2", "$", relating, related, "$"
    )
    assert_eq(entity.to_step(), "NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','R2',$,#5,#35,$)")
}

#[test]
fn product_person_to_step() {
    let p = product::Person::new("p1", "Doe", "John", #["M"], #["Mr"], #["Jr"])
    let s = p.to_step()
    assert_eq(s, "PERSON('p1','Doe','John',('M'),('Mr'),('Jr'))")
}

