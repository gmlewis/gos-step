#[test]
fn product_context_dependent_shape_representation_to_step() {
    let rr = Ref { id: EntityId { value: 434 } }
    let rpr = Ref { id: EntityId { value: 436 } }
    let entity = product::ContextDependentShapeRepresentation::new(rr, rpr)
    assert_eq(entity.to_step(), "CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#434,#436)")
}

#[test]
fn product_coordinateduniversaltimeoffset_to_step() {
    let c = product::CoordinatedUniversalTimeOffset::new(8, 0, ".AHEAD.")
    assert_eq(c.to_step(), "COORDINATED_UNIVERSAL_TIME_OFFSET(8,0,.AHEAD.)")
}

#[test]
fn product_calendardate_to_step() {
    let c = product::CalendarDate::new(2025, 22, 12)
