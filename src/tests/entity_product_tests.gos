fn product_descriptive_representation_item_to_step() {
    let entity = product::DescriptiveRepresentationItem::new("Steel", "Steel")
    assert_eq(entity.to_step(), "DESCRIPTIVE_REPRESENTATION_ITEM('Steel','Steel')")
}

