}

#[test]
fn product_localtime_to_step() {
    let zone = Ref { id: EntityId { value: 10 } }
    let l = product::LocalTime::new(12, 30, 0.0, zone)
    assert_eq(l.to_step(), "LOCAL_TIME(12,30,0.0,#10)")
}

#[test]
fn product_dateandtime_to_step() {
    let d = Ref { id: EntityId { value: 10 } }
    let t = Ref { id: EntityId { value: 20 } }
    let dt = product::DateAndTime::new(d, t)
    assert_eq(dt.to_step(), "DATE_AND_TIME(#10,#20)")
}

