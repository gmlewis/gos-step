//! Entity serialization tests: product family.

use crate::ids::{EntityId, Ref}
use crate::entities::product
use crate::entities::units

#[test]
fn product_advancedbrepshaperepresentation_to_step() {
    let e = product::AdvancedBrepShapeRepresentation::new(
        "cube-None"
        #[Ref { id: EntityId { value: 32 } }]
        Ref { id: EntityId { value: 187 } }
    )
    assert_eq(e.to_step(), "ADVANCED_BREP_SHAPE_REPRESENTATION('cube-None',(#32),#187)")
}

#[test]
fn product_applicationcontext_to_step() {
    let e = product::ApplicationContext::new(
        "core data for automotive mechanical design processes"
    )
    assert_eq(e.to_step(), "APPLICATION_CONTEXT('core data for automotive mechanical design processes')")
}

#[test]
fn product_applicationprotocoldefinition_to_step() {
    let e = product::ApplicationProtocolDefinition::new(
        "international standard"
        "automotive_design"
        2010
        Ref { id: EntityId { value: 21 } }
    )
    assert_eq(e.to_step(), "APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#21)")
}

#[test]
fn product_approvalstatus_to_step() {
    let status = product::ApprovalStatus::new("approved")
    let s = status.to_step()
    assert_eq(s, "APPROVAL_STATUS('approved')")
}

#[test]
fn product_approval_to_step() {
    let status = Ref { id: EntityId { value: 10 } }
    let approval = product::Approval::new(status, "level")
    let s = approval.to_step()
    assert_eq(s, "APPROVAL(#10,'level')")
}

