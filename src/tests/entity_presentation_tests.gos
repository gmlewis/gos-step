    assert_eq(s.to_step(), "SURFACE_SIDE_STYLE('',(#28))")
}

#[test]
fn presentation_surface_style_usage_to_step() {
    let s = presentation::SurfaceStyleUsage::new(".BOTH.", Ref { id: EntityId { value: 27 } })
    assert_eq(s.to_step(), "SURFACE_STYLE_USAGE(.BOTH.,#27)")
}

#[test]
fn presentation_presentation_style_assignment_to_step() {
    let p = presentation::PresentationStyleAssignment::new(#[
        Ref { id: EntityId { value: 26 } }
    ])
    assert_eq(p.to_step(), "PRESENTATION_STYLE_ASSIGNMENT((#26))")
}

#[test]
fn presentation_styled_item_to_step() {
    let s = presentation::StyledItem::new(
        ""
        #[Ref { id: EntityId { value: 25 } }]
        Ref { id: EntityId { value: 32 } }
    )
    assert_eq(s.to_step(), "STYLED_ITEM('',(#25),#32)")
}

#[test]
fn presentation_over_riding_styled_item_to_step() {
    let s = presentation::OverRidingStyledItem::new(
        ""
        #[Ref { id: EntityId { value: 25 } }]
        Ref { id: EntityId { value: 32 } }
        Ref { id: EntityId { value: 33 } }
    )
    assert_eq(s.to_step(), "OVER_RIDING_STYLED_ITEM('',(#25),#32,#33)")
}

#[test]
fn presentation_hidden_element_over_riding_styled_item_to_step() {
    let s = presentation::HiddenElementOverRidingStyledItem::new(
        ""
        #[Ref { id: EntityId { value: 25 } }]
        Ref { id: EntityId { value: 32 } }
        Ref { id: EntityId { value: 33 } }
    )
    assert_eq(s.to_step(), "HIDDEN_ELEMENT_OVER_RIDING_STYLED_ITEM('',(#25),#32,#33)")
}

#[test]
fn presentation_annotation_occurrence_to_step() {
    let s = presentation::AnnotationOccurrence::new(
        ""
        #[Ref { id: EntityId { value: 25 } }]
        Ref { id: EntityId { value: 32 } }
    )
    assert_eq(s.to_step(), "ANNOTATION_OCCURRENCE('',(#25),#32)")
}

#[test]
fn presentation_presentation_layer_assignment_to_step() {
    let p = presentation::PresentationLayerAssignment::new("1", "Layer 1", #[
        Ref { id: EntityId { value: 32 } }
    ])
    assert_eq(p.to_step(), "PRESENTATION_LAYER_ASSIGNMENT('1','Layer 1',(#32))")
}

#[test]
fn presentation_md_geom_presrep_to_step() {
    let r = presentation::MechanicalDesignGeometricPresentationRepresentation::new(
        ""
        #[Ref { id: EntityId { value: 24 } }]
        Ref { id: EntityId { value: 187 } }
    )
    assert_eq(r.to_step(), "MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#24),#187)")
}

#[test]
fn presentation_textliteral_to_step() {
    let placement = Ref { id: EntityId { value: 10 } }
    let font = Ref { id: EntityId { value: 20 } }
    let tl = presentation::TextLiteral::new(
        "name"
        "literal"
        placement
        "alignment"
        presentation::TextPath::Right
        font
    )
    let s = tl.to_step()
    assert_eq(s, "TEXT_LITERAL('name','literal',#10,'alignment',.RIGHT.,#20)")
}

#[test]
fn presentation_textpath_to_step() {
    assert_eq(presentation::text_path_to_step(presentation::TextPath::Left), ".LEFT.")
    assert_eq(presentation::text_path_to_step(presentation::TextPath::Right), ".RIGHT.")
    assert_eq(presentation::text_path_to_step(presentation::TextPath::Up), ".UP.")
    assert_eq(presentation::text_path_to_step(presentation::TextPath::Down), ".DOWN.")
}
