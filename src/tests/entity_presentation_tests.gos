//! Entity serialization tests: presentation family.


use crate::ids::{EntityId, Ref}
use crate::entities::presentation

#[test]
fn presentation_color_rgb_to_step() {
    let c = presentation::ColorRgb::new("Orange", 1.0, 0.6, 0.0)
    assert_eq(c.to_step(), "COLOUR_RGB('Orange',1.0,0.6,0.0)")
}

#[test]
fn presentation_draughting_pre_defined_color_to_step() {
    let c = presentation::DraughtingPreDefinedColour::new("red")
    assert_eq(c.to_step(), "DRAUGHTING_PRE_DEFINED_COLOUR('red')")
}

#[test]
fn presentation_fill_area_style_color_to_step() {
    let c = presentation::FillAreaStyleColor::new("", Ref { id: EntityId { value: 31 } })
    assert_eq(c.to_step(), "FILL_AREA_STYLE_COLOUR('',#31)")
}

#[test]
fn presentation_fill_area_style_to_step() {
    let s = presentation::FillAreaStyle::new("", #[
        Ref { id: EntityId { value: 30 } }
    ])
    assert_eq(s.to_step(), "FILL_AREA_STYLE('',(#30))")
}

#[test]
fn presentation_surface_style_fill_area_to_step() {
    let s = presentation::SurfaceStyleFillArea::new(Ref { id: EntityId { value: 29 } })
    assert_eq(s.to_step(), "SURFACE_STYLE_FILL_AREA(#29)")
}

#[test]
fn presentation_surface_side_style_to_step() {
    let s = presentation::SurfaceSideStyle::new("", #[
