pub type ParseErrorInfo = crate::error::ParseErrorInfo
pub type LoaderError = crate::error::LoaderError
pub type EntityId = crate::ids::EntityId
pub type Ref = crate::ids::Ref

pub type Repository = crate::repository::Repository
pub type AnyEntity = crate::repository::AnyEntity

pub type RawEntityRow = crate::parse::tokenize::RawEntityRow
pub type StatementSpan = crate::parse::tokenize::StatementSpan

// ---------------------------------------------------------------------------
// CAD facade
// ---------------------------------------------------------------------------

pub type Design = crate::cad::design::Design
pub type Shape = crate::cad::types::Shape
pub type SceneNode = crate::cad::types::SceneNode
pub type Rgb = crate::cad::types::Rgb
pub type Face = crate::cad::types::Face
pub type Profile = crate::cad::types::Profile2D
pub type BezierPath = crate::cad::types::BezierPath
pub type BezierAnchor = crate::cad::types::BezierAnchor
pub type SweepPath = crate::cad::types::SweepPath
pub type SweepProfile = crate::cad::types::SweepProfile
pub type V2 = crate::cad::geometry::Vec2
pub type V3 = crate::cad::geometry::Vec3
pub type Bounds = crate::cad::types::Bounds

pub const ORANGE: Rgb = Rgb { r: 1.0, g: 0.6, b: 0.0 }
pub const BLUE: Rgb = Rgb { r: 0.2, g: 0.6, b: 1.0 }
pub const GREY: Rgb = Rgb { r: 0.2, g: 0.2, b: 0.2 }
pub const PURPLE: Rgb = Rgb { r: 0.5, g: 0.0, b: 0.5 }
pub const MAGENTA: Rgb = Rgb { r: 1.0, g: 0.0, b: 1.0 }
pub const WHITE: Rgb = Rgb { r: 1.0, g: 1.0, b: 1.0 }
pub const BLACK: Rgb = Rgb { r: 0.0, g: 0.0, b: 0.0 }
pub const GREEN: Rgb = Rgb { r: 0.0, g: 0.8, b: 0.0 }
pub const RED: Rgb = Rgb { r: 0.8, g: 0.0, b: 0.0 }
pub const CYAN: Rgb = Rgb { r: 0.0, g: 0.8, b: 0.8 }

/// Create a new design.
pub fn design(
    name: String = "model"
    description: String = "generated by gmlewis/step/cad"
    documentation: String = ""
) -> Design {
    crate::cad::design::Design::new(name, description, documentation)
}

/// A rectangular block.
pub fn cuboid(sx: f64, sy: f64, sz: f64) -> Shape {
    crate::cad::types::Cuboid::new(sx, sy, sz)
}

/// A chamfered (or filleted) block.
pub fn chamfer_block(
    length: f64
    width: f64
    height: f64
    chamfer: f64 = 1.0
    fillet_radius: f64 = 0.0
    fillet_segments: i64 = 8
) -> Shape {
    crate::cad::types::CalibrationChamferBlock::new(
        length
        width
        height
        chamfer
        fillet_radius
        fillet_segments
    )
}

/// An extruded 2D profile.
pub fn extrude(profile: Profile, height: f64) -> Shape {
    crate::cad::types::ExtrudedProfile::new(profile.outer, height, profile.holes)
}

/// An extruded Bezier profile.
pub fn extrude_bezier(paths: Vec<BezierPath>, height: f64) -> Shape {
    crate::cad::types::ExtrudedBezierProfile::new(paths, height)
}

/// A swept profile.
pub fn sweep(
    path: SweepPath
    profile: SweepProfile
    start_cap: bool = true
    end_cap: bool = true
    straight_holes: bool = false
    straight_outline: bool = true
) -> Shape {
    crate::cad::types::SweptProfile::new(
        path
        profile
        start_cap
        end_cap
        straight_holes
        straight_outline
    )
}

/// A tube (or solid cylinder when `inner_diameter <= 0`).
pub fn tube(outer_diameter: f64, inner_diameter: f64, height: f64, segments: i64 = 64) -> Shape {
    crate::cad::builders::tube(outer_diameter, inner_diameter, height, segments)
}

// ---- profile builders ----
pub fn rect(width: f64, height: f64) -> Vec<V2> {
    crate::cad::types::Profile2D::rect(width, height)
}

pub fn centered_rect(width: f64, height: f64) -> Vec<V2> {
    crate::cad::types::Profile2D::centered_rect(width, height)
}

pub fn rounded_rect(width: f64, height: f64, radius: f64, segments: i64 = 32) -> Vec<V2> {
    crate::cad::types::Profile2D::rounded_rect(width, height, radius, segments)
}

pub fn polygon(sides: i64, diameter: f64, rotation: f64 = 0.0) -> Vec<V2> {
    crate::cad::types::Profile2D::polygon(sides, diameter, rotation)
}

pub fn circle(diameter: f64, segments: i64 = 64) -> Vec<V2> {
    crate::cad::types::Profile2D::circle(diameter, segments)
}

pub fn ellipse(width: f64, height: f64, segments: i64 = 64) -> Vec<V2> {
    crate::cad::types::Profile2D::ellipse(width, height, segments)
}

pub fn arc(diameter: f64, start_angle: f64, end_angle: f64, segments: i64 = 32) -> Vec<V2> {
    crate::cad::types::Profile2D::arc(diameter, start_angle, end_angle, segments)
}

pub fn profile(outer: Vec<V2>) -> Profile {
    crate::cad::types::Profile2D::new(outer)
}

// ---- composition ----
pub fn union_all(nodes: Vec<SceneNode>, name: String = "union") -> SceneNode {
    crate::cad::builders::union_all(nodes, name)
}

pub fn difference(base: SceneNode, cutters: Vec<SceneNode>, name: String = "difference") -> SceneNode {
    crate::cad::builders::difference(base, cutters, name)
}

// ---- pipeline terminals ----
pub fn compile(design: Design) -> Repository {
    design.compile()
}

pub fn to_step_text(design: Design) -> String {
    design.to_step_file()
}

pub fn repository_to_text(repo: Repository) -> String {
    repo.to_step_file()
}

pub fn write_step(design: Design, path: Option<String>) -> Result<(), Error> {
    design.write_step_file(path)
}

pub fn write_step_stdout(design: Design) -> Result<(), Error> {
    design.write_step_file(None)
}

// ---- parsing facade ----
pub fn parse_step(text: String) -> Result<Repository, Error> {
    match crate::parse::entry::parse_repository_from_string(text) {
        Ok(r) => Ok(r)
        Err(info) => Err(Error::Parse(info))
    }
}

pub fn read_step(path: String) -> Result<Repository, Error> {
    crate::parse::entry::parse_repository_from_file(path)
}

// ---------------------------------------------------------------------------
// Text facade
// ---------------------------------------------------------------------------

pub type Font = crate::font::model::Font

/// Load a font by short name (e.g. `"baloo"`).
pub fn font(name: String) -> Result<Font, Error> {
    match crate::font::load::load_font(name) {
        Ok(f) => Ok(f)
        Err(e) => Err(Error::Loader(e))
    }
}

/// Render text into scene nodes.
pub fn text_nodes(
    text: String
    font: Font
    size: f64 = 5.0
    max_width: f64 = 1000.0
    emboss_depth: f64 = 0.5
    rx: f64 = 0.0
    ry: f64 = 0.0
    rz: f64 = 0.0
    segments: i64 = 0
) -> Vec<SceneNode> {
    crate::cad::text::text_at(
        text
        0.0
        0.0
        0.0
        font
        size
        max_width
        emboss_depth
        rx
        ry
        rz
        segments
    )
}

// ---------------------------------------------------------------------------
// CLI facade
// ---------------------------------------------------------------------------

pub type Arg = crate::cli::spec::Arg
pub type ArgKind = crate::cli::spec::ArgKind
pub type Cli = crate::cli::spec::Cli
pub type Args = crate::cli::parse::Args
pub type CliError = crate::cli::parse::CliError
pub type Number = crate::cli::parse::Number
pub const NO_SHORT: char = '\0'

pub fn opt_int(default: i64, short: char = '\0', help: String = "", min: Option<i64> = None, max: Option<i64> = None) -> Arg {
    crate::cli::spec::opt_int(default, short, help, min, max)
}

pub fn opt_double(default: f64, short: char = '\0', help: String = "", min: Option<f64> = None, max: Option<f64> = None, min_exclusive: bool = false, max_exclusive: bool = false) -> Arg {
    crate::cli::spec::opt_double(default, short, help, min, max, min_exclusive, max_exclusive)
}

pub fn opt_string(short: char = '\0', help: String = "") -> Arg {
    crate::cli::spec::opt_string(short, help)
}

pub fn flag(short: char = '\0', help: String = "") -> Arg {
    crate::cli::spec::flag(short, help)
}

pub fn with_translate(spec: Map<String, Arg>) -> Map<String, Arg> {
    crate::cli::spec::with_translate(spec)
}

pub fn parse_args(
    spec: Map<String, Arg>
    prog: String
    description: String = ""
    cli_args: Vec<String> = #[]
) -> Result<Args, CliError> {
    crate::cli::parse::parse(spec, prog, description, cli_args, false)
}

/// Print a CLI error and answer the process exit status.
pub fn cli_report(err: CliError) -> i32 {
    crate::cli::parse::report(err)
}

/// Render a CLI spec's help text.
pub fn cli_help(spec: Map<String, Arg>, prog: String, description: String = "") -> String {
    let mut order = #[]
    for (k, _v) in spec {
        order.push(k)
    }
    order.sort()
    crate::cli::help::render_help(prog, description, order, spec)
}

/// Parse a `Cli` builder specification.
pub fn parse_cli(cli: Cli, cli_args: Vec<String> = #[]) -> Result<Args, CliError> {
    crate::cli::parse::parse_cli(cli, cli_args, false)
}

// ---------------------------------------------------------------------------
// Geometry / font conveniences used by the examples
// ---------------------------------------------------------------------------

pub type Vec3 = crate::cad::geometry::Vec3

/// Translate a 2D loop.
pub fn translate_pts(pts: Vec<V2>, x: f64, y: f64) -> Vec<V2> {
    let mut out = #[]
    for p in pts {
        out.push((p.0 + x, p.1 + y))
    }
    out
}

/// Generate a helix path for sweeping.
pub fn helix_path(
    pos: V3 = (0.0, 0.0, 0.0)
    size_per_turn: V3 = (1.0, 1.0, 1.0)
    num_turns: f64 = 1.0
    num_segs_per_turn: i64 = 36
    start_angle: f64 = 0.0
    clockwise: bool = true
) -> SweepPath {
    crate::cad::helix::helix_path(
        pos
        size_per_turn
        num_turns
        num_segs_per_turn
        start_angle
        clockwise
    )
}

/// Compatibility name for `font`.
pub fn load_font(name: String) -> Result<Font, Error> {
    font(name)
}

/// Render text at a position, preserving Bezier curves.
pub fn text_at_bezier(
    text: String
    x: f64
    y: f64
    z: f64
    font: Font
    size: f64 = 5.0
    max_width: f64 = 1000.0
    emboss_depth: f64 = 0.5
    rx: f64 = 0.0
    ry: f64 = 0.0
    rz: f64 = 0.0
) -> Vec<SceneNode> {
    crate::cad::text::text_at_bezier(
        text, x, y, z, font, size, max_width, emboss_depth, rx, ry, rz
    )
}

/// Render text at a position, optionally as polylines.
pub fn text_at(
    text: String
    x: f64
    y: f64
    z: f64
    font: Font
    size: f64 = 5.0
    max_width: f64 = 1000.0
    emboss_depth: f64 = 0.5
    rx: f64 = 0.0
    ry: f64 = 0.0
    rz: f64 = 0.0
    segments: i64 = 0
) -> Vec<SceneNode> {
    crate::cad::text::text_at(
        text, x, y, z, font, size, max_width, emboss_depth, rx, ry, rz, segments
    )
}

/// Construct an RGB colour.
pub fn rgb(r: f64, g: f64, b: f64) -> Rgb {
    Rgb { r: r, g: g, b: b }
}

/// Construct a sweep profile.
pub fn sweep_profile(
    vertices: Vec<V3>
    center: V3 = (0.0, 0.0, 0.0)
    holes: Vec<Vec<V3>> = #[]
    normal_dir: V3 = (0.0, 1.0, 0.0)
    right_dir: V3 = (1.0, 0.0, 0.0)
) -> SweepProfile {
    SweepProfile {
        center: center
        vertices: vertices
        holes: holes
        normal_dir: normal_dir
        right_dir: right_dir
    }
}


/// Format a double with the reference implementation's plain/scientific rules.
pub fn ref_to_string(n: f64) -> String {
    crate::fmt::ref_to_string(n)
}

/// Rotate a 3D point by X, then Y, then Z degrees.
pub fn rotate_point(p: V3, rx: f64, ry: f64, rz: f64) -> V3 {
    crate::cad::geometry::rotate_point(p, rx, ry, rz)
}

// ---------------------------------------------------------------------------
// Bit-exact trigonometry
// ---------------------------------------------------------------------------

/// Sine in radians, bit-identical to the reference implementation.
pub fn sin(x: f64) -> f64 {
    crate::cad::refmath::sin(x)
}

/// Cosine in radians, bit-identical to the reference implementation.
pub fn cos(x: f64) -> f64 {
    crate::cad::refmath::cos(x)
}

/// Tangent in radians, bit-identical to the reference implementation.
pub fn tan(x: f64) -> f64 {
    crate::cad::refmath::tan(x)
}

/// Arcsine in radians, bit-identical to the reference implementation.
pub fn asin(x: f64) -> f64 {
    crate::cad::refmath::asin(x)
}

/// Arccosine in radians, bit-identical to the reference implementation.
pub fn acos(x: f64) -> f64 {
    crate::cad::refmath::acos(x)
}

/// Arctangent in radians, bit-identical to the reference implementation.
pub fn atan(x: f64) -> f64 {
    crate::cad::refmath::atan(x)
}

/// Four-quadrant arctangent of `y / x`, bit-identical to the reference
/// implementation.
pub fn atan2(y: f64, x: f64) -> f64 {
    crate::cad::refmath::atan2(y, x)
}
