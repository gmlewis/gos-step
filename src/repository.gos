struct Entry {
    id: crate::ids::EntityId
    entity: AnyEntity
}

pub struct Repository {
    pub entities: Vec<Entry>
    pub order: Vec<crate::ids::EntityId>
    pub header: crate::header::HeaderSection
    pub next_id: i64
}

impl Repository {
    pub fn new() -> Repository {
        Repository { entities: #[], order: #[], header: crate::header::HeaderSection::empty(), next_id: 1 }
    }
}

impl Repository {
    pub fn get_header(self) -> crate::header::HeaderSection {
        self.header
    }
}

impl Repository {
    pub fn set_header(self, header: crate::header::HeaderSection,) -> Repository {
        let mut repo = self
        repo.header = header
        repo
    }
}

impl Repository {
    pub fn len(self) -> i64 {
        self.order.len()
    }
}

impl Repository {
    pub fn get(self, id: crate::ids::EntityId) -> Option<AnyEntity> {
        for entry in self.entities {
            if entry.id.value == id.value {
                return Some(entry.entity)
            }
        }
        None
    }
}

impl Repository {
    pub fn add(self, entity: AnyEntity,) -> (Repository, crate::ids::EntityId) {
        let mut repo = self
        let id = crate::ids::EntityId { value: repo.next_id }
        repo.next_id = repo.next_id + 1
        repo.entities.push(Entry { id: id, entity: entity })
        repo.order.push(id)
        (repo, id)
    }
}

impl Repository {
    pub fn insert_with_id(self, id: crate::ids::EntityId, entity: AnyEntity,) -> Repository {
        let mut repo = self
        repo.entities.push(Entry { id: id, entity: entity })
        repo.order.push(id)
        if id.value >= repo.next_id {
            repo.next_id = id.value + 1
        }
        repo
    }
}

impl Entity for AnyEntity {
    fn to_step(self) -> String {
        entity_to_step(self)
    }
}

pub fn entity_to_step(entity: AnyEntity) -> String {
    match entity {
        AnyEntity::RawEntity(e) => e.to_step()
        AnyEntity::CartesianPoint(p) => p.to_step()
