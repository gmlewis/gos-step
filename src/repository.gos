// Minimal serializer for now (DATA section only).
impl Repository {
    pub fn to_step_data_section(self) -> String {
        let mut lines: Vec<String> = #[]
        for entry in self.entities {
            lines.push(f"#{entry.id.value}={entity_to_step(entry.entity)};")
        }
        lines.join("\n")
    }
}

// Serialize a full ISO-10303-21 STEP file.
//
// - Always emits ISO-10303-21 wrapper lines.
// - Emits HEADER section using the repository's stored header.
// - Emits DATA section from the repository entities.
impl Repository {
    pub fn to_step_file(self) -> String {
        let header_section = self.header.to_step_header_section()
        let data_section = self.to_step_data_section()
        let out = if data_section.len() == 0 {
            f"ISO-10303-21;\n{header_section}\nDATA;\nENDSEC;\nEND-ISO-10303-21;"
        } else {
            f"ISO-10303-21;\n{header_section}\nDATA;\n{data_section}\nENDSEC;\nEND-ISO-10303-21;"
        }
        // Normalize Windows CRLF (or stray CR) so output is stable/idempotent.
        out.replace("\r", "")
    }
}

impl Repository {
    /// Append an entity in place, answering its new ID.
    ///
    /// This is the O(1) path used by the parser and `StepContext`; the
    /// functional `add` remains for API compatibility.
    pub fn add_mut(&mut self, entity: AnyEntity) -> EntityId {
        let id = EntityId { value: self.next_id }
        self.next_id = self.next_id + 1
        self.entities.push(Entry { id: id, entity: entity })
        self.order.push(id)
        id
    }

    /// Insert an entity with a caller-supplied ID, in place.
    pub fn insert_with_id_mut(&mut self, id: EntityId, entity: AnyEntity) -> () {
        self.entities.push(Entry { id: id, entity: entity })
        self.order.push(id)
        if id.value >= self.next_id {
            self.next_id = id.value + 1
        }
    }

    /// Replace the header in place.
    pub fn set_header_mut(&mut self, header: crate::header::HeaderSection) -> () {
        self.header = header
    }
}
