        AnyEntity::Axis1Placement(a) => a.to_step()
        AnyEntity::Axis2Placement2D(a) => a.to_step()
        AnyEntity::Axis2Placement3D(a) => a.to_step()
        AnyEntity::Plane(p) => p.to_step()
        AnyEntity::Vector(v) => v.to_step()
