        AnyEntity::Subface(f) => f.to_step()
        AnyEntity::ShapeAspect(s) => s.to_step()
        AnyEntity::FaceOuterBound(b) => b.to_step()
        AnyEntity::FaceBound(b) => b.to_step()
        AnyEntity::EdgeLoop(e) => e.to_step()
        AnyEntity::OrientedEdge(e) => e.to_step()
        AnyEntity::EdgeCurve(e) => e.to_step()
        AnyEntity::VertexPoint(e) => e.to_step()
        AnyEntity::ColorRgb(c) => c.to_step()
        AnyEntity::DraughtingPreDefinedColour(c) => c.to_step()
        AnyEntity::FillAreaStyleColor(c) => c.to_step()
        AnyEntity::FillAreaStyle(s) => s.to_step()
        AnyEntity::SurfaceStyleFillArea(s) => s.to_step()
        AnyEntity::SurfaceSideStyle(s) => s.to_step()
        AnyEntity::SurfaceStyleUsage(s) => s.to_step()
        AnyEntity::PresentationStyleAssignment(p) => p.to_step()
        AnyEntity::PresentationLayerAssignment(p) => p.to_step()
        AnyEntity::MechanicalDesignGeometricPresentationRepresentation(r) =>
            r.to_step()
        AnyEntity::StyledItem(s) => s.to_step()
        AnyEntity::OverRidingStyledItem(s) => s.to_step()
