        AnyEntity::MeasureWithUnit(m) => m.to_step()
        AnyEntity::DerivedUnitElement(d) => d.to_step()
        AnyEntity::DerivedUnit(d) => d.to_step()
        AnyEntity::CtxWrap(c) => c.to_step()
        AnyEntity::ComplexInstance(c) => c.to_step()
    }
