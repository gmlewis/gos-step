        AnyEntity::GeometricTolerance(g) => g.to_step()
        AnyEntity::Datum(d) => d.to_step()
        AnyEntity::DatumFeature(d) => d.to_step()
        AnyEntity::DimensionalSize(d) => d.to_step()
        AnyEntity::ManifoldSolidBrep(m) => m.to_step()
        AnyEntity::BrepWithVoids(b) => b.to_step()
        AnyEntity::ClosedShell(c) => c.to_step()
