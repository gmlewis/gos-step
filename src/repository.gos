        AnyEntity::TrimmedCurve(c) => c.to_step()
        AnyEntity::OffsetCurve3D(c) => c.to_step()
        AnyEntity::OffsetSurface(s) => s.to_step()
        AnyEntity::SurfaceOfLinearExtrusion(s) => s.to_step()
        AnyEntity::SurfaceOfRevolution(s) => s.to_step()
        AnyEntity::SweptSurface(s) => s.to_step()
