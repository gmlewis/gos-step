//! The entity repository and the `AnyEntity` sum type.
//!
//! Entities keep their incoming IDs and insertion order so a
//! parse → serialize → parse cycle is idempotent.

use crate::entity::Entity

pub enum AnyEntity {
    RawEntity(crate::raw_entity::RawEntity)
    CartesianPoint(crate::entities::geometry::CartesianPoint)
    Direction(crate::entities::geometry::Direction)
