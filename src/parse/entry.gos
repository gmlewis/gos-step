use crate::parse::tokenize::tokenize_step_data_section_with_base

/// Look up an entity parser by STEP entity name.
///
/// Returns `None` when the name is unknown (the caller preserves it as a raw
/// entity), and `Some(Err(..))` when a known parser rejects its arguments.
pub fn parse_entity(name: String, args: String) -> Option<Result<AnyEntity, ParseErrorInfo>> {
    match name {

        "CARTESIAN_POINT" => Some(crate::parse::parsers::parse_cartesian_point(args).map(|v| crate::repository::any_entity_cartesian_point(v)))
        "DIRECTION" => Some(crate::parse::parsers::parse_direction(args).map(|v| crate::repository::any_entity_direction(v)))
        "AXIS1_PLACEMENT" => Some(crate::parse::parsers::parse_axis1_placement(args).map(|v| crate::repository::any_entity_axis1_placement(v)))
        "AXIS2_PLACEMENT_2D" => Some(crate::parse::parsers::parse_axis2_placement_2d(args).map(|v| crate::repository::any_entity_axis2_placement_2d(v)))
        "AXIS2_PLACEMENT_3D" => Some(crate::parse::parsers::parse_axis2_placement_3d(args).map(|v| crate::repository::any_entity_axis2_placement_3d(v)))
        "PLANE" => Some(crate::parse::parsers::parse_plane(args).map(|v| crate::repository::any_entity_plane(v)))
        "CIRCLE" => Some(crate::parse::parsers::parse_circle(args).map(|v| crate::repository::any_entity_circle(v)))
        "ELLIPSE" => Some(crate::parse::parsers::parse_ellipse(args).map(|v| crate::repository::any_entity_ellipse(v)))
        "PARABOLA" => Some(crate::parse::parsers::parse_parabola(args).map(|v| crate::repository::any_entity_parabola(v)))
        "HYPERBOLA" => Some(crate::parse::parsers::parse_hyperbola(args).map(|v| crate::repository::any_entity_hyperbola(v)))
        "CYL_SURF" | "CYLINDRICAL_SURFACE" => Some(crate::parse::parsers::parse_cylindrical_surface(args).map(|v| crate::repository::any_entity_cylindrical_surface(v)))
        "CONICAL_SURFACE" => Some(crate::parse::parsers::parse_conical_surface(args).map(|v| crate::repository::any_entity_conical_surface(v)))
        "TOROIDAL_SURFACE" => Some(crate::parse::parsers::parse_toroidal_surface(args).map(|v| crate::repository::any_entity_toroidal_surface(v)))
        "B_SPLINE_CURVE" => Some(crate::parse::parsers::parse_b_spline_curve(args).map(|v| crate::repository::any_entity_b_spline_curve(v)))
        "B_SPLINE_CURVE_WITH_KNOTS" => Some(crate::parse::parsers::parse_b_spline_curve_with_knots(args).map(|v| crate::repository::any_entity_b_spline_curve_with_knots(v)))
