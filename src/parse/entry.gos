// ---------------------------------------------------------------------------
// Character helpers
// ---------------------------------------------------------------------------

fn to_chars(s: String) -> Vec<char> {
    let mut out = #[]
    for ch in s {
        out.push(ch)
    }
    out
}

fn slice_chars(cs: Vec<char>, start: i64, end: i64) -> String {
    let mut out = ""
    let mut i = start
    while i < end && i < cs.len() {
        out += f"{cs[i]}"
        i += 1
    }
    out
}

fn substr(s: String, start: i64, end: i64) -> String {
    slice_chars(to_chars(s), start, end)
}

fn cu_at(s: String, i: i64) -> i64 {
    let cs = to_chars(s)
    if i >= 0 && i < cs.len() { cs[i] as i64 } else { -1 }
}

// ---------------------------------------------------------------------------
// Complex instances
// ---------------------------------------------------------------------------

/// Split a complex-instance body into parts at newlines outside nested
/// parentheses and strings.
pub fn split_complex_parts(body: String) -> Vec<String> {
    let cs = to_chars(body)
    let mut out = #[]
    let mut depth: i64 = 0
    let mut in_str = false
    let mut skip_quote = false
    let mut start: i64 = 0
    let n = cs.len()
    let mut i: i64 = 0
    while i < n {
        let ci = cs[i]
        if ci == '\'' {
            if skip_quote {
                skip_quote = false
            } else if in_str {
                if i + 1 < n && cs[i + 1] == '\'' {
                    skip_quote = true
                } else {
                    in_str = false
                }
            } else {
                in_str = true
            }
        } else if !in_str {
            if ci == '(' {
                depth += 1
            } else if ci == ')' {
                if depth > 0 {
                    depth -= 1
                }
            } else if (ci == '\n' || ci == '\r') && depth == 0 {
                // Some writers break a part like `REPRESENTATION_CONTEXT`
                // then `('Context', ...)`. That newline is not a separator.
                let mut j = i + 1
                while j < n {
                    let cj = cs[j]
                    if cj == ' ' || cj == '\t' || cj == '\n' || cj == '\r' {
                        j += 1
                    } else {
                        break
                    }
                }
                let next_is_lparen = j < n && cs[j] == '('
                if !next_is_lparen {
                    let part = slice_chars(cs, start, i).trim()
                    if part.len() > 0 {
                        out.push(part)
                    }
                    start = i + 1
                }
            }
        }
        i += 1
    }
    if start <= n {
        let part = slice_chars(cs, start, n).trim()
        if part.len() > 0 {
            out.push(part)
        }
    }
    out
}

fn expect_empty_parens(arg: String) -> Result<(), ParseErrorInfo> {
    let inner = strip_outer_parens(arg)?.trim()
    if inner.len() != 0 {
        return fail_parse()
    }
    Ok(())
}

/// Parse a parenthesized complex-entity-instance body into its parts.
pub fn parse_complex_instance(args: String) -> Result<ComplexInstance, ParseErrorInfo> {
    let cs = to_chars(args.trim())
    if cs.len() < 2 || cs[0] != '(' || cs[cs.len() - 1] != ')' {
        return fail_parse()
    }
    let inner = slice_chars(cs, 1, cs.len() - 1)
    let part_strs = split_complex_parts(inner)
    let mut parts = #[]
    for s in part_strs {
        let scs = to_chars(s)
        let lp_idx = match find_char_index(scs, '(') {
            Some(j) => j
            None => return fail_parse()
        }
        let name = slice_chars(scs, 0, lp_idx).trim()
        let a = slice_chars(scs, lp_idx, scs.len()).trim()
        let part = match name {

            "GEOMETRIC_REPRESENTATION_CONTEXT" => {
                let inner_args = strip_outer_parens(a)?
                let dim = parse_int_dec(inner_args.trim())
                ComplexPart::GeomRepCtx(crate::entities::context::GeometricRepresentationContext::new(dim))
            }

            "REPRESENTATION_CONTEXT" => {
                let inner_args = strip_outer_parens(a)?
                let args_parts = split_args(inner_args)
                if args_parts.len() != 2 {
                    return fail_parse()
                }
                let ident = strip_quotes(args_parts[0])
                let ctx_type = strip_quotes(args_parts[1])
                ComplexPart::RepCtx(crate::entities::context::RepresentationContext::new(ident, ctx_type))
            }

            "NAMED_UNIT" => {
                let inner_args = strip_outer_parens(a)?.trim()
                ComplexPart::NamedUnit(crate::entities::units::NamedUnit::new(inner_args))
            }

            "SI_UNIT" => {
                let inner_args = strip_outer_parens(a)?
                let args_parts = split_args(inner_args)
                if args_parts.len() != 2 {
                    return fail_parse()
                }
                let prefix = args_parts[0].trim()
                let si_name = args_parts[1].trim()
                ComplexPart::SiUnit(crate::entities::units::SiUnit::new(prefix, si_name))
            }

            "SOLID_ANGLE_UNIT" => {
                expect_empty_parens(a)?
                ComplexPart::SolidAngleUnit(crate::entities::units::SolidAngleUnit::new())
            }

            "CONVERSION_BASED_UNIT" => {
                let inner_args = strip_outer_parens(a)?
                let args_parts = split_args(inner_args)
                if args_parts.len() != 2 {
                    return fail_parse()
                }
                let unit_name = strip_quotes(args_parts[0])
                let factor_id = parse_ref_int(args_parts[1])?
                ComplexPart::ConversionBasedUnit(
                    crate::entities::units::ConversionBasedUnit::new(
                        unit_name
                        crate::ids::Ref { id: factor_id }
                    )
                )
            }

            "LENGTH_UNIT" => {
                expect_empty_parens(a)?
                ComplexPart::LengthUnit(crate::entities::units::LengthUnit::new())
            }

            "MASS_UNIT" => {
                expect_empty_parens(a)?
                ComplexPart::MassUnit(crate::entities::units::MassUnit::new())
            }

            "PLANE_ANGLE_UNIT" => {
                expect_empty_parens(a)?
                ComplexPart::PlaneAngleUnit(crate::entities::units::PlaneAngleUnit::new())
            }

            "GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT" => {
                let inner_args = strip_outer_parens(a)?
                let ids = parse_ref_ids(inner_args)?
                ComplexPart::GlobUncCtx(crate::entities::context::GlobalUncertaintyAssignedContext::new(ids))
            }

            "GLOBAL_UNIT_ASSIGNED_CONTEXT" => {
                let inner_args = strip_outer_parens(a)?
                let ids = parse_ref_ids(inner_args)?
                ComplexPart::GlobUnitCtx(crate::entities::context::GlobalUnitAssignedContext::new(ids))
            }

            "REPRESENTATION_RELATIONSHIP" => {
                let inner_args = strip_outer_parens(a)?
                let args_parts = split_args(inner_args)
                if args_parts.len() != 4 {
                    return fail_parse()
                }
                let rr_name = strip_quotes(args_parts[0])
                let rr_desc = strip_quotes(args_parts[1])
                let rep_1_id = parse_ref_int(args_parts[2])?
                let rep_2_id = parse_ref_int(args_parts[3])?
                ComplexPart::RepRel(
                    crate::entities::product::RepresentationRelationship::new(
                        rr_name
                        rr_desc
                        crate::ids::Ref { id: rep_1_id }
                        crate::ids::Ref { id: rep_2_id }
                    )
                )
            }

            "REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION" => {
                let inner_args = strip_outer_parens(a)?
                let args_parts = split_args(inner_args)
                if args_parts.len() != 1 {
                    return fail_parse()
                }
                let t_id = parse_ref_int(args_parts[0])?
                ComplexPart::RepRelWT(
                    crate::entities::product::RepresentationRelationshipWithTransformation::new(
                        crate::ids::Ref { id: t_id }
                    )
                )
            }

            "SHAPE_REPRESENTATION_RELATIONSHIP" => {
                expect_empty_parens(a)?
                ComplexPart::ShapeRepRel
            }

            "REPRESENTATION_ITEM" => {
                let inner_args = strip_outer_parens(a)?
                ComplexPart::RepresentationItem(inner_args.trim())
            }

            "GEOMETRIC_REPRESENTATION_ITEM" => {
                expect_empty_parens(a)?
                ComplexPart::GeometricRepresentationItem
            }

            "SURFACE" => {
                expect_empty_parens(a)?
                ComplexPart::Surface
            }

            "BOUNDED_SURFACE" => {
                expect_empty_parens(a)?
                ComplexPart::BoundedSurface
            }

            "RATIONAL_B_SPLINE_CURVE" => {
                let inner_args = strip_outer_parens(a)?
                let weights = parse_literal_list(inner_args)
                ComplexPart::RatBSpline(crate::entities::geometry::RationalBSplineCurve::new(weights))
            }

            "B_SPLINE_SURFACE" => {
                let inner_args = strip_outer_parens(a)?
                let inner_entity = parse_b_spline_surface(inner_args)?
                ComplexPart::BSplineSurf(inner_entity)
            }

            "B_SPLINE_SURFACE_WITH_KNOTS" => {
                let inner_args = strip_outer_parens(a)?
                let inner_entity = parse_b_spline_surface_with_knots(inner_args)?
                ComplexPart::BSplineSurfKnots(inner_entity)
            }

            "RATIONAL_B_SPLINE_SURFACE" => {
                let inner_entity = parse_rational_b_spline_surface(a)?
                ComplexPart::RatBSplineSurf(inner_entity)
            }

            _ => {
                ComplexPart::Raw(name, a)
            }
        }
        parts.push(part)
    }
    Ok(ComplexInstance::new(parts))
}

fn find_char_index(cs: Vec<char>, target: char) -> Option<i64> {
    let mut i = 0
    while i < cs.len() {
        if cs[i] == target {
            return Some(i)
        }
        i += 1
    }
    None
}

// ---------------------------------------------------------------------------
// Header parsing
// ---------------------------------------------------------------------------

fn parse_step_string_literal(s: String) -> Option<String> {
    parse_step_string_literal_unescaped(s)
}

fn parse_string_or_dollar(arg: String) -> Option<StringOrDollar> {
    let t = arg.trim()
    if t == "$" {
        return Some(StringOrDollar::Dollar)
    }
    match parse_step_string_literal(t) {
        Some(v) => Some(StringOrDollar::Str(v))
        None => None
    }
}

fn parse_string_list_or_dollar(arg: String) -> Option<StringListOrDollar> {
    let t = arg.trim()
    if t == "$" {
        return Some(StringListOrDollar::Dollar)
    }
    let cs = to_chars(t)
    if !(cs.len() >= 2 && cs[0] == '(' && cs[cs.len() - 1] == ')') {
        return None
    }
    let parts = split_args(t)
    let mut values = #[]
    for p in parts {
        match parse_step_string_literal(p) {
            Some(v) => values.push(v)
            None => return None
        }
    }
    Some(StringListOrDollar::List(values))
}

fn parse_file_description(stmt: String, args: String) -> HeaderEntity {
    let parts = split_args(args)
    if parts.len() != 2 {
        return HeaderEntity::Raw(stmt)
    }
    let desc_opt = parse_string_list_or_dollar(parts[0])
    let impl_opt = parse_string_or_dollar(parts[1])
    match (desc_opt, impl_opt) {
        (Some(StringListOrDollar::List(desc)), Some(StringOrDollar::Str(impl_level))) => {
            HeaderEntity::FileDescription(FileDescription::new(desc, impl_level))
        }
        _ => HeaderEntity::Raw(stmt)
    }
}

fn parse_file_name(stmt: String, args: String) -> HeaderEntity {
    let parts = split_args(args)
    if parts.len() != 7 {
        return HeaderEntity::Raw(stmt)
    }
    let a0 = parse_string_or_dollar(parts[0])
    let a1 = parse_string_or_dollar(parts[1])
    let a2 = parse_string_list_or_dollar(parts[2])
    let a3 = parse_string_list_or_dollar(parts[3])
    let a4 = parse_string_or_dollar(parts[4])
    let a5 = parse_string_or_dollar(parts[5])
    let a6 = parse_string_or_dollar(parts[6])
    match (a0, a1, a2, a3, a4, a5, a6) {
        (Some(n), Some(ts), Some(auth), Some(org), Some(pp), Some(os), Some(az)) => {
            HeaderEntity::FileName(FileName::new(n, ts, auth, org, pp, os, az))
        }
        _ => HeaderEntity::Raw(stmt)
    }
}

fn parse_file_schema(stmt: String, args: String) -> HeaderEntity {
    let parts = split_args(args)
    if parts.len() != 1 {
        return HeaderEntity::Raw(stmt)
    }
    let list_opt = parse_string_list_or_dollar(parts[0])
    match list_opt {
        Some(StringListOrDollar::List(schemas)) => {
            HeaderEntity::FileSchema(FileSchema::new(schemas))
        }
        _ => HeaderEntity::Raw(stmt)
    }
}

/// Parse the statements of a HEADER section.
pub fn parse_header_section(header_section: String) -> HeaderSection {
    let stmts = split_statements(header_section)
    let mut entities = #[]
    for stmt in stmts {
        let cs = to_chars(stmt)
        match find_char_index(cs, '(') {
            None => entities.push(HeaderEntity::Raw(stmt))
            Some(j) => {
                let name = slice_chars(cs, 0, j).trim()
                let args = slice_chars(cs, j, cs.len()).trim()
                match name {
                    "FILE_DESCRIPTION" => {
                        entities.push(parse_file_description(stmt, args))
                    }
                    "FILE_NAME" => {
                        entities.push(parse_file_name(stmt, args))
                    }
                    "FILE_SCHEMA" => {
                        entities.push(parse_file_schema(stmt, args))
                    }
                    _ => {
                        entities.push(HeaderEntity::Raw(stmt))
                    }
                }
            }
        }
    }
    HeaderSection::new(entities)
}

// ---------------------------------------------------------------------------
// Section extraction
// ---------------------------------------------------------------------------

/// Find a literal outside STEP string literals. Returns the index when found;
/// otherwise `(None, Some(quote_start))` if the input ends inside a string.
pub fn find_literal_outside_step_strings_with_state(
    haystack: String
    needle: String
) -> (Option<i64>, Option<i64>) {
    let h = to_chars(haystack)
    let nd = to_chars(needle)
    let n = h.len()
    let m = nd.len()
    if m == 0 {
        return (Some(0), None)
    }
    let needle0 = nd[0]
    let mut in_string = false
    let mut string_start = 0
    let mut i: i64 = 0
    while i < n {
        let ci = h[i]
        if in_string {
            if ci == '\'' {
                if i + 1 < n && h[i + 1] == '\'' {
                    i += 2
                    continue
                }
                in_string = false
            }
            i += 1
            continue
        }
        if ci == '\'' {
            in_string = true
            string_start = i
            i += 1
            continue
        }
        if ci == needle0 && i + m <= n {
            let mut j: i64 = 1
            let mut ok = true
            while j < m {
                if h[i + j] != nd[j] {
                    ok = false
                    break
                }
                j += 1
            }
            if ok {
                return (Some(i), None)
            }
        }
        i += 1
    }
    if in_string {
        (None, Some(string_start))
    } else {
        (None, None)
    }
}

fn line_slice_at(s: String, idx: i64) -> String {
    let cs = to_chars(s)
    let n = cs.len()
    let mut start = if idx < 0 { 0 } else { idx }
    if start > n {
        start = n
    }
    let mut i = start
    while i > 0 {
        if cs[i - 1] == '\n' {
            break
        }
        i -= 1
    }
    let line_start = i
    let mut j = start
    while j < n {
        if cs[j] == '\n' {
            break
        }
        j += 1
    }
    slice_chars(cs, line_start, j)
}

fn index_to_line_col(s: String, idx: i64) -> (i64, i64) {
    let cs = to_chars(s)
    let mut line: i64 = 1
    let mut col: i64 = 1
    let mut i: i64 = 0
    while i < idx && i < cs.len() {
        if cs[i] == '\n' {
            line += 1
            col = 1
        } else {
            col += 1
        }
        i += 1
    }
    (line, col)
}

fn raise_unterminated_string_in_source<T>(
    content: String
    quote_idx: i64
) -> Result<T, ParseErrorInfo> {
    let line, col = index_to_line_col(content, quote_idx)
    let stmt = line_slice_at(content, quote_idx)
    fail_parse_at("unterminated STEP string literal", line, col, stmt)
}

/// Extract the DATA section, plus the 1-based position of its first character.
pub fn extract_data_section_with_pos(
    content: String
) -> Result<(String, i64, i64), ParseErrorInfo> {
    let data_idx = match find_literal_outside_step_strings_with_state(content, "DATA;") {
        (Some(i), _) => i
        (None, Some(q0)) => return raise_unterminated_string_in_source(content, q0)
        (None, None) => return fail_parse_msg("missing DATA section")
    }
    let after_data = data_idx + 5
    let cs = to_chars(content)
    let tail = slice_chars(cs, after_data, cs.len())
    let end_idx_local = match find_literal_outside_step_strings_with_state(tail, "ENDSEC;") {
        (Some(i), _) => i
        (None, Some(q0)) => {
            return raise_unterminated_string_in_source(content, after_data + q0)
        }
        (None, None) => return fail_parse_msg("missing ENDSEC; for DATA section")
    }
    let line, col = index_to_line_col(content, after_data)
    Ok((substr(tail, 0, end_idx_local), line, col))
}

/// Extract the HEADER section body when present.
pub fn extract_header_section(content: String) -> Result<Option<String>, ParseErrorInfo> {
    let header_idx = match find_literal_outside_step_strings_with_state(content, "HEADER;") {
        (Some(i), _) => i
        (None, Some(q0)) => return raise_unterminated_string_in_source(content, q0)
        (None, None) => return Ok(None)
    }
    let after_header = header_idx + 7
    let cs = to_chars(content)
    let tail = slice_chars(cs, after_header, cs.len())
    let end_idx_local = match find_literal_outside_step_strings_with_state(tail, "ENDSEC;") {
        (Some(i), _) => i
        (None, Some(q0)) => {
            return raise_unterminated_string_in_source(content, after_header + q0)
        }
        (None, None) => return Ok(None)
    }
    Ok(Some(substr(tail, 0, end_idx_local).trim()))
}

// ---------------------------------------------------------------------------
// Entry points
// ---------------------------------------------------------------------------

/// Parse a STEP file from a string into a repository.
///
/// Unknown entity names are preserved as raw entities for round-trip support.
pub fn parse_repository_from_string(content: String) -> Result<Repository, ParseErrorInfo> {
    // Normalize Windows CRLF (and stray CR) to keep parsing stable.
    let normalized = content.replace("\r", "")
    // Strip STEP block comments outside string literals.
    let cleaned = strip_step_comments(normalized)?
    let header = match extract_header_section(cleaned)? {
        Some(h) => parse_header_section(h)
        None => HeaderSection::empty()
    }
    let data_section, base_line, base_col = extract_data_section_with_pos(cleaned)?
    let rows = tokenize_step_data_section_with_base(data_section, base_line, base_col)?
    let mut repo = Repository::new()
    for row in rows {
        if row.name == "__COMPLEX__" {
            let entity = parse_complex_instance(row.args)?
            repo = repo.insert_with_id(row.id, any_entity_complex_instance(entity))
        } else {
            match parse_entity(row.name, row.args) {
                Some(Ok(entity)) => repo = repo.insert_with_id(row.id, entity)
                Some(Err(info)) => return Err(info)
                None => {
                    let raw = RawEntity::new(row.name, row.args)
                    repo = repo.insert_with_id(row.id, any_entity_raw_entity(raw))
                }
            }
        }
    }
    repo.set_header_mut(header)
    Ok(repo)
}

/// Parse a STEP file from disk, preserving bytes 0–255 as code points.
pub fn parse_repository_from_file(path: String) -> Result<Repository, crate::error::StepError> {
    let bytes = match fs::read(path) {
        Ok(b) => b
        Err(e) => return Err(crate::error::StepError::io(f"{e}"))
    }
    let content = bytes_ascii_to_string_preserve(bytes)
    match parse_repository_from_string(content) {
        Ok(r) => Ok(r)
        Err(info) => Err(crate::error::StepError::Parse(info))
    }
}

/// Preserve each byte as a code point 0–255 (not UTF-8 decoding).
pub fn bytes_ascii_to_string_preserve(bytes: Vec<u8>) -> String {
    let mut out = ""
    for byte in bytes {
        out += f"{char::from_u32(byte as u32).unwrap_or('?')}"
    }
    out
}

/// Non-throwing alias of `parse_repository_from_string`.
pub fn parse_repository_from_string_result(
    content: String
) -> Result<Repository, ParseErrorInfo> {
    parse_repository_from_string(content)
}
