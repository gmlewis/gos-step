//! Entity parsers: one function per STEP entity name.
//!
//! Ported 1:1 from the reference implementation. Numeric handling, string
//! decoding, and error positions are the contract.

use crate::error::{ParseErrorInfo, fail_parse, fail_parse_msg}
use crate::ids::{EntityId, Ref}
use crate::parse::tokenize::{parse_int_dec, split_args}

pub fn to_chars(s: String) -> Vec<char> {
    let mut out = #[]
    for ch in s {
        out.push(ch)
    }
    out
}

pub fn slice_chars(cs: Vec<char>, start: i64, end: i64) -> String {
    let mut out = ""
    let mut i = start
    while i < end && i < cs.len() {
        out += f"{cs[i]}"
        i += 1
    }
    out
}

pub fn substr(s: String, start: i64, end: i64) -> String {
    slice_chars(to_chars(s), start, end)
}

pub fn strip_outer_parens(arg: String) -> Result<String, ParseErrorInfo> {
    let t = arg.trim()
    let cs = to_chars(t)
    if cs.len() < 2 || cs[0] != '(' || cs[cs.len() - 1] != ')' {
        return fail_parse()
    }
    Ok(slice_chars(cs, 1, cs.len() - 1))
}

pub fn cu_at(s: String, i: i64) -> i64 {
    let chars = to_chars(s)
    if i >= 0 && i < chars.len() { chars[i] as i64 } else { -1 }
}


pub fn refs_of_ids(ids: Vec<EntityId>) -> Vec<Ref> {
    let mut out = #[]
    for id in ids {
        out.push(Ref { id: id })
    }
    out
}

pub fn parse_ref_rows(rows: Vec<String>) -> Result<Vec<Vec<Ref>>, ParseErrorInfo> {
    let mut out = #[]
    for row in rows {
        out.push(refs_of_ids(parse_ref_ids(row)?))
    }
    Ok(out)
}

pub fn parse_doubles(parts: Vec<String>) -> Result<Vec<f64>, ParseErrorInfo> {
    let mut out = #[]
    for p in parts {
        out.push(parse_double(p)?)
    }
    Ok(out)
}
pub fn parse_double(s: String) -> Result<f64, ParseErrorInfo> {
    match s.trim().to_f64() {
        Some(v) => Ok(v)
        None => fail_parse()
    }
}

pub fn strip_quotes(s: String) -> String {
    let cs = to_chars(s.trim())
    if cs.len() >= 2 && cs[0] == '\'' && cs[cs.len() - 1] == '\'' {
        return slice_chars(cs, 1, cs.len() - 1)
    }
    s.trim()
}

pub fn parse_step_string_literal_unescaped(s: String) -> Option<String> {
    let cs = to_chars(s.trim())
    if cs.len() >= 2 && cs[0] == '\'' && cs[cs.len() - 1] == '\'' {
        let inner = to_chars(slice_chars(cs, 1, cs.len() - 1))
        let mut out = ""
        let mut i = 0
        while i < inner.len() {
            if inner[i] == '\'' {
                if i + 1 < inner.len() && inner[i + 1] == '\'' {
                    out += "'"
                    i += 2
                    continue
                } else {
                    return None
                }
            }
            out += f"{inner[i]}"
            i += 1
        }
        return Some(out)
    }
    None
}

pub fn parse_step_string_or_strip(s: String) -> String {
    match parse_step_string_literal_unescaped(s) {
        Some(v) => v
        None => strip_quotes(s)
    }
}

pub fn parse_ref_int(s: String) -> Result<crate::ids::EntityId, ParseErrorInfo> {
    let t = s.trim()
    if t.len() < 2 || cu_at(t, 0) != '#' as i64 {
        return fail_parse()
    }
    let v = parse_int_dec(substr(t, 1, t.len()))
    Ok(crate::ids::EntityId { value: v, })
}

pub fn parse_cartesian_point(args: String,) -> Result<crate::entities::geometry::CartesianPoint, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let coord_parts = split_args(parts[1])
    let coords = parse_doubles(coord_parts)?
    Ok(crate::entities::geometry::CartesianPoint::new(name, coords))
}

pub fn parse_direction(args: String) -> Result<crate::entities::geometry::Direction, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let ratio_parts = split_args(parts[1])
    let ratios = parse_doubles(ratio_parts)?
    Ok(crate::entities::geometry::Direction::new(name, ratios))
}

pub fn parse_axis2_placement_3d(args: String,) -> Result<crate::entities::geometry::Axis2Placement3D, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() < 4 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let location_id = parse_ref_int(parts[1])?
    let axis_id = parse_ref_int(parts[2])?
    let ref_dir_id = parse_ref_int(parts[3])?
    Ok(crate::entities::geometry::Axis2Placement3D::new(
        name
        crate::ids::Ref { id: location_id, }
        crate::ids::Ref { id: axis_id, }
        crate::ids::Ref { id: ref_dir_id, }
    ))
}

pub fn parse_axis1_placement(args: String,) -> Result<crate::entities::geometry::Axis1Placement, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let location_id = parse_ref_int(parts[1])?
    let axis_id_str = parts[2].trim()
    let axis = if axis_id_str == "$" {
        None
    } else {
        Some(crate::ids::Ref { id: parse_ref_int(axis_id_str)?, })
    }
    Ok(crate::entities::geometry::Axis1Placement::new(name, crate::ids::Ref { id: location_id, }, axis: axis))
}

