pub fn parse_b_spline_curve(args: String,) -> Result<crate::entities::geometry::BSplineCurve, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 6 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let degree = parse_int_dec(parts[1])
    let cp_ids = parse_ref_ids(parts[2])?
    let control_points = cp_ids.map(|id| { crate::ids::Ref { id: id } })
    let curve_form = parts[3].trim()
    let closed_str = parts[4].trim()
    let self_i_str = parts[5].trim()
    let closed_curve = if closed_str == ".T." {
        true
    } else if closed_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let self_intersect = if self_i_str == ".T." {
        true
    } else if self_i_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    Ok(crate::entities::geometry::BSplineCurve::new(
        name, degree, control_points, curve_form, closed_curve, self_intersect
    ))
}

pub fn parse_int_list(arg: String) -> Vec<i64> {
    split_args(arg).map(parse_int_dec)
}

pub fn parse_literal_list(arg: String) -> Vec<String> {
    split_args(arg).map(parse_step_string_or_strip)
}

pub fn parse_b_spline_curve_with_knots(args: String,) -> Result<crate::entities::geometry::BSplineCurveWithKnots, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 9 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let degree = parse_int_dec(parts[1])
    let cp_ids = parse_ref_ids(parts[2])?
    let control_points = cp_ids.map(|id| { crate::ids::Ref { id: id } })
    let curve_form = parts[3].trim()
    let closed_str = parts[4].trim()
    let self_i_str = parts[5].trim()
    let closed_curve = if closed_str == ".T." {
        true
    } else if closed_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let self_intersect = if self_i_str == ".T." {
        true
    } else if self_i_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let knot_multiplicities = parse_int_list(parts[6])
    let knots = parse_literal_list(parts[7])
    let knot_spec = parts[8].trim()
    Ok(crate::entities::geometry::BSplineCurveWithKnots::new(
        name, degree, control_points, curve_form, closed_curve, self_intersect, knot_multiplicities
        knots, knot_spec
    ))
}

pub fn parse_composite_curve(args: String,) -> Result<crate::entities::geometry::CompositeCurve, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let seg_ids = parse_ref_ids(parts[1])?
    let segments = seg_ids.map(|id| { crate::ids::Ref { id: id } })
    let si_str = parts[2].trim()
    let self_intersect = if si_str == ".T." {
        true
    } else if si_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    Ok(crate::entities::geometry::CompositeCurve::new(name, segments, self_intersect))
}

pub fn parse_composite_curve_segment(args: String,) -> Result<crate::entities::geometry::CompositeCurveSegment, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let trans_str = parts[0].trim()
    let transition = match crate::entities::geometry::TransitionCode::from_string(trans_str) {
        Some(t) => t
        None => return fail_parse()
    }
    let ss_str = parts[1].trim()
    let same_sense = if ss_str == ".T." {
        true
    } else if ss_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let curve_id = parse_ref_int(parts[2])?
    Ok(crate::entities::geometry::CompositeCurveSegment::new(transition, same_sense, crate::ids::Ref {
        id: curve_id
    }))
}

pub fn parse_rational_b_spline_curve(args: String,) -> Result<crate::entities::geometry::RationalBSplineCurve, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 1 {
        return fail_parse()
    }
    let weights = parse_literal_list(parts[0])
    Ok(crate::entities::geometry::RationalBSplineCurve::new(weights))
}

pub fn parse_b_spline_surface(args: String,) -> Result<crate::entities::geometry::BSplineSurface, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 7 {
        return fail_parse()
    }
    let u_degree = parse_int_dec(parts[0])
    let v_degree = parse_int_dec(parts[1])
    let row_parts = split_args(parts[2])
    let control_points_list = parse_ref_rows(row_parts)?
    let surface_form = parts[3].trim()
    let u_closed_str = parts[4].trim()
    let v_closed_str = parts[5].trim()
    let self_i_str = parts[6].trim()
    let u_closed = if u_closed_str == ".T." {
        true
    } else if u_closed_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let v_closed = if v_closed_str == ".T." {
        true
    } else if v_closed_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let self_intersect = if self_i_str == ".T." {
        true
    } else if self_i_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    Ok(crate::entities::geometry::BSplineSurface::new(
        u_degree, v_degree, control_points_list, surface_form, u_closed, v_closed, self_intersect
    ))
}

pub fn parse_b_spline_surface_with_knots(args: String,) -> Result<crate::entities::geometry::BSplineSurfaceWithKnots, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 5 {
        return fail_parse()
    }
    let u_mults = parse_int_list(parts[0])
    let v_mults = parse_int_list(parts[1])
    let u_knots = parse_literal_list(parts[2])
    let v_knots = parse_literal_list(parts[3])
    let knot_spec = parts[4].trim()
    Ok(crate::entities::geometry::BSplineSurfaceWithKnots::new(
        u_mults, v_mults, u_knots, v_knots, knot_spec
    ))
}

pub fn parse_rational_b_spline_surface(args: String,) -> Result<crate::entities::geometry::RationalBSplineSurface, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 1 {
        return fail_parse()
    }
    // parts[0] looks like: ((1.,...),(...),(...))
    let row_parts = split_args(parts[0])
    let weights = row_parts.map(parse_literal_list)
    Ok(crate::entities::geometry::RationalBSplineSurface::new(weights))
}

pub fn parse_trimmed_curve(args: String,) -> Result<crate::entities::geometry::TrimmedCurve, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 6 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let basis_id = parse_ref_int(parts[1])?
    let trim_1 = parts[2].trim()
    let trim_2 = parts[3].trim()
    let sense_str = parts[4].trim()
    let sense = if sense_str == ".T." {
        true
    } else if sense_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let master_rep = parts[5].trim()
    Ok(crate::entities::geometry::TrimmedCurve::new(
        name
        crate::ids::Ref { id: basis_id, }
        trim_1
        trim_2
        sense
        master_rep
    ))
}

