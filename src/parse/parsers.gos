pub fn parse_face_surface(args: String,) -> Result<crate::entities::topology::FaceSurface, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 4 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let bound_ids = parse_ref_ids(parts[1])?
    let bounds = bound_ids.map(|id| { crate::ids::Ref { id: id } })
    let geom_id = parse_ref_int(parts[2])?
    let ss_str = parts[3].trim()
    let same_sense = if ss_str == ".T." {
        true
    } else if ss_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    Ok(crate::entities::topology::FaceSurface::new(
        name
        bounds
        crate::ids::Ref { id: geom_id, }
        same_sense
    ))
}

