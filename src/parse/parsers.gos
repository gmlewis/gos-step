pub fn parse_descriptive_representation_item(args: String,) -> Result<crate::entities::product::DescriptiveRepresentationItem, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse_msg(
            "DESCRIPTIVE_REPRESENTATION_ITEM expected 2 args, got " +
                f"{parts.len()}" +
                ": " +
                args
        )
    }
    // Use proper STEP string unescaping so roundtrip is stable for values
    // containing doubled quotes (''), semicolons, or comment-like sequences.
    let name = parse_step_string_or_strip(parts[0])
    let description = parse_step_string_or_strip(parts[1])
    Ok(crate::entities::product::DescriptiveRepresentationItem::new(name, description))
}

pub fn parse_measure_representation_item(args: String,) -> Result<crate::entities::product::MeasureRepresentationItem, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let value_component_str = parts[1].trim()
    let value_component = if value_component_str.starts_with("POSITIVE_RATIO_MEASURE"
    ) {
        // Looks like: POSITIVE_RATIO_MEASURE(7850.)
        // Keep the inner literal as raw string to preserve formatting.
        let args_part = substr(
            value_component_str
            "POSITIVE_RATIO_MEASURE".len()
            value_component_str.len()
        )
        let inner = strip_outer_parens(args_part)?.trim()
        crate::entities::product::MeasureValueComponent::PositiveRatioMeasure(
            crate::entities::units::PositiveRatioMeasure::new(inner)
        )
    } else {
        crate::entities::product::MeasureValueComponent::Raw(value_component_str)
    }
    let unit_id = parse_ref_int(parts[2])?
    Ok(crate::entities::product::MeasureRepresentationItem::new(name, value_component, crate::ids::Ref {
        id: unit_id
    }))
}

