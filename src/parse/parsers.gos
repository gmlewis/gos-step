    let basis_id = parse_ref_int(parts[1])?
    let distance = parse_double(parts[2])?
    let dir_id = parse_ref_int(parts[3])?
    Ok(crate::entities::geometry::OffsetCurve3D::new(name, crate::ids::Ref { id: basis_id, }, distance, crate::ids::Ref {
        id: dir_id
    }))
}

