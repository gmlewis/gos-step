pub fn parse_rectangular_trimmed_surface(args: String,) -> Result<crate::entities::geometry::RectangularTrimmedSurface, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 8 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let basis_id = parse_ref_int(parts[1])?
    let u1 = parts[2].trim()
    let u2 = parts[3].trim()
    let v1 = parts[4].trim()
    let v2 = parts[5].trim()
    let usense_str = parts[6].trim()
    let usense = if usense_str == ".T." {
        true
    } else if usense_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    let vsense_str = parts[7].trim()
    let vsense = if vsense_str == ".T." {
        true
    } else if vsense_str == ".F." {
        false
    } else {
        return fail_parse()
    }
    Ok(crate::entities::geometry::RectangularTrimmedSurface::new(
        name
        crate::ids::Ref { id: basis_id, }
        u1
        u2
        v1
        v2
        usense
        vsense
    ))
}

pub fn parse_polyline(args: String) -> Result<crate::entities::geometry::Polyline, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let ids = parse_ref_ids(parts[1])?
    let points = ids.map(|id| { crate::ids::Ref { id: id } })
    Ok(crate::entities::geometry::Polyline::new(name, points))
}

pub fn parse_boolean_result(args: String,) -> Result<crate::entities::geometry::BooleanResult, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 4 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let op_str = parts[1].trim()
    let operator = match crate::entities::geometry::BooleanOperator::from_string(op_str) {
        Some(op) => op
        None => return fail_parse()
    }
    let op1_id = parse_ref_int(parts[2])?
