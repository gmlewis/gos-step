    let parts = split_args(args)
    if parts.len() != 6 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let literal = strip_quotes(parts[1])
    let placement_id = parse_ref_int(parts[2])?
    let alignment = strip_quotes(parts[3])
    let path_str = parts[4].trim()
    let path = match crate::entities::presentation::TextPath::from_string(path_str) {
        Some(p) => p
        None => return fail_parse()
    }
    let font_id = parse_ref_int(parts[5])?
    Ok(crate::entities::presentation::TextLiteral::new(
        name
        literal
        crate::ids::Ref { id: placement_id, }
        alignment
        path
        crate::ids::Ref { id: font_id, }
    ))
}

