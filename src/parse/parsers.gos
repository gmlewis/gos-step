pub fn parse_product_definition_formation_with_specified_source(args: String,) -> Result<crate::entities::product::ProductDefinitionFormationWithSpecifiedSource, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 4 {
        return fail_parse()
    }
    let id = strip_quotes(parts[0])
    let description = strip_quotes(parts[1])
    let product_id = parse_ref_int(parts[2])?
    let make_or_buy = parts[3].trim()
    // Enumeration like .NOT_KNOWN.
    if make_or_buy != ".NOT_KNOWN." &&
        make_or_buy != ".MAKE." &&
        make_or_buy != ".BUY." {
        return fail_parse()
    }
    Ok(crate::entities::product::ProductDefinitionFormationWithSpecifiedSource::new(
        id
        description
        crate::ids::Ref { id: product_id, }
        make_or_buy
    ))
}

