    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let name = strip_quotes(parts[0])
    let style_ids = parse_ref_ids(parts[1])?
    let styles = style_ids.map(|id| { crate::ids::Ref { id: id } })
    let item_id = parse_ref_int(parts[2])?
    Ok(crate::entities::presentation::AnnotationOccurrence::new(name, styles, crate::ids::Ref {
        id: item_id
    }))
}

pub fn parse_dimensional_exponents(args: String,) -> Result<crate::entities::units::DimensionalExponents, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 7 {
        return fail_parse()
    }
    Ok(crate::entities::units::DimensionalExponents::new(
        parse_double(parts[0])?
        parse_double(parts[1])?
        parse_double(parts[2])?
        parse_double(parts[3])?
        parse_double(parts[4])?
        parse_double(parts[5])?
        parse_double(parts[6])?
    ))
}

pub fn parse_length_measure_literal(arg: String) -> Result<String, ParseErrorInfo> {
    let t = arg.trim()
    if !t.starts_with("LENGTH_MEASURE(") {
        return fail_parse()
    }
    if t.len() < 16 || !t.ends_with(")") {
        return fail_parse()
    }
    // Inner literal (preserve scientific notation like `2.E-005`).
    // "LENGTH_MEASURE(" is 15 chars; the opening paren is index 14.
    Ok(substr(t, 15, t.len() - 1).trim())
}

pub fn parse_uncertainty_measure_with_unit(args: String,) -> Result<crate::entities::units::UncertaintyMeasureWithUnit, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 4 {
        return fail_parse()
    }
    let length_measure_literal = parse_length_measure_literal(parts[0])?
    let unit_id = parse_ref_int(parts[1])?
    let name = strip_quotes(parts[2])
    let description = strip_quotes(parts[3])
    Ok(crate::entities::units::UncertaintyMeasureWithUnit::new(
        length_measure_literal
        crate::ids::Ref { id: unit_id, }
        name
        description
    ))
}

pub fn parse_plane_angle_measure_literal(arg: String,) -> Result<String, ParseErrorInfo> {
    let t = arg.trim()
    if !t.starts_with("PLANE_ANGLE_MEASURE(") {
        return fail_parse()
    }
    if t.len() < 22 || !t.ends_with(")") {
        return fail_parse()
    }
    // Inner literal (preserve formatting).
    // "PLANE_ANGLE_MEASURE(" is 20 chars.
    Ok(substr(t, 20, t.len() - 1).trim())
}

pub fn parse_plane_angle_measure_with_unit(args: String,) -> Result<crate::entities::units::PlaneAngleMeasureWithUnit, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let plane_angle_measure_literal = parse_plane_angle_measure_literal(parts[0])?
    let unit_id = parse_ref_int(parts[1])?
    Ok(crate::entities::units::PlaneAngleMeasureWithUnit::new(plane_angle_measure_literal, crate::ids::Ref {
        id: unit_id
    }))
}

pub fn parse_derived_unit_element(args: String,) -> Result<crate::entities::units::DerivedUnitElement, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let unit_id = parse_ref_int(parts[0])?
    let exponent = parse_double(parts[1])?
    Ok(crate::entities::units::DerivedUnitElement::new(crate::ids::Ref { id: unit_id, }, exponent))
}

pub fn parse_derived_unit(args: String) -> Result<crate::entities::units::DerivedUnit, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 1 {
        return fail_parse()
    }
    let elem_ids = parse_ref_ids(parts[0])?
    let elems = elem_ids.map(|id| { crate::ids::Ref { id: id } })
    Ok(crate::entities::units::DerivedUnit::new(elems))
}

pub fn parse_measure_with_unit(args: String,) -> Result<crate::entities::units::MeasureWithUnit, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 2 {
        return fail_parse()
    }
    let val = parts[0].trim()
    let unit_id = parse_ref_int(parts[1])?
    Ok(crate::entities::units::MeasureWithUnit::new(val, crate::ids::Ref { id: unit_id, }))
}
