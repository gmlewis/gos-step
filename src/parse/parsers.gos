pub fn parse_calendar_date(args: String,) -> Result<crate::entities::product::CalendarDate, ParseErrorInfo> {
    let parts = split_args(args)
    if parts.len() != 3 {
        return fail_parse()
    }
    let year = parse_int_dec(parts[0])
    let day = parse_int_dec(parts[1])
    let month = parse_int_dec(parts[2])
    Ok(crate::entities::product::CalendarDate::new(year, day, month))
}

