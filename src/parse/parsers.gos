pub fn parse_ref_ids(arg: String) -> Result<Vec<EntityId>, ParseErrorInfo> {
    let mut out = #[]
    for p in split_args(arg) {
        out.push(parse_ref_int(p)?)
    }
    Ok(out)
}

pub fn parse_surface_side(s: String) -> Result<String, ParseErrorInfo> {
    let t = s.trim()
    Ok(match t {
