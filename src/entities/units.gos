// Represents a POSITIVE_RATIO_MEASURE value.
// This is not a standalone STEP entity row; it appears inline, e.g.
//   POSITIVE_RATIO_MEASURE(7850.)
//
// Notes:
// - We store the inner numeric literal as a raw string to preserve formatting.
pub struct PositiveRatioMeasure {
    pub value: String
}

impl PositiveRatioMeasure {
    pub fn new(value: String) -> PositiveRatioMeasure {
        let trimmed = value.trim()
        PositiveRatioMeasure { value: trimmed, }
    }
}

impl Entity for PositiveRatioMeasure {
    fn to_step(self) -> String {
        f"POSITIVE_RATIO_MEASURE({self.value})"
    }
}

// Represents a SI_UNIT entity (often used inside complex instances).
// Examples:
//   SI_UNIT($,.RADIAN.)
//   SI_UNIT(.MILLI.,.METRE.)
pub struct SiUnit {
    pub prefix: String
    pub name: String
}

impl SiUnit {
    pub fn new(prefix: String, name: String) -> SiUnit {
        SiUnit { prefix: prefix, name: name }
    }
}

impl Entity for SiUnit {
    fn to_step(self) -> String {
        f"SI_UNIT({self.prefix},{self.name})"
    }
}

