// Represents an UNCERTAINTY_MEASURE_WITH_UNIT entity.
//
// For the simple-box fixture, the measure component is always `LENGTH_MEASURE(<literal>)`.
pub struct UncertaintyMeasureWithUnit {
    pub length_measure_literal: String
    pub unit: Ref
    pub name: String
    pub description: String
}

impl UncertaintyMeasureWithUnit {
    pub fn new(length_measure_literal: String, unit: Ref, name: String, description: String) -> UncertaintyMeasureWithUnit {
        UncertaintyMeasureWithUnit { length_measure_literal: length_measure_literal, unit: unit, name: name, description: description }
    }
}

impl Entity for UncertaintyMeasureWithUnit {
    fn to_step(self) -> String {
        let unit_str = f"#{self.unit.id.value}"
        f"UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE({self.length_measure_literal}),{unit_str},{step_str(self.name)},{step_str(self.description)})"
    }
}
