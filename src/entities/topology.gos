// Represents an EDGE_CURVE entity.
// Example from simple-box.step:
//   EDGE_CURVE('',#82,#83,#102,.T.)
pub struct EdgeCurve {
    pub name: String
    pub edge_start: Ref
    pub edge_end: Ref
    pub edge_geometry: Ref
    pub same_sense: bool
}

impl EdgeCurve {
    pub fn new(name: String, edge_start: Ref, edge_end: Ref, edge_geometry: Ref, same_sense: bool) -> EdgeCurve {
        EdgeCurve { name: name, edge_start: edge_start, edge_end: edge_end, edge_geometry: edge_geometry, same_sense: same_sense }
    }
}

impl Entity for EdgeCurve {
    fn to_step(self) -> String {
        let start_str = f"#{self.edge_start.id.value}"
        let end_str = f"#{self.edge_end.id.value}"
        let geom_str = f"#{self.edge_geometry.id.value}"
        let ss_str = bool_to_step(self.same_sense)
        f"EDGE_CURVE({step_str_or_dollar(self.name)},{start_str},{end_str},{geom_str},{ss_str})"
    }
}

