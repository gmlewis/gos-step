//! STEP entity models: topology family.
//!
//! Ported 1:1 from the reference implementation; the
//! serialization (including spacing quirks) is the contract.

use crate::entity::Entity
use crate::fmt::{step_str}
use crate::ids::{Ref}

fn step_str_or_dollar(s: String) -> String {
    if s == "$" { "$" } else { step_str(s) }
}

fn bool_to_step(b: bool) -> String {
    if b { ".T." } else { ".F." }
}

// Represents an ADVANCED_FACE entity.
// Example from simple-box.step:
//   ADVANCED_FACE('',(#46),#40,.F.)
pub struct AdvancedFace {
    pub name: String
    pub bounds: Vec<Ref>
    pub surface: Ref
    pub same_sense: bool
}

impl AdvancedFace {
    pub fn new(name: String, bounds: Vec<Ref>, surface: Ref, same_sense: bool) -> AdvancedFace {
        AdvancedFace { name: name, bounds: bounds, surface: surface, same_sense: same_sense }
    }
}

impl Entity for AdvancedFace {
    fn to_step(self) -> String {
        let bounds_str = self.bounds.map(|r| { f"#{r.id.value}" }).join(",")
        let surface_str = f"#{self.surface.id.value}"
        let ss_str = bool_to_step(self.same_sense)
        f"ADVANCED_FACE({step_str_or_dollar(self.name)},({bounds_str}),{surface_str},{ss_str})"
    }
}

// Represents a BREP_WITH_VOIDS entity.
// Example:
//   BREP_WITH_VOIDS('', #10, (#20,#30))
// where #10 is the outer CLOSED_SHELL and #20/#30 are void CLOSED_SHELLs.
pub struct BrepWithVoids {
    pub name: String
    pub outer: Ref
    pub voids: Vec<Ref>
}

impl BrepWithVoids {
    pub fn new(name: String, outer: Ref, voids: Vec<Ref>) -> BrepWithVoids {
        BrepWithVoids { name: name, outer: outer, voids: voids }
    }
}

impl Entity for BrepWithVoids {
    fn to_step(self) -> String {
        let outer_str = f"#{self.outer.id.value}"
        let voids_str = self.voids.map(|r| { f"#{r.id.value}" }).join(",")
        f"BREP_WITH_VOIDS({step_str_or_dollar(self.name)},{outer_str},({voids_str}))"
    }
}

