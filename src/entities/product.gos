//   LOCAL_TIME(12, 30, 0.0, #10)
// where #10 is a COORDINATED_UNIVERSAL_TIME_OFFSET.
pub struct LocalTime {
    pub hour_component: i64
    pub minute_component: i64
    pub second_component: f64
    pub zone: Ref
}

impl LocalTime {
    pub fn new(hour_component: i64, minute_component: i64, second_component: f64, zone: Ref) -> LocalTime {
        LocalTime { hour_component: hour_component, minute_component: minute_component, second_component: second_component, zone: zone }
    }
}

impl Entity for LocalTime {
    fn to_step(self) -> String {
        let zone_str = f"#{self.zone.id.value}"
        f"LOCAL_TIME({self.hour_component},{self.minute_component},{fmt_num(self.second_component)},{zone_str})"
    }
}

// Represents a MEASURE_REPRESENTATION_ITEM entity.
// Example from MachineContactMedium.step:
//   MEASURE_REPRESENTATION_ITEM('density measure',POSITIVE_RATIO_MEASURE(7850.),#589)
pub enum MeasureValueComponent {
    PositiveRatioMeasure(crate::entities::units::PositiveRatioMeasure)
    Raw(String)
}

pub struct MeasureRepresentationItem {
    pub name: String
    pub value_component: MeasureValueComponent
    pub unit_component: Ref
}

impl MeasureRepresentationItem {
    pub fn new(name: String, value_component: MeasureValueComponent, unit_component: Ref) -> MeasureRepresentationItem {
        MeasureRepresentationItem { name: name, value_component: value_component, unit_component: unit_component }
    }
}

impl Entity for MeasureRepresentationItem {
    fn to_step(self) -> String {
        let unit_str = f"#{self.unit_component.id.value}"
        let value_str = match self.value_component {
            MeasureValueComponent::PositiveRatioMeasure(m) => m.to_step()
            MeasureValueComponent::Raw(s) => s
        }
        f"MEASURE_REPRESENTATION_ITEM({step_str(self.name)},{value_str},{unit_str})"
    }
}

// Represents a NEXT_ASSEMBLY_USAGE_OCCURRENCE entity.
