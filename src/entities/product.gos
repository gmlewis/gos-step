impl Product {
    pub fn new(name: String, id: String, description: String, frame_of_reference: Vec<Ref>) -> Product {
        Product { name: name, id: id, description: description, frame_of_reference: frame_of_reference }
    }
}

impl Entity for Product {
    fn to_step(self) -> String {
        let refs_str = self.frame_of_reference
            .map(|r| { f"#{r.id.value}" })
            .join(",")
        f"PRODUCT({step_str_or_dollar(self.name)},{step_str_or_dollar(self.id)},{step_str_or_dollar(self.description)},({refs_str}))"
    }
}

