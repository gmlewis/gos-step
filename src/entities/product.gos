//! STEP entity models: product family.
//!
//! Ported 1:1 from the reference implementation; the
//! serialization (including spacing quirks) is the contract.

use crate::entity::Entity
use crate::fmt::{fmt_num, step_str}
use crate::ids::{Ref}

fn step_str_or_dollar(s: String) -> String {
    if s == "$" { "$" } else { step_str(s) }
}

fn bool_to_step(b: bool) -> String {
    if b { ".T." } else { ".F." }
}

// Represents an ADVANCED_BREP_SHAPE_REPRESENTATION entity.
// Example from simple-box.step:
//   ADVANCED_BREP_SHAPE_REPRESENTATION('cube-None',(#32),#187)
pub struct AdvancedBrepShapeRepresentation {
    pub name: String
    pub items: Vec<Ref>
    pub context_of_items: Ref
}

impl AdvancedBrepShapeRepresentation {
    pub fn new(name: String, items: Vec<Ref>, context_of_items: Ref) -> AdvancedBrepShapeRepresentation {
        AdvancedBrepShapeRepresentation { name: name, items: items, context_of_items: context_of_items }
    }
}

impl Entity for AdvancedBrepShapeRepresentation {
    fn to_step(self) -> String {
        let items_str = self.items.map(|r| { f"#{r.id.value}" }).join(",")
        let ctx_str = f"#{self.context_of_items.id.value}"
        f"ADVANCED_BREP_SHAPE_REPRESENTATION({step_str(self.name)},({items_str}),{ctx_str})"
    }
}

// Represents an APPLICATION_CONTEXT entity.
// Example from simple-box.step:
//   APPLICATION_CONTEXT('core data for automotive mechanical design processes')
pub struct ApplicationContext {
    pub application: String
}

impl ApplicationContext {
    pub fn new(application: String) -> ApplicationContext {
        ApplicationContext { application: application }
    }
}

impl Entity for ApplicationContext {
    fn to_step(self) -> String {
        f"APPLICATION_CONTEXT({step_str_or_dollar(self.application)})"
    }
}

// Represents an APPLICATION_PROTOCOL_DEFINITION entity.
// Example from simple-box.step:
//   APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2010,#21)
pub struct ApplicationProtocolDefinition {
    pub status: String
    pub application_interpreted_model_schema_name: String
    pub application_protocol_year: i64
    pub application: Ref
}

impl ApplicationProtocolDefinition {
    pub fn new(status: String, application_interpreted_model_schema_name: String, application_protocol_year: i64, application: Ref) -> ApplicationProtocolDefinition {
        ApplicationProtocolDefinition { status: status, application_interpreted_model_schema_name: application_interpreted_model_schema_name, application_protocol_year: application_protocol_year, application: application }
    }
}

impl Entity for ApplicationProtocolDefinition {
    fn to_step(self) -> String {
        let year_str = self.application_protocol_year.to_string()
        let app_str = f"#{self.application.id.value}"
        f"APPLICATION_PROTOCOL_DEFINITION({step_str_or_dollar(self.status)},{step_str_or_dollar(self.application_interpreted_model_schema_name)},{year_str},{app_str})"
    }
}

// Represents an APPROVAL_PERSON_ORGANIZATION entity.
// Example:
//   APPROVAL_PERSON_ORGANIZATION(#10, #20, #30)
// where #10 is PERSON/ORGANIZATION/PERSON_AND_ORGANIZATION,
// #20 is APPROVAL, and #30 is APPROVAL_ROLE.
pub struct ApprovalPersonOrganization {
    pub person_organization: Ref
    pub approval: Ref
    pub role: Ref
}

impl ApprovalPersonOrganization {
    pub fn new(person_organization: Ref, approval: Ref, role: Ref) -> ApprovalPersonOrganization {
        ApprovalPersonOrganization { person_organization: person_organization, approval: approval, role: role }
    }
}

impl Entity for ApprovalPersonOrganization {
    fn to_step(self) -> String {
        let po_str = f"#{self.person_organization.id.value}"
        let approval_str = f"#{self.approval.id.value}"
        let role_str = f"#{self.role.id.value}"
        f"APPROVAL_PERSON_ORGANIZATION({po_str},{approval_str},{role_str})"
    }
}

