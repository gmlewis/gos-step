    pub id: String
    pub name: String
    pub description: String
    pub relating_product_definition: Ref
    pub related_product_definition: Ref
    pub reference_designator: String
}

impl NextAssemblyUsageOccurrence {
    pub fn new(id: String, name: String, description: String, relating_product_definition: Ref, related_product_definition: Ref, reference_designator: String) -> NextAssemblyUsageOccurrence {
        NextAssemblyUsageOccurrence { id: id, name: name, description: description, relating_product_definition: relating_product_definition, related_product_definition: related_product_definition, reference_designator: reference_designator }
    }
}

impl Entity for NextAssemblyUsageOccurrence {
    fn to_step(self) -> String {
        let relating_str = f"#{self.relating_product_definition.id.value}"
        let related_str = f"#{self.related_product_definition.id.value}"
        f"NEXT_ASSEMBLY_USAGE_OCCURRENCE({step_str(self.id)},{step_str(self.name)},{step_str_or_dollar(self.description)},{relating_str},{related_str},{step_str_or_dollar(self.reference_designator)})"
    }
}

