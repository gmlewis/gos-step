// Represents a PERSON_AND_ORGANIZATION entity.
// Example:
//   PERSON_AND_ORGANIZATION(#10, #20)
// where #10 is a PERSON and #20 is an ORGANIZATION.
pub struct PersonAndOrganization {
    pub the_person: Ref
    pub the_organization: Ref
}

impl PersonAndOrganization {
    pub fn new(the_person: Ref, the_organization: Ref) -> PersonAndOrganization {
        PersonAndOrganization { the_person: the_person, the_organization: the_organization }
    }
}

impl Entity for PersonAndOrganization {
    fn to_step(self) -> String {
        let person_str = f"#{self.the_person.id.value}"
        let org_str = f"#{self.the_organization.id.value}"
        f"PERSON_AND_ORGANIZATION({person_str},{org_str})"
    }
}

// Represents a PERSON entity.
// Example:
//   PERSON('id', 'last', 'first', ('middle'), ('prefix'), ('suffix'))
pub struct Person {
    pub id: String
    pub last_name: String
    pub first_name: String
    pub middle_names: Vec<String>
    pub prefix_titles: Vec<String>
    pub suffix_titles: Vec<String>
}

impl Person {
    pub fn new(id: String, last_name: String, first_name: String, middle_names: Vec<String>, prefix_titles: Vec<String>, suffix_titles: Vec<String>) -> Person {
        Person { id: id, last_name: last_name, first_name: first_name, middle_names: middle_names, prefix_titles: prefix_titles, suffix_titles: suffix_titles }
    }
}

impl Entity for Person {
    fn to_step(self) -> String {
        let middles = "(" + self.middle_names.map(step_str).join(",") + ")"
        let prefixes = "(" + self.prefix_titles.map(step_str).join(",") + ")"
        let suffixes = "(" + self.suffix_titles.map(step_str).join(",") + ")"
        f"PERSON({step_str(self.id)},{step_str(self.last_name)},{step_str(self.first_name)},{middles},{prefixes},{suffixes})"
    }
}

