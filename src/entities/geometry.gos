//! STEP entity models: geometry family.
//!
//! Ported 1:1 from the reference implementation; the
//! serialization (including spacing quirks) is the contract.

use crate::entity::Entity
use crate::fmt::{fmt_num, step_str}
use crate::ids::{Ref}

fn step_str_or_dollar(s: String) -> String {
    if s == "$" { "$" } else { step_str(s) }
}

fn bool_to_step(b: bool) -> String {
    if b { ".T." } else { ".F." }
}

// Represents an AXIS1_PLACEMENT entity.
// Example:
//   AXIS1_PLACEMENT('name', #10, #20)
// where #10 is a CARTESIAN_POINT and #20 is an optional DIRECTION.
pub struct Axis1Placement {
    pub name: String
    pub location: Ref
    pub axis: Option<Ref>
}

impl Axis1Placement {
    pub fn new(name: String, location: Ref, axis: Option<Ref> = None) -> Axis1Placement {
        Axis1Placement { name: name, location: location, axis: axis }
    }
}

impl Entity for Axis1Placement {
    fn to_step(self) -> String {
        let loc_str = f"#{self.location.id.value}"
        let axis_str = match self.axis {
            Some(r) => f"#{r.id.value}"
            None => "$"
        }
        f"AXIS1_PLACEMENT({step_str(self.name)},{loc_str},{axis_str})"
    }
}

// Represents an AXIS2_PLACEMENT_2D entity.
// Example:
//   AXIS2_PLACEMENT_2D('name', #10, #20)
// where #10 is a CARTESIAN_POINT and #20 is an optional DIRECTION.
pub struct Axis2Placement2D {
    pub name: String
    pub location: Ref
    pub ref_direction: Option<Ref>
}

impl Axis2Placement2D {
    pub fn new(name: String, location: Ref, ref_direction: Option<Ref> = None) -> Axis2Placement2D {
        Axis2Placement2D { name: name, location: location, ref_direction: ref_direction }
    }
}

impl Entity for Axis2Placement2D {
    fn to_step(self) -> String {
        let loc_str = f"#{self.location.id.value}"
        let dir_str = match self.ref_direction {
            Some(r) => f"#{r.id.value}"
            None => "$"
        }
        f"AXIS2_PLACEMENT_2D({step_str(self.name)},{loc_str},{dir_str})"
    }
}

// Represents an AXIS2_PLACEMENT_3D entity.
pub struct Axis2Placement3D {
    pub name: String
    pub location: Ref
    pub axis: Ref
    pub ref_direction: Ref
}

impl Axis2Placement3D {
    pub fn new(name: String, location: Ref, axis: Ref, ref_direction: Ref) -> Axis2Placement3D {
        Axis2Placement3D { name: name, location: location, axis: axis, ref_direction: ref_direction }
    }
}

fn ref_to_step(r: Ref) -> String {
    // Access the `id` field from the Ref struct
    f"#{r.id.value}"
}

// Implement the core trait.
impl Entity for Axis2Placement3D {
    fn to_step(self) -> String {
        let loc = ref_to_step(self.location)
        let ax = ref_to_step(self.axis)
        let ref_dir = ref_to_step(self.ref_direction)
        f"AXIS2_PLACEMENT_3D({step_str(self.name)},{loc}, {ax}, {ref_dir})"
    }
}

// Represents a BLOCK entity (CSG primitive).
// Example:
//   BLOCK('name', #10, 10.0, 20.0, 30.0)
pub struct Block {
    pub name: String
    pub position: Ref
    pub x: f64
    pub y: f64
    pub z: f64
}

impl Block {
    pub fn new(name: String, position: Ref, x: f64, y: f64, z: f64) -> Block {
        Block { name: name, position: position, x: x, y: y, z: z }
    }
}

impl Entity for Block {
    fn to_step(self) -> String {
        let pos_str = f"#{self.position.id.value}"
        f"BLOCK({step_str(self.name)},{pos_str},{fmt_num(self.x)},{fmt_num(self.y)},{fmt_num(self.z)})"
    }
}

// Represents a BOOLEAN_OPERATOR enumeration in STEP.
pub enum BooleanOperator {
    Union
    Intersection
    Difference
}

impl Entity for BooleanOperator {
    fn to_step(self) -> String {
        match self {
            BooleanOperator::Union => ".UNION."
            BooleanOperator::Intersection => ".INTERSECTION."
            BooleanOperator::Difference => ".DIFFERENCE."
        }
    }
}

impl BooleanOperator {
    pub fn from_string(s: String) -> Option<BooleanOperator> {
        match s {
            ".UNION." => Some(BooleanOperator::Union)
            ".INTERSECTION." => Some(BooleanOperator::Intersection)
            ".DIFFERENCE." => Some(BooleanOperator::Difference)
            _ => None
        }
    }
}

// Represents a BOOLEAN_RESULT entity.
// Example:
//   BOOLEAN_RESULT('name', .UNION., #10, #20)
pub struct BooleanResult {
    pub name: String
    pub operator: BooleanOperator
    pub first_operand: Ref
    pub second_operand: Ref
}

impl BooleanResult {
    pub fn new(name: String, operator: BooleanOperator, first_operand: Ref, second_operand: Ref) -> BooleanResult {
        BooleanResult { name: name, operator: operator, first_operand: first_operand, second_operand: second_operand }
    }
}

impl Entity for BooleanResult {
    fn to_step(self) -> String {
        let op_str = self.operator.to_step()
        let op1_str = f"#{self.first_operand.id.value}"
        let op2_str = f"#{self.second_operand.id.value}"
        f"BOOLEAN_RESULT({step_str(self.name)},{op_str},{op1_str},{op2_str})"
    }
}

// Represents a B_SPLINE_CURVE entity.
// Example:
//   B_SPLINE_CURVE('name', 3, (#10, #11, #12, #13), .UNSPECIFIED., .F., .F.)
pub struct BSplineCurve {
    pub name: String
    pub degree: i64
    pub control_points: Vec<Ref>
    pub curve_form: String
    pub closed_curve: bool
    pub self_intersect: bool
}

impl BSplineCurve {
    pub fn new(name: String, degree: i64, control_points: Vec<Ref>, curve_form: String, closed_curve: bool, self_intersect: bool) -> BSplineCurve {
        BSplineCurve { name: name, degree: degree, control_points: control_points, curve_form: curve_form, closed_curve: closed_curve, self_intersect: self_intersect }
    }
}

impl Entity for BSplineCurve {
    fn to_step(self) -> String {
        let cps_str = self.control_points.map(|r| { f"#{r.id.value}" }).join(",")
        let closed_str = bool_to_step(self.closed_curve)
        let si_str = bool_to_step(self.self_intersect)
        f"B_SPLINE_CURVE({step_str_or_dollar(self.name)},{self.degree},({cps_str}),{self.curve_form},{closed_str},{si_str})"
    }
}

// Represents a B_SPLINE_CURVE_WITH_KNOTS entity.
// Example from MachineContactMedium.step:
//   B_SPLINE_CURVE_WITH_KNOTS('',3,(#875,#876,...),.UNSPECIFIED.,.F.,.F.,(4,3,...),(0.,...),.UNSPECIFIED.)
//
// Notes:
// - We store knot values as raw strings to preserve STEP formatting.
// - Control points are currently typed as UnknownEntity refs.
pub struct BSplineCurveWithKnots {
    pub name: String
    pub degree: i64
    pub control_points: Vec<Ref>
    pub curve_form: String
    pub closed_curve: bool
    pub self_intersect: bool
    pub knot_multiplicities: Vec<i64>
    pub knots: Vec<String>
    pub knot_spec: String
}

impl BSplineCurveWithKnots {
    pub fn new(name: String, degree: i64, control_points: Vec<Ref>, curve_form: String, closed_curve: bool, self_intersect: bool, knot_multiplicities: Vec<i64>, knots: Vec<String>, knot_spec: String) -> BSplineCurveWithKnots {
        BSplineCurveWithKnots { name: name, degree: degree, control_points: control_points, curve_form: curve_form, closed_curve: closed_curve, self_intersect: self_intersect, knot_multiplicities: knot_multiplicities, knots: knots, knot_spec: knot_spec }
    }
}

impl Entity for BSplineCurveWithKnots {
    fn to_step(self) -> String {
        let cps_str = self.control_points.map(|r| { f"#{r.id.value}" }).join(",")
        let mults_str = self.knot_multiplicities.map(|i| { f"{i}" }).join(",")
        let knots_str = self.knots.join(",")
        let closed_str = bool_to_step(self.closed_curve)
        let si_str = bool_to_step(self.self_intersect)
        f"B_SPLINE_CURVE_WITH_KNOTS({step_str_or_dollar(self.name)},{self.degree},({cps_str}),{self.curve_form},{closed_str},{si_str},({mults_str}),({knots_str}),{self.knot_spec})"
    }
}

// Represents a B_SPLINE_SURFACE_WITH_KNOTS entity.
// In STEP Part 21 files this most commonly appears as a part of a complex
// instance together with B_SPLINE_SURFACE and (optionally) RATIONAL_B_SPLINE_SURFACE.
// Example (from MachineContactMedium.step):
//   B_SPLINE_SURFACE_WITH_KNOTS((3,3),(3,2,3),(-0.16,...),(-3.14,...),.UNSPECIFIED.)
//
// Notes:
// - We store knot values as raw strings to preserve STEP formatting.
pub struct BSplineSurfaceWithKnots {
    pub u_multiplicities: Vec<i64>
    pub v_multiplicities: Vec<i64>
    pub u_knots: Vec<String>
    pub v_knots: Vec<String>
    pub knot_spec: String
}

impl BSplineSurfaceWithKnots {
    pub fn new(u_multiplicities: Vec<i64>, v_multiplicities: Vec<i64>, u_knots: Vec<String>, v_knots: Vec<String>, knot_spec: String) -> BSplineSurfaceWithKnots {
        BSplineSurfaceWithKnots { u_multiplicities: u_multiplicities, v_multiplicities: v_multiplicities, u_knots: u_knots, v_knots: v_knots, knot_spec: knot_spec }
    }
}

impl Entity for BSplineSurfaceWithKnots {
    fn to_step(self) -> String {
        let u_mults_str = self.u_multiplicities.map(|i| { f"{i}" }).join(",")
        let v_mults_str = self.v_multiplicities.map(|i| { f"{i}" }).join(",")
        let u_knots_str = self.u_knots.join(",")
        let v_knots_str = self.v_knots.join(",")
        f"B_SPLINE_SURFACE_WITH_KNOTS(({u_mults_str}),({v_mults_str}),({u_knots_str}),({v_knots_str}),{self.knot_spec})"
    }
}

// Represents a B_SPLINE_SURFACE entity.
// Common form (as part of a complex surface instance):
//   B_SPLINE_SURFACE(2,2,((#1,#2,#3),(#4,#5,#6)),.UNSPECIFIED.,.F.,.F.,.F.)
//
// Notes:
// - Control points are stored as UnknownEntity refs.
pub struct BSplineSurface {
    pub u_degree: i64
    pub v_degree: i64
    pub control_points_list: Vec<Vec<Ref>>
    pub surface_form: String
    pub u_closed: bool
    pub v_closed: bool
    pub self_intersect: bool
}

impl BSplineSurface {
    pub fn new(u_degree: i64, v_degree: i64, control_points_list: Vec<Vec<Ref>>, surface_form: String, u_closed: bool, v_closed: bool, self_intersect: bool) -> BSplineSurface {
        BSplineSurface { u_degree: u_degree, v_degree: v_degree, control_points_list: control_points_list, surface_form: surface_form, u_closed: u_closed, v_closed: v_closed, self_intersect: self_intersect }
    }
}

impl Entity for BSplineSurface {
    fn to_step(self) -> String {
        let row_strs = self.control_points_list
            .map(|row| {
                let cps_str = row.map(|r| { f"#{r.id.value}" }).join(",")
                f"({cps_str})"
            })
            .join(",")
        let u_closed_str = bool_to_step(self.u_closed)
        let v_closed_str = bool_to_step(self.v_closed)
        let si_str = bool_to_step(self.self_intersect)
        f"B_SPLINE_SURFACE({self.u_degree},{self.v_degree},({row_strs}),{self.surface_form},{u_closed_str},{v_closed_str},{si_str})"
    }
}

// Represents a CARTESIAN_POINT entity.
