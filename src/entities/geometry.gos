// Represents a PLANE entity.
pub struct Plane {
    pub name: String
    pub position: Ref
}

impl Plane {
    pub fn new(name: String, position: Ref) -> Plane {
        Plane { name: name, position: position }
    }
}

impl Entity for Plane {
    fn to_step(self) -> String {
        let pos = f"#{self.position.id.value}"
        f"PLANE({step_str(self.name)},{pos})"
    }
}

// Represents a POLYLINE entity.
// Example:
//   POLYLINE('name', (#10, #20, #30))
pub struct Polyline {
    pub name: String
    pub points: Vec<Ref>
}

impl Polyline {
    pub fn new(name: String, points: Vec<Ref>) -> Polyline {
        Polyline { name: name, points: points }
    }
}

impl Entity for Polyline {
    fn to_step(self) -> String {
        let pts_str = self.points.map(|r| { f"#{r.id.value}" }).join(",")
        f"POLYLINE({step_str(self.name)},({pts_str}))"
    }
}

// Represents a RATIONAL_B_SPLINE_SURFACE entity.
// Common form (as part of a complex surface instance):
//   RATIONAL_B_SPLINE_SURFACE(((1.,0.7,1.),( ... ),( ... )))
//
// Notes:
// - We store weights as raw strings to preserve STEP formatting.
pub struct RationalBSplineSurface {
    pub weights: Vec<Vec<String>>
}

impl RationalBSplineSurface {
    pub fn new(weights: Vec<Vec<String>>) -> RationalBSplineSurface {
        RationalBSplineSurface { weights: weights }
    }
}

impl Entity for RationalBSplineSurface {
    fn to_step(self) -> String {
        let row_strs = self.weights
            .map(|row| {
                let r = row.join(",")
                f"({r})"
            })
            .join(",")
        f"RATIONAL_B_SPLINE_SURFACE(({row_strs}))"
    }
}

// Represents a RATIONAL_B_SPLINE_CURVE entity.
// Common form (as part of a complex curve instance):
//   RATIONAL_B_SPLINE_CURVE((1.,1.,1.,1.))
//
// Notes:
// - We store weights as raw strings to preserve STEP formatting.
pub struct RationalBSplineCurve {
    pub weights: Vec<String>
}

impl RationalBSplineCurve {
    pub fn new(weights: Vec<String>) -> RationalBSplineCurve {
        RationalBSplineCurve { weights: weights }
    }
}

impl Entity for RationalBSplineCurve {
    fn to_step(self) -> String {
        let weights_str = self.weights.join(",")
        f"RATIONAL_B_SPLINE_CURVE(({weights_str}))"
    }
}

// Represents a RECTANGULAR_TRIMMED_SURFACE entity.
