pub struct RectangularTrimmedSurface {
    pub name: String
    pub basis_surface: Ref
    pub u1: String
    pub u2: String
    pub v1: String
    pub v2: String
    pub usense: bool
    pub vsense: bool
}

impl RectangularTrimmedSurface {
