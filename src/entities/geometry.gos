    }
}

/// Serialize a boolean operator without cross-module trait dispatch.
///
/// `Union`/`Intersection`/`Difference` collide with other enums' variants,
/// which makes runtime method lookup ambiguous outside this module.
pub fn boolean_operator_to_step(v: BooleanOperator) -> String {
    match v {
        BooleanOperator::Union => ".UNION."
        BooleanOperator::Intersection => ".INTERSECTION."
        BooleanOperator::Difference => ".DIFFERENCE."
    }
}
