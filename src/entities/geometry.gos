// Represents a transition_code enumeration in STEP.
pub enum TransitionCode {
    Discontinuous
    Continuous
    ContSameGradient
    ContSameGradientSameCurvature
}

impl Entity for TransitionCode {
    fn to_step(self) -> String {
        match self {
            TransitionCode::Discontinuous => ".DISCONTINUOUS."
            TransitionCode::Continuous => ".CONTINUOUS."
            TransitionCode::ContSameGradient => ".CONTSAMEGRADIENT."
            TransitionCode::ContSameGradientSameCurvature => ".CONTSAMEGRADIENTSAMECURVATURE."
        }
    }
}

impl TransitionCode {
    pub fn from_string(s: String) -> Option<TransitionCode> {
        match s {
            ".DISCONTINUOUS." => Some(TransitionCode::Discontinuous)
            ".CONTINUOUS." => Some(TransitionCode::Continuous)
            ".CONTSAMEGRADIENT." => Some(TransitionCode::ContSameGradient)
            ".CONTSAMEGRADIENTSAMECURVATURE." => Some(TransitionCode::ContSameGradientSameCurvature)
            _ => None
        }
    }
}

// Represents a COMPOSITE_CURVE_SEGMENT entity.
// Example:
//   COMPOSITE_CURVE_SEGMENT(.CONTINUOUS., .T., #10)
// where #10 is a curve.
pub struct CompositeCurveSegment {
    pub transition: TransitionCode
    pub same_sense: bool
    pub parent_curve: Ref
}

impl CompositeCurveSegment {
    pub fn new(transition: TransitionCode, same_sense: bool, parent_curve: Ref) -> CompositeCurveSegment {
        CompositeCurveSegment { transition: transition, same_sense: same_sense, parent_curve: parent_curve }
    }
}

impl Entity for CompositeCurveSegment {
    fn to_step(self) -> String {
        let trans_str = self.transition.to_step()
        let sense_str = bool_to_step(self.same_sense)
        let curve_str = f"#{self.parent_curve.id.value}"
        f"COMPOSITE_CURVE_SEGMENT({trans_str},{sense_str},{curve_str})"
    }
}

// Represents a COMPOSITE_CURVE entity.
// Example:
//   COMPOSITE_CURVE('name', (#10, #20), .F.)
// where #10, #20 are COMPOSITE_CURVE_SEGMENTs.
pub struct CompositeCurve {
    pub name: String
    pub segments: Vec<Ref>
    pub self_intersect: bool
}

impl CompositeCurve {
    pub fn new(name: String, segments: Vec<Ref>, self_intersect: bool) -> CompositeCurve {
        CompositeCurve { name: name, segments: segments, self_intersect: self_intersect }
    }
}

impl Entity for CompositeCurve {
    fn to_step(self) -> String {
        let segments_str = self.segments.map(|r| { f"#{r.id.value}" }).join(",")
        let si_str = bool_to_step(self.self_intersect)
        f"COMPOSITE_CURVE({step_str(self.name)},({segments_str}),{si_str})"
    }
}

