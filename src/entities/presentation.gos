    pub name: String
    pub items: Vec<Ref>
    pub context: Ref
}

impl MechanicalDesignGeometricPresentationRepresentation {
    pub fn new(name: String, items: Vec<Ref>, context: Ref) -> MechanicalDesignGeometricPresentationRepresentation {
        MechanicalDesignGeometricPresentationRepresentation { name: name, items: items, context: context }
    }
}

impl Entity for MechanicalDesignGeometricPresentationRepresentation {
    fn to_step(self) -> String {
        let items_str = self.items.map(|r| { f"#{r.id.value}" }).join(",")
        let ctx = f"#{self.context.id.value}"
        f"MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION({step_str(self.name)},({items_str}),{ctx})"
    }
}

