//! STEP entity models: presentation family.
//!
//! Ported 1:1 from the reference implementation; the
//! serialization (including spacing quirks) is the contract.

use crate::entity::Entity
use crate::fmt::{fmt_num, step_str}
use crate::ids::{Ref}

fn step_str_or_dollar(s: String) -> String {
    if s == "$" { "$" } else { step_str(s) }
}

fn bool_to_step(b: bool) -> String {
    if b { ".T." } else { ".F." }
}

// Represents an ANNOTATION_OCCURRENCE entity.
// Example:
//   ANNOTATION_OCCURRENCE('name', (#10), #20)
// where #10 is a style assignment and #20 is the item.
pub struct AnnotationOccurrence {
    pub name: String
    pub styles: Vec<Ref>
    pub item: Ref
}

impl AnnotationOccurrence {
    pub fn new(name: String, styles: Vec<Ref>, item: Ref) -> AnnotationOccurrence {
        AnnotationOccurrence { name: name, styles: styles, item: item }
    }
}

impl Entity for AnnotationOccurrence {
    fn to_step(self) -> String {
        let styles_str = self.styles.map(|r| { f"#{r.id.value}" }).join(",")
        let item_str = f"#{self.item.id.value}"
        f"ANNOTATION_OCCURRENCE({step_str(self.name)},({styles_str}),{item_str})"
    }
}

// Represents a COLOUR_RGB entity.
pub struct ColorRgb {
    pub name: String
    pub red: f64
    pub green: f64
    pub blue: f64
}

impl ColorRgb {
    pub fn new(name: String, red: f64, green: f64, blue: f64) -> ColorRgb {
        ColorRgb { name: name, red: red, green: green, blue: blue }
    }
}

impl Entity for ColorRgb {
    fn to_step(self) -> String {
        f"COLOUR_RGB({step_str(self.name)},{fmt_num(self.red)},{fmt_num(self.green)},{fmt_num(self.blue)})"
    }
}

