    }
}

// Represents a text_path enumeration in STEP.
pub enum TextPath {
    Left
    Right
    Up
    Down
}

impl Entity for TextPath {
    fn to_step(self) -> String {
        match self {
            TextPath::Left => ".LEFT."
            TextPath::Right => ".RIGHT."
            TextPath::Up => ".UP."
            TextPath::Down => ".DOWN."
        }
    }
}

impl TextPath {
    pub fn from_string(s: String) -> Option<TextPath> {
        match s {
            ".LEFT." => Some(TextPath::Left)
            ".RIGHT." => Some(TextPath::Right)
            ".UP." => Some(TextPath::Up)
            ".DOWN." => Some(TextPath::Down)
            _ => None
        }
    }
}

// Represents a TEXT_LITERAL entity.
// Example:
//   TEXT_LITERAL('name', 'literal', #10, 'alignment', .RIGHT., #20)
pub struct TextLiteral {
    pub name: String
    pub literal: String
    pub placement: Ref
    pub alignment: String
    pub path: TextPath
    pub font: Ref
}

impl TextLiteral {
    pub fn new(name: String, literal: String, placement: Ref, alignment: String, path: TextPath, font: Ref) -> TextLiteral {
        TextLiteral { name: name, literal: literal, placement: placement, alignment: alignment, path: path, font: font }
    }
}

impl Entity for TextLiteral {
    fn to_step(self) -> String {
        let placement_str = f"#{self.placement.id.value}"
        let path_str = self.path.to_step()
        let font_str = f"#{self.font.id.value}"
        f"TEXT_LITERAL({step_str(self.name)},{step_str(self.literal)},{placement_str},{step_str(self.alignment)},{path_str},{font_str})"
    }
}

/// Serialize a text path without cross-module trait dispatch.
pub fn text_path_to_step(v: TextPath) -> String {
    match v {
        TextPath::Left => ".LEFT."
        TextPath::Right => ".RIGHT."
        TextPath::Up => ".UP."
        TextPath::Down => ".DOWN."
    }
}
