pub struct HiddenElementOverRidingStyledItem {
    pub name: String
    pub styles: Vec<Ref>
    pub item: Ref
    pub over_ridden_styled_item: Ref
}

impl HiddenElementOverRidingStyledItem {
    pub fn new(name: String, styles: Vec<Ref>, item: Ref, over_ridden_styled_item: Ref) -> HiddenElementOverRidingStyledItem {
        HiddenElementOverRidingStyledItem { name: name, styles: styles, item: item, over_ridden_styled_item: over_ridden_styled_item }
    }
}

impl Entity for HiddenElementOverRidingStyledItem {
    fn to_step(self) -> String {
        let styles_str = self.styles.map(|r| { f"#{r.id.value}" }).join(",")
        let item_str = f"#{self.item.id.value}"
        let over_str = f"#{self.over_ridden_styled_item.id.value}"
        f"HIDDEN_ELEMENT_OVER_RIDING_STYLED_ITEM({step_str(self.name)},({styles_str}),{item_str},{over_str})"
    }
}

// Represents a MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION entity.
// This is part of the presentation representation context in many STEP files.
