//! 04-parametric-washer-kit — a parametric washer.

use std::env
use std::process

use step

fn run() -> Result<(), step::Error> {
    let spec = {
        "id": step::opt_double(5.0, help: "Inner diameter (mm)", min: Some(0.0), min_exclusive: true)
        "od": step::opt_double(15.0, help: "Outer diameter (mm)", min: Some(0.0), min_exclusive: true)
        "thickness": step::opt_double(2.0, help: "Thickness (mm)", min: Some(0.0), min_exclusive: true)
        "segments": step::opt_int(64, help: "Circle segments (smoothness)", min: Some(3))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write STEP output to a file (default: stdout)")
    }
    let args = match step::parse_args(step::with_translate(spec), "04-parametric-washer-kit", "Generate a parametric washer.", env::args()) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let id = args.double_or("id", 5.0)
    let od = args.double_or("od", 15.0)
    let thickness = args.double_or("thickness", 2.0)
    let segments = args.int_or("segments", 64)
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }
    let outer = step::circle(od, segments)
    let mut hole = step::circle(id, segments)
    let mut rev = #[]
    let mut i = hole.len() as i64 - 1
    while i >= 0 {
        rev.push(hole[i])
        i -= 1
    }
    hole = rev
    let washer = step::extrude(step::profile(outer).add_hole(hole), thickness)
        .named("washer")
        .colored(step::BLUE)
        .moved(tx, ty, tz)
    let design = step::design(name: "parametric-washer", documentation: args.documentation()).add(washer)
    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
