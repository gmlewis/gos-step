//! 15-metric-threaded-rod-nut
//!
//! A working example that generates a STEP model for a nut-like coupler body
//! with modeled internal threads and correct clearances.
//!
//! Usage (stdout):
//!   ./run-example.sh 15 --boltDiameter 8 --clearance 0.1 > nut-strip.step

use std::env
use std::math
use std::process

use step

fn reverse(pts: Vec<(f64, f64)>) -> Vec<(f64, f64)> {
    let mut out = #[]
    let mut i = pts.len() as i64 - 1
    while i >= 0 {
        out.push(pts[i])
        i -= 1
    }
    out
}

fn run() -> Result<(), step::Error> {
    let spec = {
        "boltDiameter": step::opt_double(8.0, help: "Nominal bolt diameter (mm)", min: Some(1.0))
        "clearance": step::opt_double(0.1, help: "Base clearance (mm)", min: Some(0.0))
        "interference": step::opt_double(0.0, help: "Base interference (mm)", min: Some(0.0))
        "stepCount": step::opt_double(5.0, help: "Number of test steps", min: Some(1.0))
        "clearanceStep": step::opt_double(0.05, help: "Clearance increment per step (mm)")
        "holeSpacing": step::opt_double(20.0, help: "Spacing between holes (mm)", min: Some(5.0))
        "mountThickness": step::opt_double(5.0, help: "Thickness of the base plate (mm)", min: Some(1.0))
        "nutHeight": step::opt_double(0.0, help: "Height of the nut (0 for standard)", min: Some(0.0))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }
    let args = match step::parse_args(
        step::with_translate(spec)
        "15-metric-threaded-rod-nut"
        "Generate a metric threaded rod nut test strip."
        env::args()
    ) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let bolt_diameter = args.double_or("boltDiameter", 8.0)
    let clearance = args.double_or("clearance", 0.1)
    let interference = args.double_or("interference", 0.0)
    let step_count = args.double_or("stepCount", 5.0) as i64
    let clearance_step = args.double_or("clearanceStep", 0.05)
    let hole_spacing = args.double_or("holeSpacing", 20.0)
    let mount_thickness = args.double_or("mountThickness", 5.0)
    let nut_height_opt = args.double_or("nutHeight", 0.0)
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            return Ok(())
        }
    }
    let nut_height = if nut_height_opt > 0.0 {
        Some(nut_height_opt)
    } else {
        None
    }
    let nodes = metric_nut_test_strip(
        bolt_diameter
        clearance
        interference
        step_count
        clearance_step
        hole_spacing
        mount_thickness
        nut_height
    )
    let mut design = step::design(name: "metric-threaded-rod-nut", documentation: args.documentation())
    for node in nodes {
        design = design.add(node.moved(tx, ty, tz))
    }
    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(_) => design.write_blender_python(bpy_path)?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn metric_nut_test_strip(
    bolt_diameter: f64
    base_clearance: f64
    base_interference: f64
    step_count: i64
    clearance_step: f64
    hole_spacing: f64
    mount_thickness: f64
    nut_height: Option<f64>
) -> Vec<step::SceneNode> {
    let s, h = metric_nut_dimensions(bolt_diameter)
    let nut_h = nut_height.unwrap_or(h)
    let total_length = step_count as f64 * hole_spacing
    let base_width = s + 10.0
    let base = step::cuboid(total_length, base_width, mount_thickness)
        .named("base")
        .colored(step::CYAN)
        .moved(0.0, -base_width / 2.0, 0.0)
    let mut nodes: Vec<step::SceneNode> = #[base]
    let mut i: i64 = 0
    while i < step_count {
        let current_clearance = -base_interference + i as f64 * clearance_step + base_clearance
        let x = i as f64 * hole_spacing + hole_spacing / 2.0
        let nut_nodes = metric_nut(
            bolt_diameter
            current_clearance
            height: Some(nut_h)
            name_prefix: f"nut-{i}"
        )
        for node in nut_nodes {
            nodes.push(node.moved(x, 0.0, mount_thickness))
        }
        i += 1
    }
    nodes
}

fn metric_nut_dimensions(bolt_diameter: f64) -> (f64, f64) {
    if bolt_diameter <= 3.0 {
        (5.5, 2.4)
    } else if bolt_diameter <= 4.0 {
        (7.0, 3.2)
    } else if bolt_diameter <= 5.0 {
        (8.0, 4.0)
    } else if bolt_diameter <= 6.0 {
        (10.0, 5.0)
    } else if bolt_diameter <= 8.0 {
        (13.0, 6.5)
    } else if bolt_diameter <= 10.0 {
        (17.0, 8.0)
    } else if bolt_diameter <= 12.0 {
        (19.0, 10.0)
    } else {
        // Heuristic for larger bolts: S approx 1.7 * D, H approx 0.8 * D
        (bolt_diameter * 1.7, bolt_diameter * 0.8)
    }
}

// metric_thread_pitch returns the coarse metric pitch for a nominal diameter.
fn metric_thread_pitch(bolt_diameter: f64) -> f64 {
    if bolt_diameter <= 3.0 {
        0.5
    } else if bolt_diameter <= 4.0 {
        0.7
    } else if bolt_diameter <= 5.0 {
        0.8
    } else if bolt_diameter <= 6.0 {
        1.0
    } else if bolt_diameter <= 8.0 {
        1.25
    } else if bolt_diameter <= 10.0 {
        1.5
    } else if bolt_diameter <= 12.0 {
        1.75
    } else if bolt_diameter <= 16.0 {
        2.0
    } else {
        bolt_diameter * 0.125
    }
}

// metric_nut returns the hex body plus a helical internal-thread ridge.
//
// The bore is at the thread root (major diameter). The ridge is a solid swept
// along a right-hand helix: its crest sits at the minor diameter and its root
// is embedded `embed` into the bore wall, so the two bodies fuse when printed.
fn metric_nut(
    bolt_diameter: f64
    clearance: f64
    height: Option<f64> = None
    name_prefix: String = "nut"
) -> Vec<step::SceneNode> {
    let s, h = metric_nut_dimensions(bolt_diameter)
    let height = height.unwrap_or(h)
    let pitch = metric_thread_pitch(bolt_diameter)
    let major_d = bolt_diameter + clearance
    // ISO 68-1 basic profile: 60-degree flanks and an internal radial thread
    // depth of H1 = 0.54125 * pitch. The ridge is a trapezoid whose crest is
    // P/4 wide at the minor diameter and whose root is 7P/8 wide at the major
    // diameter, leaving the standard P/8 groove at the root.
    let depth = 0.54125 * pitch
    let half_depth = depth / 2.0
    let crest_half = 0.125 * pitch
    let root_half = 0.4375 * pitch
    let minor_d = major_d - 2.0 * depth
    let d = s / math::cos(30.0 * math::PI / 180.0)
    let outer = step::polygon(6, d, 30.0)
    let hole = reverse(step::circle(major_d))
    let body = step::extrude(step::profile(outer).add_hole(hole), height)
        .named(name_prefix)
        .colored(step::ORANGE)
    // Thread ridge cross-section in the radial-axial plane: a trapezoid with the
    // crest (inner radius) on the left and the root (outer radius) on the right.
    let r_major = major_d / 2.0
    let r_minor = minor_d / 2.0
    let r_mid = (r_major + r_minor) / 2.0
    let embed = 0.1
    let profile = step::sweep_profile(#[
        (-half_depth, 0.0, -crest_half)
        (half_depth + embed, 0.0, -root_half)
        (half_depth + embed, 0.0, root_half)
        (-half_depth, 0.0, crest_half)
    ])
    // Leave half a pitch at each end so the ridge does not stick out of the nut.
    let thread_turns = (height - pitch) / pitch
    if thread_turns <= 0.0 {
        return #[body]
    }
    let path = step::helix_path(
        pos: (0.0, 0.0, pitch / 2.0)
        size_per_turn: (r_mid, r_mid, pitch)
        num_turns: thread_turns
        num_segs_per_turn: 32
        start_angle: 0.0
        clockwise: false
    )
    // The thread ridge must follow the helical path.
    let thread = step::sweep(path, profile, straight_outline: false)
        .named(name_prefix + "-thread")
        .colored(step::RED)
    #[body, thread]
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
