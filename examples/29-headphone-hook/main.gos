//! 29-headphone-hook — a parametric wall-mounted headphone hook.
//!
//! Usage: ./run-example.sh 29 --width 40 --armLength 80 > hook.step

use std::env
use std::math
use std::process

use step
use step::Face::{Top}

fn main_hook_body(
    width: f64
    arm_l: f64
    hook_h: f64
    mount_h: f64
    t: f64
    r: f64
) -> step::SceneNode {
    let mut pts = #[]
    pts.push((0.0, 0.0))
    pts.push((arm_l, 0.0))
    pts.push((arm_l, hook_h))
    pts.push((arm_l - t, hook_h))
    let c2 = (arm_l - t - r, t + r)
    let arc2 = step::arc(2.0 * r, 0.0, -0.5 * math::PI, segments: 8)
    for p in arc2 {
        pts.push((p.0 + c2.0, p.1 + c2.1))
    }
    let c1 = (t + r, t + r)
    let arc1 = step::arc(2.0 * r, 1.5 * math::PI, math::PI, segments: 8)
    for p in arc1 {
        pts.push((p.0 + c1.0, p.1 + c1.1))
    }
    pts.push((t, mount_h))
    pts.push((0.0, mount_h))
    step::extrude(step::profile(pts), width)
        .named("headphone-hook")
        .colored(step::rgb(0.4, 0.2, 0.6))
}

fn reinforcing_rib(mount_h: f64, t: f64, rib_t: f64) -> step::SceneNode {
    let profile = #[
        (t, t)
        (t + mount_h * 0.5, t)
        (t, t + mount_h * 0.5)
    ]
    step::extrude(step::profile(profile), rib_t)
        .named("rib")
        .colored(step::rgb(0.3, 0.1, 0.5))
}

fn run() -> Result<(), step::Error> {
    let spec = {
        "width": step::opt_double(30.0, help: "Width of the hook (mm)", min: Some(10.0))
        "armLength": step::opt_double(60.0, help: "Length of the horizontal arm (mm)", min: Some(20.0))
        "hookHeight": step::opt_double(25.0, help: "Height of the front retaining lip (mm)", min: Some(10.0))
        "mountHeight": step::opt_double(50.0, help: "Height of the mounting plate (mm)", min: Some(20.0))
        "thickness": step::opt_double(6.0, help: "Main material thickness (mm)", min: Some(2.0))
        "filletRadius": step::opt_double(8.0, help: "Radius of the inner fillets (mm)", min: Some(0.0))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }

    let args = match step::parse_args(
        step::with_translate(spec)
        "29-headphone-hook"
        "Generate a parametric headphone hook."
        env::args()
    ) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }

    let width = args.double_or("width", 30.0)
    let arm_l = args.double_or("armLength", 60.0)
    let hook_h = args.double_or("hookHeight", 25.0)
    let mount_h = args.double_or("mountHeight", 50.0)
    let t = args.double_or("thickness", 6.0)
    let r = args.double_or("filletRadius", 8.0)
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }

    // Create the main hook body.
    let hook = main_hook_body(width, arm_l, hook_h, mount_h, t, r).turned_x(90.0)

    // Add a reinforcing rib in the middle.
    let rib_t = t / 2.0
    let rib = reinforcing_rib(mount_h, t, rib_t)
        .turned_x(90.0)
        .moved(0.0, -(width - rib_t) / 2.0, 0.0)

    // Add branding text on the side face.
    let font = step::load_font("baloo")?
    let design = step::design(name: "headphone-hook", documentation: args.documentation())
        .add(hook)
        .add(rib)
        .add_text_on_face(
            hook
            "STUDIO"
            Top
            font
            font_size: Some(t * 0.8)
            offset_x: t / 2.0
            offset_y: t / 2.0 - mount_h / 2.0
            color: step::ORANGE
        )
        .moved(tx, ty, tz)

    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
