//! 20-arduino-shield-standoff-frame — a standoff frame that supports stacked
//! boards with computed clearances.
//!
//! Usage: gos run examples/20-arduino-shield-standoff-frame/main.gos --standoffHeight 10 > arduino-frame.step

use std::env
use std::process

use step

fn arduino_uno_standoff_frame(
    frame_thickness: f64
    standoff_height: f64
    standoff_diameter: f64
    standoff_hole_diameter: f64
) -> Vec<step::SceneNode> {
    let uno_w = 68.6
    let uno_l = 53.3

    // Increase frame size slightly to support standoffs centered 2.5mm from edge
    let margin = standoff_diameter / 2.0 - 1.5 // Ensure at least 1mm outer support
    let m = if margin < 2.0 { 2.0 } else { margin }
    let width = uno_w + 2.0 * m
    let length = uno_l + 2.0 * m

    // Rail width should be enough to cover the standoff
    let rail_w = standoff_diameter + 2.0
    let outer = step::rounded_rect(width, length, 3.0)
    let mut inner = #[]
    for p in step::rounded_rect(width - 2.0 * rail_w, length - 2.0 * rail_w, 2.0) {
        inner.push((p.0 + rail_w, p.1 + rail_w))
    }
    let inner = inner.rev()
    let base_frame = step::extrude(step::profile(outer).add_hole(inner), frame_thickness)
        .named("frame")
        .colored(step::BLUE)
        .moved(-m, -m, 0.0)
    let mut nodes = #[base_frame]

    // Arduino Uno standard hole pattern (approximate mm from bottom-left corner of board)
    let hole_locs = #[
        (14.0, 2.5)
        (15.3, 50.8)
        (66.1, 7.6)
        (66.1, 35.6)
    ]
    for loc in hole_locs {
        let hx, hy = loc
        let standoff = step::tube(standoff_diameter, standoff_hole_diameter, standoff_height)
            .named("standoff-{i}")
            .colored(step::CYAN)
            .moved(hx, hy, frame_thickness)
        nodes.push(standoff)
    }
    nodes
}

fn run() -> Result<(), step::Error> {
    let spec = {
        "frameThickness": step::opt_double(3.0, help: "Thickness of the base frame (mm)", min: Some(1.0))
        "standoffHeight": step::opt_double(10.0, help: "Height of the standoffs (mm)", min: Some(1.0))
        "standoffOD": step::opt_double(6.0, help: "Outer diameter of standoffs (mm)", min: Some(1.0))
        "standoffID": step::opt_double(3.2, help: "Inner hole diameter of standoffs (mm)", min: Some(0.5))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }
    let args = match step::parse_args(
        step::with_translate(spec)
        "20-arduino-shield-standoff-frame"
        "Generate an Arduino Uno standoff frame STEP model."
        env::args()
    ) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let frame_thickness = match args.double("frameThickness") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let standoff_height = match args.double("standoffHeight") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let standoff_od = match args.double("standoffOD") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let standoff_id = match args.double("standoffID") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }
    let nodes = arduino_uno_standoff_frame(frame_thickness, standoff_height, standoff_od, standoff_id)
    let mut design = step::design(name: "arduino-standoff-frame", documentation: args.documentation())
    for node in nodes {
        // Center the board area approximately
        design = design.add(node.moved(tx - 68.6 / 2.0, ty - 53.3 / 2.0, tz))
    }

    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
