//! 14-bolt-length-gauge — a physical "ruler" for bolts that includes embossed
//! size markings and 5 mm/10 mm scribed tick marks on the top face.
//!
//! Usage: gos run examples/14-bolt-length-gauge/main.gos > gauge.step

use std::env
use std::process

use step
use step::Face::{Top}

fn run() -> Result<(), step::Error> {
    let spec = {
        "length": step::opt_double(100.0, help: "Length of the gauge (mm)", min: Some(50.0))
        "width": step::opt_double(50.0, help: "Width of the gauge (mm)", min: Some(20.0))
        "height": step::opt_double(10.0, help: "Height of the gauge (mm)", min: Some(5.0))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }
    let args = match step::parse_args(
        step::with_translate(spec)
        "14-bolt-length-gauge"
        "Generate a bolt length gauge."
        env::args()
    ) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let length = match args.double("length") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let width = match args.double("width") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let height = match args.double("height") {
        Ok(n) => n.value
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }

    //
    let bolt_sizes = #[
        ("M3", 3.4)
        ("M4", 4.4)
        ("M5", 5.4)
        ("M6", 6.4)
        ("M8", 8.4)
    ]
    let slot_width = 10.0
    let font = step::font("baloo")?
    let scribe_depth = 0.5
    let scribe_width = 0.8

    // 1. Through-holes shared by both layers (ruler slot and bolt holes).
    let mut through_holes = #[]

    // Ruler slot (as a through-hole)
    let slot_poly = #[
        (-slot_width / 2.0, 5.0)
        (slot_width / 2.0, 5.0)
        (slot_width / 2.0, length - 5.0)
        (-slot_width / 2.0, length - 5.0)
    ].rev() // must be CW
    through_holes.push(slot_poly)

    // Bolt holes
    let hole_spacing = length / (bolt_sizes.len() + 1) as f64
    for i in 0..bolt_sizes.len() {
        let _, dia = bolt_sizes[i]
        let hole_y = hole_spacing * (i + 1) as f64
        let hole_x = -width * 0.38
        let mut h = #[]
        for p in step::circle(dia) {
            h.push((p.0 + hole_x, p.1 + hole_y))
        }
        through_holes.push(h.rev())
    }

    // 2. Scribed tick slots on the top face, to the right of the numbers.
    // Deep notches every 10 mm match the labels; shallow ones every 5 mm sit
    // between them. The slots go through a thin top layer, so they are exactly
    // `scribe_depth` deep and expose the lower slab as their floor.
    let tick_x0 = width / 4.0 + 3.5
    let max_len = width / 2.0 - tick_x0 - 1.0
    let major_len = if max_len < 6.0 { max_len } else { 6.0 }
    let minor_len = major_len * 0.55
    let mut scribe_holes = #[]
    let steps = (length / 5.0) as i64
    for i in 1..steps {
        let y = i as f64 * 5.0
        if y > length - 2.0 {
            continue
        }
        let major = i % 2 == 0
        let len = if major { major_len } else { minor_len }
        if len <= 0.5 {
            continue
        }
        let x1 = tick_x0 + len
        scribe_holes.push(#[
            (tick_x0, y - scribe_width / 2.0)
            (x1, y - scribe_width / 2.0)
            (x1, y + scribe_width / 2.0)
            (tick_x0, y + scribe_width / 2.0)
        ].rev())
    }

    // 3. Lower slab plus a thin marking layer. The scribe slots are holes in the
    // marking layer only, so the marks are shallow face notches, not cut-outs.
    let mut outer = #[]
    for p in step::rect(width, length) {
        outer.push((p.0 - width / 2.0, p.1))
    }
    let lower = step::extrude(step::profile(outer).add_all_holes(through_holes), height - scribe_depth)
        .named("gauge-base")
        .colored(step::PURPLE)
    let mut top_holes = through_holes
    for h in scribe_holes {
        top_holes.push(h)
    }
    let top = step::extrude(step::profile(outer).add_all_holes(top_holes), scribe_depth)
        .named("gauge-marking-face")
        .colored(step::PURPLE)
        .moved(0.0, 0.0, height - scribe_depth)
    let mut design = step::design(name: "bolt-length-gauge", documentation: args.documentation())
        .add(lower)
        .add(top)

    // 4. Add labels
    for i in 0..bolt_sizes.len() {
        let name, _ = bolt_sizes[i]
        let hole_y = hole_spacing * (i + 1) as f64
        let hole_x = -width * 0.38

        // Place labels between the hole and the center slot
        // mid_y is length/2. We want it at hole_y.
        design = design.add_text_on_face(
            top
            name
            Top
            font
            font_size: Some(3.5)
            offset_x: hole_x + 8.2
            offset_y: hole_y - length / 2.0
        )
    }

    // 5. Add ruler markings
    for i in 1..=(length as i64 / 10 - 1) {
        let pos_y = (i * 10) as f64
        design = design.add_text_on_face(
            top
            f"{pos_y as i64}"
            Top
            font
            font_size: Some(3.5)
            offset_x: width / 4.0
            offset_y: pos_y - length / 2.0
        )
    }

    //
    design = design.moved(tx, ty, tz)

    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
