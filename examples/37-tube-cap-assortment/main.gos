//! 37-tube-cap-assortment — a parametric tube cap or plug.

use std::env
use std::process

use step

fn run() -> Result<(), step::Error> {
    let spec = {
        "diameter": step::opt_double(25.4, help: "Target tube diameter (mm)", min: Some(0.0), min_exclusive: true)
        "wall": step::opt_double(2.0, help: "Wall thickness of the cap/plug (mm)", min: Some(0.0), min_exclusive: true)
        "height": step::opt_double(15.0, help: "Height of the fitting part (mm)", min: Some(0.0), min_exclusive: true)
        "topThickness": step::opt_double(3.0, help: "Thickness of the cap top (mm)", min: Some(0.0), min_exclusive: true)
        "clearance": step::opt_double(0.2, help: "Radial clearance for the fit (mm)", min: Some(0.0))
        "type": step::opt_string(help: "Type of fitting: 'cap' (over tube) or 'plug' (inside tube)")
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }
    let args = match step::parse_args(step::with_translate(spec), "37-tube-cap-assortment", "Generate a parametric tube cap or plug.", env::args()) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let target_dia = args.double_or("diameter", 25.4)
    let wall = args.double_or("wall", 2.0)
    let fitting_height = args.double_or("height", 15.0)
    let top_thickness = args.double_or("topThickness", 3.0)
    let clearance = args.double_or("clearance", 0.2)
    let is_plug = args.string_opt("type").unwrap_or("cap") == "plug"
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }
    let fitting_od, fitting_id, top_dia = if is_plug {
        let f_od = target_dia - 2.0 * clearance
        (f_od, f_od - 2.0 * wall, target_dia + 2.0 * wall)
    } else {
        let f_id = target_dia + 2.0 * clearance
        (f_id + 2.0 * wall, f_id, f_id + 2.0 * wall)
    }
    let top = step::tube(top_dia, 0.0, top_thickness)
        .named("cap-top")
        .colored(step::ORANGE)
        .moved(tx, ty, tz + fitting_height)
    let wall_part = step::tube(fitting_od, fitting_id, fitting_height)
        .named("cap-wall")
        .colored(step::BLUE)
        .moved(tx, ty, tz)
    let design = step::design(name: "tube-cap", documentation: args.documentation())
        .add(top)
        .add(wall_part)
    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
