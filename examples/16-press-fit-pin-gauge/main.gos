//! 16-press-fit-pin-gauge — pins and holes that step through interference
//! values to calibrate press fits.

use std::env
use std::process

use step

/// Reverse a 2D loop.
fn rev_pts(pts: Vec<step::V2>) -> Vec<step::V2> {
    let mut out = #[]
    let mut i = pts.len() as i64 - 1
    while i >= 0 {
        out.push(pts[i])
        i -= 1
    }
    out
}

fn pin_gauge(
    pin_diameter: f64
    base_clearance: f64
    base_interference: f64
    step_count: i64
    clearance_step: f64
    spacing: f64
    base_height: f64
    pin_height: f64
) -> Vec<step::SceneNode> {
    let total_length = step_count as f64 * spacing
    let base_width = pin_diameter * 3.0

    // Base with holes
    let outer = step::rect(total_length, base_width)
    let mut holes = #[]
    let mut i = 0
    while i < step_count {
        let current_clearance = -base_interference + i as f64 * clearance_step + base_clearance
        let x = i as f64 * spacing + spacing / 2.0
        let y = base_width / 2.0
        let hole = rev_pts(step::circle(pin_diameter + current_clearance))
        holes.push(step::translate_pts(hole, x, y))
        i += 1
    }
    let base = step::extrude(step::profile(outer).add_all_holes(holes), base_height)
        .named("base")
        .colored(step::BLUE)
        .moved(x: 0.0, y: -base_width / 2.0, z: 0.0)
    let mut nodes = #[base]

    // Pins
    let mut pi = 0
    while pi < step_count {
        let x = pi as f64 * spacing + spacing / 2.0
        let y = -base_width
        let pin = step::tube(pin_diameter, 0.0, pin_height)
            .named(f"pin-{pi}")
            .colored(step::MAGENTA)
            .moved(x: x, y: y, z: 0.0)
        nodes.push(pin)
        pi += 1
    }
    nodes
}

fn run() -> Result<(), step::Error> {
    let spec = {
        "pinDiameter": step::opt_double(5.0, help: "Nominal pin diameter (mm)", min: Some(1.0))
        "clearance": step::opt_double(0.0, help: "Base clearance (mm)")
        "interference": step::opt_double(0.1, help: "Base interference (mm)", min: Some(0.0))
        "stepCount": step::opt_double(5.0, help: "Number of test steps", min: Some(1.0))
        "clearanceStep": step::opt_double(0.05, help: "Clearance increment per step (mm)")
        "spacing": step::opt_double(15.0, help: "Spacing between pins/holes (mm)", min: Some(5.0))
        "baseHeight": step::opt_double(10.0, help: "Thickness of the base plate (mm)", min: Some(1.0))
        "pinHeight": step::opt_double(15.0, help: "Height of the pins (mm)", min: Some(1.0))
        "blend": step::opt_string(help: "Create Blender 5.0 file (instead of STEP)")
        "bpy": step::opt_string(help: "Write Blender 5.0 Python3 script to a file (instead of STEP)")
        "out": step::opt_string(short: 'o', help: "Write output to a file (default: stdout)")
    }
    let args = match step::parse_args(step::with_translate(spec), "16-press-fit-pin-gauge", "Generate a press-fit pin gauge test set.", env::args()) {
        Ok(a) => a
        Err(err) => process::exit(step::cli_report(err) as i64)
    }
    let pin_diameter = args.double_or("pinDiameter", 5.0)
    let clearance = args.double_or("clearance", 0.0)
    let interference = args.double_or("interference", 0.1)
    let step_count = args.double_or("stepCount", 5.0) as i64
    let clearance_step = args.double_or("clearanceStep", 0.05)
    let spacing = args.double_or("spacing", 15.0)
    let base_height = args.double_or("baseHeight", 10.0)
    let pin_height = args.double_or("pinHeight", 15.0)
    let blend_path = args.string_opt("blend")
    let bpy_path = args.string_opt("bpy")
    let out_path = args.string_opt("out")
    let tx, ty, tz = match args.translate_xyz() {
        Ok(v) => v
        Err(_) => {
            eprintln("error: invalid translation")
            process::exit(1)
        }
    }
    let nodes = pin_gauge(pin_diameter, clearance, interference, step_count, clearance_step, spacing, base_height, pin_height)
    let mut design = step::design(name: "press-fit-pin-gauge", documentation: args.documentation())
    for node in nodes {
        design = design.add(node.moved(x: tx, y: ty, z: tz))
    }

    match blend_path {
        Some(path) => design.create_blender_file(path)?
        None => match bpy_path {
            Some(path) => design.write_blender_python(Some(path))?
            None => design.write_step(out_path)?
        }
    }
    Ok(())
}

fn main() {
    match run() {
        Ok(_) => {}
        Err(err) => {
            eprintln(f"{err}")
            process::exit(1)
        }
    }
}
